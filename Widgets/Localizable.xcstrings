    "A larger RetroGuide icon. Choose What's On for live listings and channel controls." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un icono de RetroGuide más grande. Elige Ahora en TV para ver la programación en vivo y controlar los canales."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um ícone maior do RetroGuide. Escolha Passando agora para ver a programação ao vivo e controlar os canais."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une icône RetroGuide plus grande. Choisissez Au programme pour les programmes en direct et les commandes de chaîne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un'icona RetroGuide più grande. Scegli In onda per i programmi in diretta e i controlli dei canali."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein größeres RetroGuide-Symbol. Wähle „Was läuft“ für das aktuelle Programm und die Kanalsteuerung."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een groter RetroGuide-symbool. Kies ‘Nu op tv’ voor actuele programma’s en zenderbediening."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En större RetroGuide-symbol. Välj På tv nu för aktuella program och kanalreglage."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Większa ikona RetroGuide. Wybierz „Co leci”, aby widzieć bieżący program i przełączać kanały."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Větší ikona RetroGuide. Pro aktuální program a ovládání kanálů vyber Co běží."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Крупный значок RetroGuide. Для программы эфира и переключения каналов выберите «Что идёт»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大きなRetroGuideアイコン。放送中の番組とチャンネル操作には「いま放送中」を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "더 큰 RetroGuide 아이콘입니다. 방송 중인 프로그램과 채널 조작은 “지금 방송”을 선택하십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更大的 RetroGuide 图标。选择“正在播什么”可查看实时节目表和频道控制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "較大的 RetroGuide 圖像。選擇「現在播什麼」可查看即時節目表和頻道控制項目。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RetroGuide का बड़ा आइकन। लाइव प्रोग्राम और चैनल कंट्रोल के लिए “क्या चल रहा है” चुनें।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RetroGuide-এর বড় আইকন। লাইভ অনুষ্ঠান ও চ্যানেল কন্ট্রোলের জন্য “এখন কী চলছে” বেছে নিন।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मोठा RetroGuide आयकॉन. लाइव्ह कार्यक्रम आणि चॅनेल नियंत्रणांसाठी “आता काय सुरू” निवडा."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பெரிய RetroGuide ஐகான். நேரலை நிகழ்ச்சிகளுக்கும் சேனல் கட்டுப்பாடுகளுக்கும் ‘இப்போது என்ன’ என்பதைத் தேர்ந்தெடுக்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "పెద్ద RetroGuide ఐకాన్. లైవ్ కార్యక్రమాలు, ఛానెల్ కంట్రోల్స్ కోసం ‘ఇప్పుడు ఏముంది’ ఎంచుకోండి."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RetroGuideનું મોટું આઇકન. લાઇવ કાર્યક્રમો અને ચેનલ કંટ્રોલ માટે “શું ચાલે છે” પસંદ કરો."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ದೊಡ್ಡ RetroGuide ಐಕಾನ್. ಲೈವ್ ಪಟ್ಟಿಗಳು ಮತ್ತು ಚಾನಲ್ ನಿಯಂತ್ರಣಗಳಿಗಾಗಿ “ಈಗ ಏನಿದೆ” ಆಯ್ಕೆಮಾಡಿ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "വലിയ RetroGuide ഐക്കൺ. തത്സമയ പരിപാടികൾക്കും ചാനൽ നിയന്ത്രണങ്ങൾക്കും \"ഇപ്പോൾ ടിവിയിൽ\" തിരഞ്ഞെടുക്കുക."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਵੱਡਾ RetroGuide ਆਈਕਨ। ਲਾਈਵ ਪ੍ਰੋਗਰਾਮਾਂ ਅਤੇ ਚੈਨਲ ਕੰਟਰੋਲਾਂ ਲਈ ‘ਹੁਣ ਕੀ ਚੱਲ ਰਿਹਾ’ ਚੁਣੋ।"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଏକ ବଡ଼ RetroGuide ଆଇକନ୍। ଲାଇଭ୍ ତାଲିକା ଓ ଚ୍ୟାନେଲ ନିୟନ୍ତ୍ରଣ ପାଇଁ “କ'ଣ ଚାଲିଛି” ବାଛନ୍ତୁ।"
          }
        }
      }
    },
