        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den sparade synkloggen kunde inte läsas. Dina inställningar på den här enheten är oförändrade."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można odczytać zapisanego dziennika synchronizacji. Ustawienia na tym urządzeniu się nie zmieniły."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uložený deník synchronizace nelze přečíst. Nastavení v tomto zařízení se nezměnilo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось прочитать сохранённый журнал синхронизации. Настройки на этом устройстве не изменились."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存された同期記録を読み込めませんでした。このデバイスの設定は変更されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장된 동기화 기록을 읽을 수 없습니다. 이 기기의 설정은 변경되지 않았습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取已存储的同步日志。此设备上的设置未更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法讀取已儲存的同步記錄。此裝置上的設定沒有變更。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सेव किया गया सिंक जर्नल पढ़ा नहीं जा सका। इस डिवाइस पर आपकी सेटिंग्ज़ नहीं बदलीं।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সেভ করা সিঙ্ক জার্নাল পড়া যায়নি। এই ডিভাইসে আপনার সেটিংস বদলায়নি।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सेव्ह केलेले सिंक जर्नल वाचता आले नाही. या डिव्हाइसवरील तुमच्या सेटिंग्ज बदललेल्या नाहीत."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "சேமித்த ஒத்திசைவுப் பதிவைப் படிக்க முடியவில்லை. இந்தச் சாதனத்தில் உங்கள் அமைப்புகள் மாறவில்லை."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "సేవ్ చేసిన సింక్ జర్నల్‌ను చదవలేకపోయాము. ఈ పరికరంలో మీ సెట్టింగ్‌లు మారలేదు."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "સાચવેલી સિંક જર્નલ વાંચી શકાઈ નહીં. આ ડિવાઇસ પરનાં તમારાં સેટિંગ્સ બદલાયાં નથી."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಸೇವ್ ಮಾಡಿದ ಸಿಂಕ್ ಜರ್ನಲ್ ಓದಲಾಗಲಿಲ್ಲ. ಈ ಸಾಧನದಲ್ಲಿನ ನಿಮ್ಮ ಸೆಟ್ಟಿಂಗ್‌ಗಳು ಬದಲಾಗಿಲ್ಲ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "സേവ് ചെയ്ത സമന്വയ ജേണൽ വായിക്കാനായില്ല. ഈ ഉപകരണത്തിലെ നിങ്ങളുടെ ക്രമീകരണങ്ങളിൽ മാറ്റമില്ല."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਸੇਵ ਕੀਤਾ ਸਿੰਕ ਜਰਨਲ ਪੜ੍ਹਿਆ ਨਹੀਂ ਜਾ ਸਕਿਆ। ਇਸ ਡਿਵਾਈਸ 'ਤੇ ਤੁਹਾਡੀਆਂ ਸੈਟਿੰਗਾਂ ਨਹੀਂ ਬਦਲੀਆਂ।"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ସେଭ୍ ହୋଇଥିବା ସିଙ୍କ ଜର୍ଣ୍ଣାଲ୍ ପଢ଼ାଯାଇପାରିଲା ନାହିଁ। ଏହି ଡିଭାଇସରେ ଆପଣଙ୍କ ସେଟିଂସ୍ ବଦଳିନାହିଁ।"
          }
        }
      }
    },
    "The scheduler also avoids airing the exact same episode or movie on multiple channels when alternatives are available." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La programación también evita emitir el mismo episodio o película en varios canales cuando hay alternativas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A programação também evita exibir o mesmo episódio ou filme em vários canais quando há alternativas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La programmation évite aussi de diffuser le même épisode ou film sur plusieurs chaînes quand d'autres choix sont possibles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La programmazione evita anche di trasmettere lo stesso episodio o film su più canali quando ci sono alternative."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Sendeplan vermeidet außerdem, genau dieselbe Folge oder denselben Film auf mehreren Kanälen zu zeigen, wenn es Alternativen gibt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De planner vermijdt ook dat exact dezelfde aflevering of film op meerdere zenders wordt uitgezonden als er alternatieven zijn."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schemaläggaren undviker också att sända exakt samma avsnitt eller film på flera kanaler när det finns alternativ."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harmonogram unika też emitowania tego samego odcinka lub filmu na kilku kanałach, gdy są dostępne inne możliwości."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plánovač se také vyhýbá vysílání stejného dílu nebo filmu na více kanálech, pokud jsou k dispozici alternativy."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если есть альтернативы, планировщик также не показывает один и тот же эпизод или фильм на нескольких каналах."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ほかに候補がある場合は、まったく同じエピソードや映画を複数のチャンネルで放送しないようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 대안이 있으면 똑같은 에피소드나 영화를 여러 채널에서 방송하지 않도록 편성합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有其他选择时，排播也会避免在多个频道同时播出同一集或同一部电影。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有其他選擇時，排播也會避免在多個頻道同時播出同一集或同一部電影。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दूसरे विकल्प होने पर शेड्यूलर एक ही एपिसोड या फ़िल्म को कई चैनलों पर एक साथ चलाने से भी बचता है।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অন্য বিকল্প থাকলে শিডিউলার একই পর্ব বা সিনেমা একসাথে একাধিক চ্যানেলে চালানো এড়িয়ে চলে।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पर्याय उपलब्ध असताना, शेड्यूलर अगदी तोच भाग किंवा चित्रपट अनेक चॅनेलवर एकाच वेळी दाखवणेही टाळतो."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "மாற்று இருக்கும்போது, ஒரே எபிசோடையோ படத்தையோ பல சேனல்களில் ஒளிபரப்புவதையும் அட்டவணை தவிர்க்கும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ప్రత్యామ్నాయాలు ఉన్నప్పుడు, ఒకే ఎపిసోడ్ లేదా సినిమాను పలు ఛానెల్‌లలో ప్రసారం చేయకుండా కూడా షెడ్యూలర్ చూస్తుంది."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "બીજા વિકલ્પ ઉપલબ્ધ હોય ત્યારે, શેડ્યૂલર એક જ એપિસોડ કે ફિલ્મને એકસાથે ઘણી ચેનલો પર પ્રસારિત કરવાનું પણ ટાળે છે."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಪರ್ಯಾಯಗಳು ಲಭ್ಯವಿದ್ದಾಗ, ಒಂದೇ ಎಪಿಸೋಡ್ ಅಥವಾ ಸಿನಿಮಾವನ್ನು ಹಲವು ಚಾನಲ್‌ಗಳಲ್ಲಿ ಪ್ರಸಾರ ಮಾಡುವುದನ್ನೂ ಶೆಡ್ಯೂಲರ್ ತಪ್ಪಿಸುತ್ತದೆ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "മറ്റ് ഓപ്ഷനുകൾ ഉള്ളപ്പോൾ, ഒരേ എപ്പിസോഡോ സിനിമയോ ഒന്നിലധികം ചാനലുകളിൽ സംപ്രേഷണം ചെയ്യുന്നതും ഷെഡ്യൂളർ ഒഴിവാക്കുന്നു."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਹੋਰ ਵਿਕਲਪ ਉਪਲਬਧ ਹੋਣ 'ਤੇ ਸ਼ਡਿਊਲਰ ਬਿਲਕੁਲ ਇੱਕੋ ਐਪੀਸੋਡ ਜਾਂ ਫ਼ਿਲਮ ਨੂੰ ਕਈ ਚੈਨਲਾਂ 'ਤੇ ਚਲਾਉਣ ਤੋਂ ਵੀ ਬਚਦਾ ਹੈ।"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ବିକଳ୍ପ ଉପଲବ୍ଧ ଥିଲେ, ସୂଚୀ ପ୍ରସ୍ତୁତକାରୀ ଏକାଧିକ ଚ୍ୟାନେଲରେ ଠିକ୍ ସମାନ ଏପିସୋଡ୍ ବା ସିନେମା ପ୍ରସାରଣ କରିବା ମଧ୍ୟ ଏଡ଼ାଏ।"
          }
        }
      }
    },
