        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öppna din profil i Jellyfin på telefonen eller datorn, välj Quick Connect och ange den här koden:"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W Jellyfin na telefonie lub komputerze otwórz swój profil, wybierz Quick Connect i wpisz ten kod:"
          }
        },
        "cs" : {
          "stringUnit" : {
