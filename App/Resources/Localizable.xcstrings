    "Matching copies of titles in these collections are included. Your library and rating limits still apply." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se incluyen las copias equivalentes de los títulos de estas colecciones. Tus límites de biblioteca y clasificación siguen aplicándose."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cópias correspondentes dos títulos destas coleções são incluídas. Seus limites de biblioteca e classificação continuam valendo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les copies des titres de ces collections sont incluses. Vos limites de bibliothèque et de classification s'appliquent toujours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le copie corrispondenti dei titoli di queste raccolte sono incluse. I limiti di libreria e classificazione restano validi."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passende Kopien von Titeln in diesen Sammlungen sind enthalten. Deine Bibliotheks- und Altersgrenzen gelten weiterhin."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overeenkomende kopieën van titels in deze collecties zijn inbegrepen. Je bibliotheek- en leeftijdsgrenzen blijven gelden."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matchande kopior av titlar i de här samlingarna tas med. Dina gränser för bibliotek och åldersgräns gäller fortfarande."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasujące kopie tytułów z tych kolekcji są uwzględniane. Limity bibliotek i kategorii wiekowych nadal obowiązują."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zahrnou se odpovídající kopie titulů z těchto kolekcí. Limity knihoven a hodnocení dál platí."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включаются копии фильмов и сериалов из этих коллекций. Ограничения по медиатекам и рейтингам по-прежнему действуют."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらのコレクションの作品は、他のサーバにある同じ作品も含まれます。ライブラリとレーティングの制限は引き続き適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 컬렉션에 있는 작품은 다른 서버의 같은 작품도 포함됩니다. 라이브러리 및 등급 제한은 계속 적용됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些合集中作品的相同版本会被包含在内。媒体库和分级限制仍然适用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些合輯中作品的相同版本會被納入。媒體庫和分級限制仍然適用。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इन कलेक्शन के टाइटल की मेल खाती कॉपी शामिल हैं। आपकी लाइब्रेरी और रेटिंग की सीमाएँ फिर भी लागू होती हैं।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই কালেকশনগুলোর টাইটেলের মিলে যাওয়া কপি অন্তর্ভুক্ত। আপনার লাইব্রেরি ও রেটিং সীমা তবুও প্রযোজ্য।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "या संग्रहांमधील शीर्षकांच्या जुळणाऱ्या प्रती समाविष्ट केल्या जातात. तुमच्या लायब्ररी आणि रेटिंग मर्यादा तरीही लागू राहतात."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இந்தத் தொகுப்புகளில் உள்ள தலைப்புகளின் பொருந்தும் பிரதிகள் சேர்க்கப்படும். உங்கள் லைப்ரரி, மதிப்பீட்டு வரம்புகள் தொடர்ந்து பொருந்தும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఈ కలెక్షన్‌లలోని టైటిల్‌ల సరిపోలే కాపీలు చేర్చబడతాయి. మీ లైబ్రరీ, రేటింగ్ పరిమితులు ఇంకా వర్తిస్తాయి."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આ કલેક્શનનાં ટાઇટલની મેળ ખાતી કૉપી સામેલ થાય છે. તમારી લાઇબ્રેરી અને રેટિંગ મર્યાદાઓ હજુ લાગુ પડે છે."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಈ ಸಂಗ್ರಹಗಳಲ್ಲಿನ ಶೀರ್ಷಿಕೆಗಳ ಹೊಂದುವ ಪ್ರತಿಗಳನ್ನು ಸೇರಿಸಲಾಗುತ್ತದೆ. ನಿಮ್ಮ ಲೈಬ್ರರಿ ಮತ್ತು ರೇಟಿಂಗ್ ಮಿತಿಗಳು ಈಗಲೂ ಅನ್ವಯಿಸುತ್ತವೆ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഈ കളക്ഷനുകളിലെ ടൈറ്റിലുകളുടെ അതേ പകർപ്പുകൾ ഉൾപ്പെടുത്തും. നിങ്ങളുടെ ലൈബ്രറി, റേറ്റിങ് പരിധികൾ ഇപ്പോഴും ബാധകമാണ്."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਇਹਨਾਂ ਕਲੈਕਸ਼ਨਾਂ ਵਿਚਲੇ ਟਾਈਟਲਾਂ ਦੀਆਂ ਮੇਲ ਖਾਂਦੀਆਂ ਕਾਪੀਆਂ ਸ਼ਾਮਲ ਹਨ। ਤੁਹਾਡੀਆਂ ਲਾਇਬ੍ਰੇਰੀ ਅਤੇ ਰੇਟਿੰਗ ਸੀਮਾਵਾਂ ਫਿਰ ਵੀ ਲਾਗੂ ਹੁੰਦੀਆਂ ਹਨ।"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଏହି କଲେକ୍ସନ୍‌ର ଟାଇଟଲ୍‌ର ମେଳ ଖାଉଥିବା କପି ସାମିଲ। ଆପଣଙ୍କ ଲାଇବ୍ରେରୀ ଓ ରେଟିଂ ସୀମା ତଥାପି ଲାଗୁ।"
          }
        }
      }
    },
