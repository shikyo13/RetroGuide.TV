    "Add What's On for artwork, current programs and channel controls, or App Icon for a larger icon. Both follow your app theme." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrega Ahora en TV para ver ilustraciones, programas actuales y controles de canal, o Icono de la app para un icono más grande. Ambos siguen el tema de la app."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione Passando agora para ver artes, programas atuais e controles de canal, ou Ícone do app para um ícone maior. Os dois seguem o tema do app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez Au programme pour les visuels, les programmes en cours et les commandes de chaîne, ou Icône de l'app pour une icône plus grande. Les deux suivent le thème de l'app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi In onda per immagini, programmi in corso e controlli dei canali, oppure Icona dell'app per un'icona più grande. Entrambi seguono il tema dell'app."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge „Was läuft“ für Cover, aktuelle Sendungen und Kanalsteuerung hinzu oder „App-Symbol“ für ein größeres Symbol. Beide folgen deinem App-Design."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg ‘Nu op tv’ toe voor illustraties, actuele programma’s en zenderbediening, of ‘App-symbool’ voor een groter symbool. Beide volgen je appthema."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg till På tv nu för bilder, aktuella program och kanalreglage, eller Appsymbol för en större symbol. Båda följer appens tema."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj widżet „Co leci” z grafikami, bieżącymi programami i przełączaniem kanałów albo „Ikona aplikacji” z większą ikoną. Oba korzystają z motywu aplikacji."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidej Co běží pro obrázky, aktuální pořady a ovládání kanálů, nebo Ikonu aplikace pro větší ikonu. Oba se řídí motivem aplikace."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте «Что идёт» для обложек, текущих передач и переключения каналов или «Значок» для крупного значка. Оба следуют теме приложения."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アートワーク、放送中の番組、チャンネル操作には「いま放送中」を、大きなアイコンには「Appアイコン」を追加してください。どちらもAppのテーマに合わせて表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아트워크, 방송 중인 프로그램, 채널 조작을 원하면 “지금 방송”을, 더 큰 아이콘을 원하면 “앱 아이콘”을 추가하십시오. 둘 다 앱 테마를 따릅니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加“正在播什么”可查看封面、当前节目和频道控制，添加“App 图标”可获得更大的图标。两者都会跟随 App 主题。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加入「現在播什麼」可查看封面、目前節目和頻道控制項目，加入「App 圖像」可獲得較大的圖像。兩者都會跟隨 App 主題。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आर्टवर्क, मौजूदा प्रोग्राम और चैनल कंट्रोल के लिए “क्या चल रहा है” जोड़ें, या बड़े आइकन के लिए “ऐप आइकन”। दोनों आपकी ऐप थीम के हिसाब से दिखते हैं।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আর্টওয়ার্ক, এখনকার অনুষ্ঠান ও চ্যানেল কন্ট্রোলের জন্য “এখন কী চলছে” যোগ করুন, অথবা বড় আইকনের জন্য “অ্যাপ আইকন”। দুটোই আপনার অ্যাপের থিম মেনে চলে।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आर्टवर्क, सध्याचे कार्यक्रम आणि चॅनेल नियंत्रणांसाठी “आता काय सुरू” जोडा, किंवा मोठ्या आयकॉनसाठी “ॲप आयकॉन”. दोन्ही तुमच्या ॲप थीमनुसार दिसतात."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "படங்கள், தற்போதைய நிகழ்ச்சிகள், சேனல் கட்டுப்பாடுகளுக்கு ‘இப்போது என்ன’ என்பதையோ, பெரிய ஐகானுக்கு ‘ஆப் ஐகான்’ என்பதையோ சேர்க்கவும். இரண்டும் உங்கள் ஆப் தீமைப் பின்பற்றும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఆర్ట్‌వర్క్, ప్రస్తుత ప్రోగ్రామ్‌లు, ఛానెల్ కంట్రోల్స్ కోసం ‘ఇప్పుడు ఏముంది’ని, లేదా పెద్ద ఐకాన్ కోసం ‘యాప్ ఐకాన్’ని జోడించండి. రెండూ మీ యాప్ థీమ్‌ను అనుసరిస్తాయి."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આર્ટવર્ક, હાલના પ્રોગ્રામ અને ચેનલ કંટ્રોલ માટે “શું ચાલે છે” ઉમેરો, અથવા મોટા આઇકન માટે “ઍપ આઇકન”. બંને તમારી ઍપ થીમને અનુસરે છે."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಆರ್ಟ್‌ವರ್ಕ್, ಈಗಿನ ಕಾರ್ಯಕ್ರಮಗಳು ಮತ್ತು ಚಾನಲ್ ನಿಯಂತ್ರಣಗಳಿಗಾಗಿ “ಈಗ ಏನಿದೆ” ಸೇರಿಸಿ, ಅಥವಾ ದೊಡ್ಡ ಐಕಾನ್‌ಗಾಗಿ “ಆ್ಯಪ್ ಐಕಾನ್” ಸೇರಿಸಿ. ಎರಡೂ ನಿಮ್ಮ ಆ್ಯಪ್ ಥೀಮ್ ಅನುಸರಿಸುತ್ತವೆ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ആർട്ട്‌വർക്ക്, ഇപ്പോഴത്തെ പരിപാടികൾ, ചാനൽ നിയന്ത്രണങ്ങൾ എന്നിവയ്ക്ക് \"ഇപ്പോൾ ടിവിയിൽ\" ചേർക്കുക, അല്ലെങ്കിൽ വലിയ ഐക്കണിന് \"ആപ്പ് ഐക്കൺ\" ചേർക്കുക. രണ്ടും നിങ്ങളുടെ ആപ്പ് തീം പിന്തുടരും."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਆਰਟਵਰਕ, ਮੌਜੂਦਾ ਪ੍ਰੋਗਰਾਮਾਂ ਅਤੇ ਚੈਨਲ ਕੰਟਰੋਲਾਂ ਲਈ ‘ਹੁਣ ਕੀ ਚੱਲ ਰਿਹਾ’ ਸ਼ਾਮਲ ਕਰੋ, ਜਾਂ ਵੱਡੇ ਆਈਕਨ ਲਈ ‘ਐਪ ਆਈਕਨ’। ਦੋਵੇਂ ਤੁਹਾਡੀ ਐਪ ਦੀ ਥੀਮ ਮੁਤਾਬਕ ਚੱਲਦੇ ਹਨ।"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆର୍ଟୱର୍କ, ବର୍ତ୍ତମାନର କାର୍ଯ୍ୟକ୍ରମ ଓ ଚ୍ୟାନେଲ ନିୟନ୍ତ୍ରଣ ପାଇଁ “କ'ଣ ଚାଲିଛି”, କିମ୍ବା ବଡ଼ ଆଇକନ୍ ପାଇଁ “ଆପ୍ ଆଇକନ୍” ଯୋଗ କରନ୍ତୁ। ଦୁହେଁ ଆପଣଙ୍କ ଆପ୍ ଥିମ୍ ଅନୁସରଣ କରନ୍ତି।"
          }
        }
      }
    },
