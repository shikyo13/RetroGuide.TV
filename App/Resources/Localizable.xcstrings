    "A Tailscale or other VPN address, or an HTTPS internet address. Used when home doesn't answer." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una dirección de Tailscale u otra VPN, o una dirección HTTPS de internet. Se usa cuando la dirección local no responde."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um endereço do Tailscale ou de outra VPN, ou um endereço HTTPS da internet. Usado quando o endereço local não responde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une adresse Tailscale ou d'un autre VPN, ou une adresse Internet HTTPS. Utilisée si l'adresse locale ne répond pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un indirizzo Tailscale o di un'altra VPN, oppure un indirizzo Internet HTTPS. Usato quando l'indirizzo di casa non risponde."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Tailscale- oder andere VPN-Adresse oder eine HTTPS-Internetadresse. Wird verwendet, wenn die Heimadresse nicht antwortet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een Tailscale- of ander VPN-adres, of een HTTPS-internetadres. Wordt gebruikt als het thuisadres niet reageert."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En adress för Tailscale eller annat VPN, eller en HTTPS-adress på internet. Används när hemadressen inte svarar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adres Tailscale lub innej sieci VPN albo internetowy adres HTTPS. Używany, gdy adres domowy nie odpowiada."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adresa v Tailscale nebo jiné VPN, případně internetová adresa HTTPS. Použije se, když domácí adresa neodpovídá."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Адрес Tailscale или другой VPN либо интернет-адрес HTTPS. Используется, когда домашний адрес не отвечает."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TailscaleなどのVPNアドレス、またはHTTPSのインターネットアドレス。自宅用アドレスで応答がないときに使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale 등 VPN 주소 또는 HTTPS 인터넷 주소입니다. 홈 주소가 응답하지 않을 때 사용합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale 或其他 VPN 地址，或 HTTPS 互联网地址。家庭地址无响应时使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale 或其他 VPN 位址，或 HTTPS 網際網路位址。家用位址沒有回應時使用。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale या किसी दूसरे VPN का पता, या HTTPS इंटरनेट पता। तब इस्तेमाल होता है जब घर का पता जवाब न दे।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale বা অন্য কোনো VPN ঠিকানা, অথবা HTTPS ইন্টারনেট ঠিকানা। বাড়ির ঠিকানা সাড়া না দিলে ব্যবহার করা হয়।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale किंवा इतर VPN पत्ता, किंवा HTTPS इंटरनेट पत्ता. घरचा पत्ता प्रतिसाद देत नसल्यास वापरला जातो."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale அல்லது பிற VPN முகவரி, அல்லது HTTPS இணைய முகவரி. வீட்டு முகவரி பதிலளிக்காதபோது பயன்படும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale లేదా ఇతర VPN అడ్రస్, లేదా HTTPS ఇంటర్నెట్ అడ్రస్. హోమ్ అడ్రస్ స్పందించనప్పుడు ఉపయోగించబడుతుంది."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale કે અન્ય VPN સરનામું, અથવા HTTPS ઇન્ટરનેટ સરનામું. ઘરનું સરનામું જવાબ ન આપે ત્યારે વપરાય છે."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale ಅಥವಾ ಇತರ VPN ವಿಳಾಸ, ಅಥವಾ HTTPS ಇಂಟರ್ನೆಟ್ ವಿಳಾಸ. ಮನೆಯ ವಿಳಾಸ ಪ್ರತಿಕ್ರಿಯಿಸದಿದ್ದಾಗ ಬಳಸಲಾಗುತ್ತದೆ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale അല്ലെങ്കിൽ മറ്റ് VPN വിലാസം, അല്ലെങ്കിൽ HTTPS ഇന്റർനെറ്റ് വിലാസം. വീട്ടിലെ വിലാസം പ്രതികരിക്കാത്തപ്പോൾ ഉപയോഗിക്കും."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale ਜਾਂ ਕੋਈ ਹੋਰ VPN ਪਤਾ, ਜਾਂ HTTPS ਇੰਟਰਨੈੱਟ ਪਤਾ। ਘਰ ਵਾਲੇ ਪਤੇ ਤੋਂ ਜਵਾਬ ਨਾ ਮਿਲਣ 'ਤੇ ਵਰਤਿਆ ਜਾਂਦਾ ਹੈ।"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଏକ Tailscale ବା ଅନ୍ୟ VPN ଠିକଣା, କିମ୍ବା ଏକ HTTPS ଇଣ୍ଟରନେଟ୍ ଠିକଣା। ଘର ଠିକଣା ଉତ୍ତର ନ ଦେଲେ ବ୍ୟବହୃତ ହୁଏ।"
