    "Star channels below. Hidden and unavailable channels stay saved and return when available." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marca canales con una estrella abajo. Los canales ocultos y no disponibles se conservan y vuelven cuando están disponibles."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marque canais com estrela abaixo. Canais ocultos e indisponíveis continuam salvos e voltam quando estiverem disponíveis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marquez des chaînes ci-dessous. Les chaînes masquées ou indisponibles restent enregistrées et reviennent dès qu'elles sont disponibles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contrassegna i canali qui sotto con una stella. I canali nascosti e non disponibili restano salvati e tornano quando sono disponibili."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markiere unten Kanäle mit einem Stern. Ausgeblendete und nicht verfügbare Kanäle bleiben gespeichert und kehren zurück, sobald sie verfügbar sind."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geef hieronder zenders een ster. Verborgen en niet-beschikbare zenders blijven bewaard en komen terug zodra ze beschikbaar zijn."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
