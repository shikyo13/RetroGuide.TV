    "Channels can mix programs from every server you add." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los canales pueden mezclar programas de todos los servidores que agregues."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os canais podem misturar programas de todos os servidores que você adicionar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les chaînes peuvent mélanger les programmes de tous les serveurs ajoutés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I canali possono mescolare programmi di tutti i server che aggiungi."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanäle können Sendungen von allen hinzugefügten Servern mischen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zenders kunnen programma’s van elke toegevoegde server combineren."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanaler kan blanda program från alla servrar du lägger till."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanały mogą łączyć programy ze wszystkich dodanych serwerów."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanály mohou míchat pořady ze všech přidaných serverů."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На каналах могут смешиваться передачи со всех добавленных серверов."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チャンネルには、追加したすべてのサーバの番組を混ぜて放送できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "채널에 추가한 모든 서버의 프로그램을 섞을 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "频道可以混合你添加的所有服务器上的节目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
