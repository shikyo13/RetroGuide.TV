        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ પર આ એકાઉન્ટ જોઈ શકે તેવી કોઈ ફિલ્મ કે ટીવી શો લાઇબ્રેરી નથી."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: ಈ ಖಾತೆಗೆ ಕಾಣುವ ಯಾವುದೇ ಸಿನಿಮಾ ಅಥವಾ ಟಿವಿ ಶೋ ಲೈಬ್ರರಿಗಳು ಇಲ್ಲ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഈ അക്കൗണ്ടിന് കാണാവുന്ന സിനിമ, ടിവി ഷോ ലൈബ്രറികളൊന്നും %@-ൽ ഇല്ല."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ਵਿੱਚ ਫ਼ਿਲਮਾਂ ਜਾਂ TV ਸ਼ੋਆਂ ਦੀ ਕੋਈ ਲਾਇਬ੍ਰੇਰੀ ਨਹੀਂ ਜੋ ਇਹ ਖਾਤਾ ਦੇਖ ਸਕੇ।"
