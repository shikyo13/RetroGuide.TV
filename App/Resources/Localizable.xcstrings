        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤੁਹਾਡੇ ਘਰ ਦੇ ਨੈੱਟਵਰਕ 'ਤੇ ਇਸਦਾ ਪਤਾ, ਜਿਵੇਂ 192.168.1.20:8096।"
          }
