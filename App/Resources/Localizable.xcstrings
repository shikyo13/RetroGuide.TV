    "RetroGuide plays the original files from your server whenever it can, so your server doesn't have to convert video." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RetroGuide reproduce los archivos originales de tu servidor siempre que puede, para que tu servidor no tenga que convertir el video."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O RetroGuide reproduz os arquivos originais do seu servidor sempre que pode, para que o servidor não precise converter o vídeo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RetroGuide lit les fichiers d'origine de votre serveur dès que possible, pour que votre serveur n'ait pas à convertir la vidéo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RetroGuide riproduce i file originali del server ogni volta che può, così il server non deve convertire il video."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RetroGuide spielt nach Möglichkeit die Originaldateien von deinem Server ab, damit dein Server kein Video umwandeln muss."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RetroGuide speelt waar mogelijk de originele bestanden van je server af, zodat je server geen video hoeft om te zetten."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RetroGuide spelar upp originalfilerna från din server när det går, så att servern inte behöver konvertera video."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RetroGuide odtwarza oryginalne pliki z serwera, gdy tylko może, więc serwer nie musi konwertować wideo."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RetroGuide přehrává původní soubory ze serveru, kdykoli to jde, takže server nemusí video převádět."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RetroGuide по возможности воспроизводит оригинальные файлы с сервера, чтобы серверу не приходилось преобразовывать видео."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RetroGuideは可能な限りサーバの元のファイルを再生するため、サーバでビデオを変換する必要がありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RetroGuide는 가능하면 서버의 원본 파일을 재생하므로 서버에서 비디오를 변환할 필요가 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RetroGuide 会尽可能直接播放服务器上的原始文件，这样服务器就无需转换视频。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RetroGuide 會盡可能直接播放伺服器上的原始檔案，讓伺服器不必轉換影片。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RetroGuide जब भी हो सके, आपके सर्वर से ओरिजिनल फ़ाइलें चलाता है, ताकि आपके सर्वर को वीडियो कन्वर्ट न करना पड़े।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RetroGuide যখনই সম্ভব আপনার সার্ভার থেকে আসল ফাইল চালায়, যাতে আপনার সার্ভারকে ভিডিও রূপান্তর করতে না হয়।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RetroGuide शक्य असेल तेव्हा तुमच्या सर्व्हरवरील मूळ फाइल्स प्ले करते, त्यामुळे तुमच्या सर्व्हरला व्हिडिओ रूपांतरित करावा लागत नाही."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "முடிந்தபோதெல்லாம் RetroGuide உங்கள் சர்வரிலிருந்து அசல் கோப்புகளை இயக்கும்; அதனால் உங்கள் சர்வர் வீடியோவை மாற்ற வேண்டியதில்லை."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RetroGuide వీలైనప్పుడల్లా మీ సర్వర్ నుండి ఒరిజినల్ ఫైల్‌లను ప్లే చేస్తుంది, కాబట్టి మీ సర్వర్ వీడియోను కన్వర్ట్ చేయనవసరం లేదు."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RetroGuide શક્ય હોય ત્યારે તમારા સર્વરની મૂળ ફાઇલો ચલાવે છે, જેથી તમારા સર્વરને વીડિયો કન્વર્ટ કરવો ન પડે."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RetroGuide ಸಾಧ್ಯವಾದಾಗಲೆಲ್ಲಾ ನಿಮ್ಮ ಸರ್ವರ್‌ನ ಮೂಲ ಫೈಲ್‌ಗಳನ್ನು ಪ್ಲೇ ಮಾಡುತ್ತದೆ, ಆದ್ದರಿಂದ ನಿಮ್ಮ ಸರ್ವರ್ ವೀಡಿಯೊ ಪರಿವರ್ತಿಸಬೇಕಿಲ್ಲ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "കഴിയുമ്പോഴെല്ലാം RetroGuide നിങ്ങളുടെ സെർവറിലെ യഥാർഥ ഫയലുകൾ പ്ലേ ചെയ്യുന്നു, അതിനാൽ സെർവറിന് വീഡിയോ കൺവേർട്ട് ചെയ്യേണ്ടതില്ല."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RetroGuide ਜਦੋਂ ਵੀ ਹੋ ਸਕੇ ਤੁਹਾਡੇ ਸਰਵਰ ਦੀਆਂ ਅਸਲ ਫ਼ਾਈਲਾਂ ਚਲਾਉਂਦਾ ਹੈ, ਤਾਂ ਜੋ ਤੁਹਾਡੇ ਸਰਵਰ ਨੂੰ ਵੀਡੀਓ ਕਨਵਰਟ ਨਾ ਕਰਨਾ ਪਵੇ।"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RetroGuide ଯେତେବେଳେ ସମ୍ଭବ ଆପଣଙ୍କ ସର୍ଭରର ମୂଳ ଫାଇଲ୍ ଚଲାଏ, ଯାହାଫଳରେ ଆପଣଙ୍କ ସର୍ଭରକୁ ଭିଡିଓ କନଭର୍ଟ କରିବାକୁ ପଡ଼େ ନାହିଁ।"
          }
        }
      }
    },
    "RetroGuide.TV turns your Plex or Jellyfin library into live TV channels with a program guide. Flip through channels, drop into whatever is on, and let the schedule do the choosing." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RetroGuide.TV convierte tu biblioteca de Plex o Jellyfin en canales de TV en vivo con guía de programación. Cambia de canal, entra en lo que se esté emitiendo y deja que la programación elija por ti."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O RetroGuide.TV transforma sua biblioteca do Plex ou Jellyfin em canais de TV ao vivo com guia de programação. Zapeie pelos canais, entre no que estiver passando e deixe a programação escolher por você."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RetroGuide.TV transforme votre bibliothèque Plex ou Jellyfin en chaînes de télé en direct avec un guide des programmes. Zappez d'une chaîne à l'autre, tombez sur ce qui passe et laissez la programmation choisir pour vous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RetroGuide.TV trasforma la tua libreria Plex o Jellyfin in canali TV in diretta con una guida ai programmi. Fai zapping tra i canali, sintonizzati su quello che c'è in onda e lascia che sia il palinsesto a scegliere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RetroGuide.TV verwandelt deine Plex- oder Jellyfin-Bibliothek in Live-TV-Kanäle mit TV-Programm. Zappe durch die Kanäle, steig ein, wo gerade etwas läuft, und lass den Sendeplan entscheiden."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RetroGuide.TV maakt van je Plex- of Jellyfin-bibliotheek live-tv-zenders met een tv-gids. Zap door de zenders, val in bij wat er op is en laat het schema de keuze maken."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RetroGuide.TV gör ditt Plex- eller Jellyfin-bibliotek till direktsända tv-kanaler med programguide. Zappa mellan kanalerna, hoppa in i det som sänds och låt tablån välja åt dig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RetroGuide.TV zamienia twoją bibliotekę Plex lub Jellyfin w kanały telewizyjne na żywo z przewodnikiem po programach. Przełączaj kanały, włączaj to, co akurat leci, i pozwól, by ramówka wybierała za ciebie."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RetroGuide.TV promění tvou knihovnu Plex nebo Jellyfin v živé TV kanály s TV programem. Přepínej kanály, naskoč do čehokoli, co právě běží, a nech výběr na programu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RetroGuide.TV превращает вашу медиатеку Plex или Jellyfin в телеканалы с телегидом. Переключайте каналы, смотрите то, что идёт сейчас, и пусть выбирает расписание."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RetroGuide.TVは、PlexまたはJellyfinのライブラリを番組表付きのライブテレビチャンネルに変えます。チャンネルを切り替えて放送中の番組を途中から楽しみ、何を見るかは番組編成におまかせ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RetroGuide.TV는 Plex 또는 Jellyfin 라이브러리를 편성표가 있는 실시간 TV 채널로 바꿔 줍니다. 채널을 돌리다 방송 중인 프로그램에 바로 들어가고, 무엇을 볼지는 편성에 맡기십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RetroGuide.TV 将你的 Plex 或 Jellyfin 媒体库变成带节目表的直播电视频道。随意转台，看到什么就看什么，让节目表替你做选择。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RetroGuide.TV 將你的 Plex 或 Jellyfin 媒體庫變成附節目表的直播電視頻道。隨意轉台，看到什麼就看什麼，讓節目表幫你決定。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RetroGuide.TV आपकी Plex या Jellyfin लाइब्रेरी को प्रोग्राम गाइड वाले लाइव टीवी चैनलों में बदल देता है। चैनल बदलते रहें, जो चल रहा हो वहीं से देखें, और चुनने का काम शेड्यूल पर छोड़ दें।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RetroGuide.TV আপনার Plex বা Jellyfin লাইব্রেরিকে অনুষ্ঠান গাইডসহ লাইভ টিভি চ্যানেলে বদলে দেয়। চ্যানেল বদলাতে থাকুন, যা চলছে সেখান থেকেই দেখুন, আর বাছাইয়ের কাজটা শিডিউলের উপর ছেড়ে দিন।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RetroGuide.TV तुमची Plex किंवा Jellyfin लायब्ररी कार्यक्रम गाइडसह लाइव्ह टीव्ही चॅनेलमध्ये बदलते. चॅनेल बदलत राहा, जे सुरू आहे ते पाहायला लागा, आणि काय पाहायचे ते वेळापत्रकावर सोडा."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RetroGuide.TV உங்கள் Plex அல்லது Jellyfin லைப்ரரியை நிகழ்ச்சி வழிகாட்டியுடன் கூடிய நேரலை டிவி சேனல்களாக மாற்றுகிறது. சேனல்களை மாற்றிப் பாருங்கள், ஒளிபரப்பாவதில் நேரடியாக இணையுங்கள், எதைப் பார்ப்பது என்பதை அட்டவணையே தேர்வுசெய்யட்டும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RetroGuide.TV మీ Plex లేదా Jellyfin లైబ్రరీని ప్రోగ్రామ్ గైడ్‌తో లైవ్ TV ఛానెల్‌లుగా మారుస్తుంది. ఛానెల్‌లు మారుస్తూ, ప్రసారమవుతున్న దాంట్లోకి నేరుగా వెళ్లండి, ఏం చూడాలో షెడ్యూల్‌కే వదిలేయండి."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RetroGuide.TV તમારી Plex કે Jellyfin લાઇબ્રેરીને પ્રોગ્રામ ગાઇડ સાથેની લાઇવ ટીવી ચેનલોમાં ફેરવે છે. ચેનલો બદલતા રહો, જે ચાલતું હોય તેમાં જોડાઈ જાઓ, અને શું જોવું તે શેડ્યૂલને નક્કી કરવા દો."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RetroGuide.TV ನಿಮ್ಮ Plex ಅಥವಾ Jellyfin ಲೈಬ್ರರಿಯನ್ನು ಕಾರ್ಯಕ್ರಮ ಗೈಡ್ ಇರುವ ಲೈವ್ ಟಿವಿ ಚಾನಲ್‌ಗಳಾಗಿ ಪರಿವರ್ತಿಸುತ್ತದೆ. ಚಾನಲ್‌ಗಳನ್ನು ಬದಲಿಸಿ, ಏನು ಪ್ರಸಾರವಾಗುತ್ತಿದೆಯೋ ಅದನ್ನು ನೋಡಿ, ಆಯ್ಕೆಯನ್ನು ವೇಳಾಪಟ್ಟಿಗೆ ಬಿಡಿ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RetroGuide.TV നിങ്ങളുടെ Plex അല്ലെങ്കിൽ Jellyfin ലൈബ്രറിയെ പ്രോഗ്രാം ഗൈഡുള്ള ലൈവ് ടിവി ചാനലുകളാക്കി മാറ്റുന്നു. ചാനലുകൾ മാറ്റി നോക്കൂ, നടക്കുന്ന പരിപാടിയിലേക്ക് നേരെ കടക്കൂ, എന്ത് കാണണമെന്ന് ഷെഡ്യൂൾ തീരുമാനിക്കട്ടെ."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RetroGuide.TV ਤੁਹਾਡੀ Plex ਜਾਂ Jellyfin ਲਾਇਬ੍ਰੇਰੀ ਨੂੰ ਪ੍ਰੋਗਰਾਮ ਗਾਈਡ ਵਾਲੇ ਲਾਈਵ TV ਚੈਨਲਾਂ ਵਿੱਚ ਬਦਲਦਾ ਹੈ। ਚੈਨਲ ਬਦਲੋ, ਜੋ ਵੀ ਚੱਲ ਰਿਹਾ ਹੋਵੇ ਉਸ ਨਾਲ ਜੁੜੋ, ਅਤੇ ਚੋਣ ਸ਼ਡਿਊਲ 'ਤੇ ਛੱਡ ਦਿਓ।"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RetroGuide.TV ଆପଣଙ୍କ Plex ବା Jellyfin ଲାଇବ୍ରେରୀକୁ ପ୍ରୋଗ୍ରାମ ଗାଇଡ୍ ସହ ଲାଇଭ୍ TV ଚ୍ୟାନେଲରେ ପରିଣତ କରେ। ଚ୍ୟାନେଲ ବଦଳାନ୍ତୁ, ଯାହା ଚାଲୁଛି ସେଥିରେ ଯୋଗ ଦିଅନ୍ତୁ, ଏବଂ କ'ଣ ଦେଖିବେ ତାହା ସୂଚୀକୁ ବାଛିବାକୁ ଦିଅନ୍ତୁ।"
          }
        }
      }
    },
