    "Only these libraries can supply content. Each library lists the server it belongs to." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo estas bibliotecas pueden aportar contenido. Cada biblioteca indica el servidor al que pertenece."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só estas bibliotecas podem fornecer conteúdo. Cada biblioteca mostra o servidor ao qual pertence."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seules ces bibliothèques peuvent fournir du contenu. Chaque bibliothèque indique son serveur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo queste librerie possono fornire contenuti. Ogni libreria indica il server a cui appartiene."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur diese Bibliotheken dürfen Inhalte liefern. Bei jeder Bibliothek steht der Server, zu dem sie gehört."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen deze bibliotheken mogen inhoud leveren. Bij elke bibliotheek staat de server waartoe ze behoort."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bara de här biblioteken kan bidra med innehåll. Varje bibliotek visar vilken server det tillhör."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treści mogą pochodzić tylko z tych bibliotek. Przy każdej bibliotece podano jej serwer."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obsah mohou poskytovat jen tyto knihovny. U každé knihovny je uvedený server, ke kterému patří."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Контент берётся только из этих медиатек. Для каждой медиатеки указан её сервер."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンテンツはこれらのライブラリからのみ提供されます。各ライブラリには所属するサーバが表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 라이브러리에서만 콘텐츠를 가져옵니다. 각 라이브러리에 해당 서버가 표시됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有这些媒体库可以提供内容。每个媒体库都会列出其所属的服务器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有這些媒體庫可以提供內容。每個媒體庫都會列出其所屬的伺服器。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिर्फ़ ये लाइब्रेरी कंटेंट दे सकती हैं। हर लाइब्रेरी के साथ उसका सर्वर दिखता है।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শুধু এই লাইব্রেরিগুলো থেকে কনটেন্ট আসতে পারে। প্রতিটি লাইব্রেরির পাশে তার সার্ভার দেখানো হয়।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फक्त या लायब्ररी सामग्री देऊ शकतात. प्रत्येक लायब्ररीसोबत ती कोणत्या सर्व्हरची आहे ते दिसते."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இந்த லைப்ரரிகள் மட்டுமே உள்ளடக்கத்தை வழங்கும். ஒவ்வொரு லைப்ரரியும் அது சார்ந்த சர்வரைக் காட்டும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఈ లైబ్రరీలు మాత్రమే కంటెంట్ అందించగలవు. ప్రతి లైబ్రరీ అది చెందిన సర్వర్‌ను చూపుతుంది."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "માત્ર આ લાઇબ્રેરી જ કન્ટેન્ટ આપી શકે છે. દરેક લાઇબ્રેરી સાથે તેનું સર્વર દર્શાવેલું છે."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಈ ಲೈಬ್ರರಿಗಳು ಮಾತ್ರ ವಿಷಯ ಒದಗಿಸಬಹುದು. ಪ್ರತಿ ಲೈಬ್ರರಿ ತಾನು ಸೇರಿದ ಸರ್ವರ್ ಅನ್ನು ತೋರಿಸುತ್ತದೆ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഈ ലൈബ്രറികളിൽ നിന്ന് മാത്രമേ ഉള്ളടക്കം ലഭിക്കൂ. ഓരോ ലൈബ്രറിയും ഏത് സെർവറിന്റേതാണെന്ന് കാണിക്കുന്നു."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਸਿਰਫ਼ ਇਹ ਲਾਇਬ੍ਰੇਰੀਆਂ ਸਮੱਗਰੀ ਦੇ ਸਕਦੀਆਂ ਹਨ। ਹਰ ਲਾਇਬ੍ਰੇਰੀ ਨਾਲ ਉਸਦਾ ਸਰਵਰ ਦੱਸਿਆ ਗਿਆ ਹੈ।"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "କେବଳ ଏହି ଲାଇବ୍ରେରୀଗୁଡ଼ିକ ବିଷୟବସ୍ତୁ ଯୋଗାଇପାରିବ। ପ୍ରତ୍ୟେକ ଲାଇବ୍ରେରୀ ପାଖରେ ତାହାର ସର୍ଭର ଦେଖାଯାଏ।"
          }
        }
      }
    },
