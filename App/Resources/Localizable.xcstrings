        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বিরতি চালু করতে এমন একটি লাইব্রেরি বেছে নিন, যাতে শুধু বিজ্ঞাপন আছে।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ब्रेक सुरू करण्यासाठी फक्त जाहिराती असलेली लायब्ररी निवडा."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இடைவேளைகளை இயக்க, விளம்பரங்கள் மட்டும் உள்ள லைப்ரரியைத் தேர்வுசெய்யவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "బ్రేక్‌లను ఎనేబుల్ చేయడానికి కేవలం కమర్షియల్స్ ఉన్న లైబ్రరీని ఎంచుకోండి."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "બ્રેક ચાલુ કરવા માત્ર જાહેરાતોવાળી લાઇબ્રેરી પસંદ કરો."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ವಿರಾಮಗಳನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಲು ಜಾಹೀರಾತುಗಳನ್ನು ಮಾತ್ರ ಹೊಂದಿರುವ ಲೈಬ್ರರಿ ಆಯ್ಕೆಮಾಡಿ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഇടവേളകൾ ഓണാക്കാൻ, പരസ്യങ്ങൾ മാത്രമുള്ള ഒരു ലൈബ്രറി തിരഞ്ഞെടുക്കുക."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਬ੍ਰੇਕਾਂ ਚਾਲੂ ਕਰਨ ਲਈ ਸਿਰਫ਼ ਕਮਰਸ਼ੀਅਲਾਂ ਵਾਲੀ ਲਾਇਬ੍ਰੇਰੀ ਚੁਣੋ।"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ବିରତି ଚାଲୁ କରିବାକୁ କେବଳ ବିଜ୍ଞାପନ ଥିବା ଏକ ଲାଇବ୍ରେରୀ ବାଛନ୍ତୁ।"
          }
        }
      }
    },
