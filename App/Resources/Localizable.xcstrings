        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "頻道會混合播放這裡所有伺服器的節目。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चैनल यहाँ के सभी सर्वरों के प्रोग्राम मिलाकर दिखाते हैं।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "চ্যানেলগুলো এখানের সব সার্ভারের অনুষ্ঠান মিলিয়ে দেখায়।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चॅनेल इथल्या सर्व सर्व्हरवरील कार्यक्रम एकत्र दाखवतात."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "சேனல்கள் இங்குள்ள எல்லா சர்வர்களின் நிகழ்ச்சிகளையும் கலந்து காட்டும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఛానెల్‌లు ఇక్కడి అన్ని సర్వర్‌ల ప్రోగ్రామ్‌లను కలిపి చూపిస్తాయి."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ચૅનલો અહીંનાં બધાં સર્વરના કાર્યક્રમો ભેળવીને બતાવે છે."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಚಾನೆಲ್‌ಗಳು ಇಲ್ಲಿನ ಎಲ್ಲಾ ಸರ್ವರ್‌ಗಳ ಕಾರ್ಯಕ್ರಮಗಳನ್ನು ಮಿಶ್ರಮಾಡಿ ತೋರಿಸುತ್ತವೆ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഇവിടെയുള്ള എല്ലാ സെർവറുകളിലെയും പരിപാടികൾ ചാനലുകൾ ഇടകലർത്തി കാണിക്കും."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਚੈਨਲ ਇੱਥੇ ਦੇ ਸਾਰੇ ਸਰਵਰਾਂ ਦੇ ਪ੍ਰੋਗਰਾਮ ਮਿਲਾ ਕੇ ਦਿਖਾਉਂਦੇ ਹਨ।"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଚ୍ୟାନେଲଗୁଡ଼ିକ ଏଠାରେ ଥିବା ସମସ୍ତ ସର୍ଭରର କାର୍ଯ୍ୟକ୍ରମ ମିଶାଇ ଦେଖାଏ।"
          }
        }
      }
    },
