    "Channel loading was cancelled. Your saved servers and library selections have not changed." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se canceló la carga de canales. Tus servidores guardados y las bibliotecas seleccionadas no cambiaron."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O carregamento de canais foi cancelado. Seus servidores salvos e as bibliotecas selecionadas não mudaram."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le chargement des chaînes a été annulé. Vos serveurs enregistrés et vos bibliothèques sélectionnées n'ont pas changé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il caricamento dei canali è stato annullato. I server salvati e le librerie selezionate non sono cambiati."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Laden der Kanäle wurde abgebrochen. Deine gespeicherten Server und deine Bibliotheksauswahl wurden nicht geändert."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het laden van zenders is geannuleerd. Je bewaarde servers en bibliotheekselectie zijn niet gewijzigd."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanalinläsningen avbröts. Dina sparade servrar och biblioteksval har inte ändrats."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wczytywanie kanałów zostało anulowane. Zapisane serwery i wybór bibliotek nie zmieniły się."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Načítání kanálů bylo zrušeno. Uložené servery a výběr knihoven se nezměnily."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загрузка каналов отменена. Сохраненные серверы и выбранные медиатеки не изменились."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チャンネルの読み込みはキャンセルされました。保存済みのサーバとライブラリの選択は変更されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "채널 불러오기가 취소되었습니다. 저장된 서버와 라이브러리 선택은 변경되지 않았습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已取消载入频道。已存储的服务器和媒体库选择没有改变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已取消載入頻道。已儲存的伺服器和媒體庫選擇沒有變更。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चैनल लोड करना रद्द कर दिया गया। आपके सेव किए गए सर्वर और चुनी गई लाइब्रेरी नहीं बदलीं।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "চ্যানেল লোড করা বাতিল করা হয়েছে। আপনার সেভ করা সার্ভার ও বাছাই করা লাইব্রেরি বদলায়নি।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चॅनेल लोड करणे रद्द झाले. तुमचे सेव्ह केलेले सर्व्हर आणि लायब्ररी निवडी बदललेल्या नाहीत."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "சேனல் ஏற்றம் ரத்துசெய்யப்பட்டது. நீங்கள் சேமித்த சர்வர்களும் லைப்ரரி தேர்வுகளும் மாறவில்லை."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఛానెల్ లోడింగ్ రద్దయింది. మీరు సేవ్ చేసిన సర్వర్‌లు, లైబ్రరీ ఎంపికలు మారలేదు."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ચેનલ લોડિંગ રદ થયું. તમારાં સાચવેલાં સર્વર અને લાઇબ્રેરીની પસંદગી બદલાઈ નથી."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಚಾನಲ್ ಲೋಡಿಂಗ್ ರದ್ದಾಗಿದೆ. ನಿಮ್ಮ ಸೇವ್ ಮಾಡಿದ ಸರ್ವರ್‌ಗಳು ಮತ್ತು ಲೈಬ್ರರಿ ಆಯ್ಕೆಗಳು ಬದಲಾಗಿಲ್ಲ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ചാനൽ ലോഡിങ് റദ്ദാക്കി. സേവ് ചെയ്ത സെർവറുകളിലും ലൈബ്രറി തിരഞ്ഞെടുപ്പുകളിലും മാറ്റമില്ല."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਚੈਨਲ ਲੋਡਿੰਗ ਰੱਦ ਕਰ ਦਿੱਤੀ ਗਈ। ਤੁਹਾਡੇ ਸੇਵ ਕੀਤੇ ਸਰਵਰ ਅਤੇ ਲਾਇਬ੍ਰੇਰੀ ਚੋਣਾਂ ਨਹੀਂ ਬਦਲੀਆਂ।"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଚ୍ୟାନେଲ ଲୋଡିଂ ବାତିଲ୍ ହେଲା। ଆପଣଙ୍କ ସେଭ୍ ହୋଇଥିବା ସର୍ଭର ଓ ଲାଇବ୍ରେରୀ ଚୟନ ବଦଳିନାହିଁ।"
          }
        }
      }
    },
