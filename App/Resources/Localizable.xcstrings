    "The saved sync journal could not be read. Your settings on this device are unchanged." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo leer el registro de sincronización guardado. Tu configuración en este dispositivo no cambió."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ler o registro de sincronização salvo. Seus ajustes neste dispositivo não mudaram."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le journal de synchro enregistré n'a pas pu être lu. Vos réglages sur cet appareil sont inchangés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
