        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने चैनलों के सभी शो और फ़िल्में खोजें।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার চ্যানেলের সব শো ও সিনেমা খুঁজুন।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुमच्या चॅनेलवरील प्रत्येक शो आणि चित्रपट शोधा."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் சேனல்களில் உள்ள எல்லா நிகழ்ச்சிகளையும் படங்களையும் தேடலாம்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీ ఛానెల్‌లలోని ప్రతి షో, సినిమాను వెతకండి."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમારી ચેનલો પરના દરેક શો અને ફિલ્મ શોધો."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಿಮ್ಮ ಚಾನಲ್‌ಗಳಲ್ಲಿನ ಎಲ್ಲಾ ಶೋಗಳು ಮತ್ತು ಸಿನಿಮಾಗಳನ್ನು ಹುಡುಕಿ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിങ്ങളുടെ ചാനലുകളിലെ എല്ലാ ഷോകളും സിനിമകളും തിരയുക."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਆਪਣੇ ਚੈਨਲਾਂ 'ਤੇ ਹਰ ਸ਼ੋਅ ਅਤੇ ਫ਼ਿਲਮ ਖੋਜੋ।"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆପଣଙ୍କ ଚ୍ୟାନେଲର ସବୁ ଶୋ ଓ ସିନେମା ସନ୍ଧାନ କରନ୍ତୁ।"
          }
