        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "直接播放所有檔案，無須伺服器轉碼。建議使用。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर फ़ाइल सीधे चलाता है, सर्वर ट्रांसकोडिंग के बिना। सुझाया गया।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্রতিটি ফাইল সরাসরি চালায়, সার্ভারে ট্রান্সকোডিং ছাড়া। প্রস্তাবিত।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रत्येक फाइल थेट प्ले करते, सर्व्हर ट्रान्सकोडिंगशिवाय. शिफारस केलेले."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "சர்வர் டிரான்ஸ்கோடிங் இல்லாமல், ஒவ்வொரு கோப்பையும் நேரடியாக இயக்கும். பரிந்துரைக்கப்படுகிறது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "సర్వర్ ట్రాన్స్‌కోడింగ్ లేకుండా ప్రతి ఫైల్‌ను నేరుగా ప్లే చేస్తుంది. సిఫార్సు చేయబడింది."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "દરેક ફાઇલ સર્વર ટ્રાન્સકોડિંગ વિના સીધી ચલાવે છે. ભલામણ કરેલું."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಸರ್ವರ್ ಟ್ರಾನ್ಸ್‌ಕೋಡಿಂಗ್ ಇಲ್ಲದೆ ಪ್ರತಿ ಫೈಲ್ ಅನ್ನು ನೇರವಾಗಿ ಪ್ಲೇ ಮಾಡುತ್ತದೆ. ಶಿಫಾರಸು ಮಾಡಲಾಗಿದೆ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "സെർവർ ട്രാൻസ്‌കോഡിങ് ഇല്ലാതെ എല്ലാ ഫയലുകളും നേരിട്ട് പ്ലേ ചെയ്യുന്നു. ശുപാർശ ചെയ്യുന്നു."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਹਰ ਫ਼ਾਈਲ ਸਿੱਧੀ ਚਲਾਉਂਦਾ ਹੈ, ਸਰਵਰ ਟ੍ਰਾਂਸਕੋਡਿੰਗ ਤੋਂ ਬਿਨਾਂ। ਸਿਫ਼ਾਰਸ਼ੀ।"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ସର୍ଭର ଟ୍ରାନ୍ସକୋଡିଂ ବିନା ପ୍ରତ୍ୟେକ ଫାଇଲ୍ ସିଧାସଳଖ ଚଲାଏ। ସୁପାରିଶ କରାଯାଏ।"
          }
        }
      }
    },
