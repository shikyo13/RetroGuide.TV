        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usunięto %1$@ z kanału %2$@. Wszystko, co usunięto, znajdziesz w Ustawienia › Kanały › Usunięte z kanałów."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titul %1$@ byl odebrán z kanálu %2$@. Vše odebrané najdeš v Nastavení › Kanály › Odebráno z kanálů."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы убрали «%1$@» с канала %2$@. Всё, что вы убрали, перечислено в разделе «Настройки › Каналы › Убрано с каналов»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@を%2$@から除外しました。除外したものはすべて「設定 › チャンネル › チャンネルから除外」で確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@을(를) %2$@에서 제외했습니다. 제외한 항목은 모두 설정 › 채널 › 채널에서 제외됨에서 확인할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 已从 %2$@ 中移除。“设置 › 频道 › 已从频道移除”会列出你移除的所有内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已將 %1$@ 從 %2$@ 移除。「設定 › 頻道 › 已從頻道移除」會列出你移除的所有內容。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ को %2$@ से हटा दिया गया है। आपने जो कुछ भी हटाया है, वह सेटिंग्ज़ › चैनल › चैनलों से हटाए गए में दिखता है।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ সরানো হয়েছে %2$@ থেকে। আপনি যা যা সরিয়েছেন, তা সেটিংস › চ্যানেল › চ্যানেল থেকে সরানো-তে দেখা যাবে।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ हे %2$@ मधून काढले आहे. सेटिंग्ज › चॅनेल › चॅनेलमधून काढलेले येथे तुम्ही काढलेले सर्व काही दिसते."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@-இலிருந்து அகற்றப்பட்டது. நீங்கள் அகற்றிய அனைத்தும் அமைப்புகள் › சேனல்கள் › சேனல்களிலிருந்து அகற்றியவை என்பதில் இருக்கும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ నుండి తీసివేయబడింది. మీరు తీసివేసినవన్నీ సెట్టింగ్‌లు › ఛానెల్‌లు › ఛానెల్‌ల నుండి తీసివేసినవిలో ఉంటాయి."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ને %2$@માંથી દૂર કર્યું. તમે દૂર કરેલું બધું સેટિંગ્સ › ચેનલો › ચેનલોમાંથી દૂર કરેલાંમાં દેખાય છે."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ಅನ್ನು %2$@ ಚಾನಲ್‌ನಿಂದ ತೆಗೆದುಹಾಕಲಾಗಿದೆ. ನೀವು ತೆಗೆದುಹಾಕಿದ ಎಲ್ಲವೂ ಇಲ್ಲಿ ಕಾಣುತ್ತವೆ: ಸೆಟ್ಟಿಂಗ್‌ಗಳು › ಚಾನಲ್‌ಗಳು › ಚಾನಲ್‌ಗಳಿಂದ ತೆಗೆದವು."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@-ൽ നിന്ന് നീക്കം ചെയ്തു. നിങ്ങൾ നീക്കം ചെയ്തതെല്ലാം ക്രമീകരണം › ചാനലുകൾ › ചാനലുകളിൽ നിന്ന് നീക്കിയവ എന്നതിൽ കാണാം."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ਨੂੰ %2$@ ਤੋਂ ਹਟਾ ਦਿੱਤਾ ਗਿਆ ਹੈ। ਤੁਹਾਡੇ ਵੱਲੋਂ ਹਟਾਈ ਹਰ ਚੀਜ਼ ਸੈਟਿੰਗਾਂ › ਚੈਨਲ › ਚੈਨਲਾਂ ਤੋਂ ਹਟਾਏ ਗਏ ਵਿੱਚ ਦਿਖਦੀ ਹੈ।"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ କୁ %2$@ ରୁ ହଟାଯାଇଛି। ଆପଣ ହଟାଇଥିବା ସବୁକିଛି ଦେଖିବାକୁ ସେଟିଂସ୍ › ଚ୍ୟାନେଲ › ଚ୍ୟାନେଲରୁ ହଟାଯାଇଥିବା ଖୋଲନ୍ତୁ।"
          }
        }
      }
    },
