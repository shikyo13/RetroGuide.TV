            "state" : "translated",
            "value" : "Ta bort %1$@ (%2$@)? Dess program försvinner från alla kanaler."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usunąć %1$@ (%2$@)? Jego programy znikną ze wszystkich kanałów."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odebrat %1$@ (%2$@)? Jeho pořady zmizí ze všech kanálů."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалить %1$@ (%2$@)? Его передачи пропадут со всех каналов."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@（%2$@）を削除しますか？ このサーバの番組はすべてのチャンネルからなくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@(%2$@)을(를) 제거하겠습니까? 이 서버의 프로그램이 모든 채널에서 빠집니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要移除 %1$@（%2$@）吗？其节目将从所有频道中撤下。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要移除 %1$@（%2$@）嗎？其節目將從所有頻道下架。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (%2$@) हटाएँ? इसके प्रोग्राम हर चैनल से हट जाएँगे।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (%2$@) সরাবেন? এর অনুষ্ঠান সব চ্যানেল থেকে সরে যাবে।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (%2$@) काढून टाकायचा? त्याचे कार्यक्रम सर्व चॅनेलमधून निघून जातील."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (%2$@)-ஐ அகற்றவா? அதன் நிகழ்ச்சிகள் எல்லாச் சேனல்களிலிருந்தும் நீங்கும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (%2$@)ను తీసివేయాలా? దాని ప్రోగ్రామ్‌లు ప్రతి ఛానెల్ నుండి వెళ్లిపోతాయి."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (%2$@) દૂર કરીએ? તેના પ્રોગ્રામ દરેક ચેનલમાંથી નીકળી જશે."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (%2$@) ತೆಗೆದುಹಾಕುವುದೇ? ಇದರ ಕಾರ್ಯಕ್ರಮಗಳು ಎಲ್ಲಾ ಚಾನಲ್‌ಗಳಿಂದ ಹೊರಹೋಗುತ್ತವೆ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (%2$@) നീക്കം ചെയ്യണോ? ഇതിലെ പരിപാടികൾ എല്ലാ ചാനലുകളിൽ നിന്നും ഒഴിവാകും."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਕੀ %1$@ (%2$@) ਹਟਾਉਣਾ ਹੈ? ਇਸਦੇ ਪ੍ਰੋਗਰਾਮ ਹਰ ਚੈਨਲ ਤੋਂ ਹਟ ਜਾਣਗੇ।"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (%2$@) ହଟାଇବେ? ଏହାର କାର୍ଯ୍ୟକ୍ରମ ସବୁ ଚ୍ୟାନେଲରୁ ହଟିଯିବ।"
          }
        }
      }
