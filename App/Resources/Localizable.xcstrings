    "Your Jellyfin password and video won't be encrypted on your home network or VPN. Internet addresses still need HTTPS." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu contraseña de Jellyfin y el video no se cifrarán en tu red doméstica o VPN. Las direcciones de internet siguen necesitando HTTPS."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua senha do Jellyfin e o vídeo não serão criptografados na sua rede doméstica ou VPN. Endereços de internet continuam precisando de HTTPS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre mot de passe Jellyfin et la vidéo ne seront pas chiffrés sur votre réseau local ou votre VPN. Les adresses Internet exigent toujours HTTPS."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
