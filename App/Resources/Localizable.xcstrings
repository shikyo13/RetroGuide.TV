        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने Apple खाते से साइन इन किए गए डिवाइस पर एक ही सेटअप इस्तेमाल करें।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার Apple অ্যাকাউন্টে সাইন ইন করা সব ডিভাইসে একই সেটআপ ব্যবহার করুন।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुमच्या Apple खात्यात साइन इन केलेल्या डिव्हाइसवर एकच सेटअप वापरा."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் Apple கணக்கில் உள்நுழைந்த சாதனங்களில் ஒரே அமைப்பைப் பயன்படுத்தலாம்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీ Apple ఖాతాతో సైన్ ఇన్ అయిన పరికరాల్లో ఒకే సెటప్ ఉపయోగించండి."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમારા Apple એકાઉન્ટમાં સાઇન ઇન કરેલાં ડિવાઇસ પર એક જ સેટઅપ વાપરો."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಿಮ್ಮ Apple ಖಾತೆಗೆ ಸೈನ್ ಇನ್ ಆಗಿರುವ ಸಾಧನಗಳಲ್ಲಿ ಒಂದೇ ಸೆಟಪ್ ಬಳಸಿ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിങ്ങളുടെ Apple അക്കൗണ്ടിൽ സൈൻ ഇൻ ചെയ്ത ഉപകരണങ്ങളിൽ ഒരേ സജ്ജീകരണം ഉപയോഗിക്കുക."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤੁਹਾਡੇ Apple Account ਵਿੱਚ ਸਾਈਨ ਇਨ ਕੀਤੇ ਡਿਵਾਈਸਾਂ 'ਤੇ ਇੱਕੋ ਸੈੱਟਅੱਪ ਵਰਤੋ।"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆପଣଙ୍କ Apple Accountରେ ସାଇନ୍ ଇନ୍ ଥିବା ଡିଭାଇସରେ ସମାନ ସେଟଅପ୍ ବ୍ୟବହାର କରନ୍ତୁ।"
          }
        }
      }
    },
    "Use this PIN to change settings or turn off parental controls. Keep it somewhere safe." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa este PIN para cambiar la configuración o desactivar los controles parentales. Guárdalo en un lugar seguro."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use este PIN para alterar os ajustes ou desativar o controle parental. Guarde-o em um lugar seguro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez ce code pour modifier les réglages ou désactiver le contrôle parental. Conservez-le en lieu sûr."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa questo PIN per modificare le impostazioni o disattivare il controllo parentale. Conservalo in un posto sicuro."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit dieser PIN kannst du Einstellungen ändern oder die Kindersicherung deaktivieren. Bewahre sie sicher auf."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met deze pincode kun je instellingen wijzigen of ouderlijk toezicht uitzetten. Bewaar hem op een veilige plek."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Använd den här PIN-koden för att ändra inställningar eller stänga av föräldrakontrollen. Förvara den på ett säkert ställe."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten PIN służy do zmiany ustawień i wyłączania kontroli rodzicielskiej. Przechowuj go w bezpiecznym miejscu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tímto PINem můžeš měnit nastavení nebo vypnout rodičovskou kontrolu. Uchovej ho na bezpečném místě."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот PIN-код нужен, чтобы изменять настройки или выключать родительский контроль. Храните его в надёжном месте."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このPINは、設定の変更やペアレンタルコントロールをオフにするときに使います。安全な場所に保管してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 PIN은 설정을 변경하거나 자녀 보호 기능을 끌 때 사용합니다. 안전한 곳에 보관하십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用此 PIN 码更改设置或关闭家长控制。请妥善保管。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用此 PIN 碼更改設定或關閉家長監護。請妥善保管。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सेटिंग्ज़ बदलने या पेरेंटल कंट्रोल बंद करने के लिए यह PIN इस्तेमाल करें। इसे कहीं सुरक्षित रखें।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সেটিংস বদলাতে বা প্যারেন্টাল কন্ট্রোল বন্ধ করতে এই PIN ব্যবহার করুন। এটি কোথাও নিরাপদে রাখুন।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सेटिंग्ज बदलण्यासाठी किंवा पालक नियंत्रणे बंद करण्यासाठी हा PIN वापरा. तो सुरक्षित ठिकाणी ठेवा."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "அமைப்புகளை மாற்ற அல்லது பெற்றோர் கட்டுப்பாடுகளை முடக்க இந்த PIN-ஐப் பயன்படுத்தவும். இதைப் பாதுகாப்பான இடத்தில் வைத்திருக்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "సెట్టింగ్‌లు మార్చడానికి లేదా పేరెంటల్ కంట్రోల్స్ ఆఫ్ చేయడానికి ఈ PIN ఉపయోగించండి. దాన్ని సురక్షితమైన చోట ఉంచండి."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "સેટિંગ્સ બદલવા કે પેરેન્ટલ કંટ્રોલ બંધ કરવા આ PIN વાપરો. તેને કોઈ સુરક્ષિત જગ્યાએ રાખો."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಬದಲಿಸಲು ಅಥವಾ ಪೋಷಕರ ನಿಯಂತ್ರಣಗಳನ್ನು ಆಫ್ ಮಾಡಲು ಈ PIN ಬಳಸಿ. ಇದನ್ನು ಸುರಕ್ಷಿತ ಸ್ಥಳದಲ್ಲಿ ಇಟ್ಟುಕೊಳ್ಳಿ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ക്രമീകരണങ്ങൾ മാറ്റാനോ രക്ഷാകർതൃ നിയന്ത്രണങ്ങൾ ഓഫാക്കാനോ ഈ PIN ഉപയോഗിക്കുക. ഇത് സുരക്ഷിതമായി സൂക്ഷിക്കുക."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਸੈਟਿੰਗਾਂ ਬਦਲਣ ਜਾਂ ਪੇਰੈਂਟਲ ਕੰਟਰੋਲ ਬੰਦ ਕਰਨ ਲਈ ਇਹ PIN ਵਰਤੋ। ਇਸਨੂੰ ਕਿਸੇ ਸੁਰੱਖਿਅਤ ਥਾਂ ਰੱਖੋ।"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ସେଟିଂସ୍ ବଦଳାଇବାକୁ ବା ଅଭିଭାବକ ନିୟନ୍ତ୍ରଣ ବନ୍ଦ କରିବାକୁ ଏହି PIN ବ୍ୟବହାର କରନ୍ତୁ। ଏହାକୁ କୌଣସି ସୁରକ୍ଷିତ ସ୍ଥାନରେ ରଖନ୍ତୁ।"
          }
        }
      }
    },
