    "Some commercial libraries could not be loaded. Programs will continue on schedule." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron cargar algunas bibliotecas de anuncios. Los programas seguirán según lo previsto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível carregar algumas bibliotecas de comerciais. Os programas continuam no horário."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certaines bibliothèques de pubs n'ont pas pu être chargées. Les programmes continuent comme prévu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile caricare alcune librerie di spot. I programmi continueranno come previsto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige Werbebibliotheken konnten nicht geladen werden. Die Sendungen laufen planmäßig weiter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sommige reclamebibliotheken konden niet worden geladen. Programma’s gaan volgens schema door."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vissa reklambibliotek kunde inte läsas in. Programmen fortsätter enligt tablån."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się wczytać niektórych bibliotek reklam. Programy będą emitowane zgodnie z ramówką."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Některé knihovny reklam nelze načíst. Pořady poběží dál podle programu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось загрузить некоторые медиатеки рекламы. Передачи продолжатся по расписанию."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一部のCMライブラリを読み込めませんでした。番組は予定どおり続きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일부 광고 라이브러리를 불러올 수 없습니다. 프로그램은 편성대로 계속됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部分广告片媒体库无法载入。节目将按排播继续播出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部分廣告片媒體庫無法載入。節目將照排播繼續播出。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कुछ विज्ञापन लाइब्रेरी लोड नहीं हो सकीं। प्रोग्राम शेड्यूल के अनुसार चलते रहेंगे।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কিছু বিজ্ঞাপন লাইব্রেরি লোড করা যায়নি। অনুষ্ঠান শিডিউল অনুযায়ী চলতে থাকবে।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "काही जाहिरात लायब्ररी लोड करता आल्या नाहीत. कार्यक्रम वेळापत्रकानुसार सुरू राहतील."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "சில விளம்பர லைப்ரரிகளை ஏற்ற முடியவில்லை. நிகழ்ச்சிகள் அட்டவணைப்படி தொடரும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "కొన్ని కమర్షియల్ లైబ్రరీలను లోడ్ చేయలేకపోయాము. ప్రోగ్రామ్‌లు షెడ్యూల్ ప్రకారం కొనసాగుతాయి."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "કેટલીક જાહેરાત લાઇબ્રેરી લોડ થઈ શકી નહીં. પ્રોગ્રામ શેડ્યૂલ મુજબ ચાલુ રહેશે."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಕೆಲವು ಜಾಹೀರಾತು ಲೈಬ್ರರಿಗಳನ್ನು ಲೋಡ್ ಮಾಡಲಾಗಲಿಲ್ಲ. ಕಾರ್ಯಕ್ರಮಗಳು ವೇಳಾಪಟ್ಟಿಯಂತೆ ಮುಂದುವರಿಯುತ್ತವೆ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ചില പരസ്യ ലൈബ്രറികൾ ലോഡ് ചെയ്യാനായില്ല. പരിപാടികൾ ഷെഡ്യൂൾ പ്രകാരം തുടരും."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਕੁਝ ਕਮਰਸ਼ੀਅਲ ਲਾਇਬ੍ਰੇਰੀਆਂ ਲੋਡ ਨਹੀਂ ਹੋ ਸਕੀਆਂ। ਪ੍ਰੋਗਰਾਮ ਸ਼ਡਿਊਲ ਮੁਤਾਬਕ ਜਾਰੀ ਰਹਿਣਗੇ।"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
