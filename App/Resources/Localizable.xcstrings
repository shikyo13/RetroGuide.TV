        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das gespeicherte Sync-Protokoll konnte nicht gelesen werden. Deine Einstellungen auf diesem Gerät sind unverändert."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
