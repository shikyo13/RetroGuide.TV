    },
    "Blocked shows and movies are hidden from every channel, including matching copies on other servers." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las series y películas bloqueadas se ocultan de todos los canales, incluidas las copias equivalentes en otros servidores."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Séries e filmes bloqueados ficam ocultos em todos os canais, incluindo cópias correspondentes em outros servidores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les séries et films bloqués sont masqués sur toutes les chaînes, y compris leurs copies sur d'autres serveurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serie e i film bloccati sono nascosti in tutti i canali, comprese le copie corrispondenti su altri server."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesperrte Serien und Filme werden auf allen Kanälen ausgeblendet, auch passende Kopien auf anderen Servern."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
