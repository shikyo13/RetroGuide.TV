    "No Jellyfin server answered at that address. Check the address and port (Jellyfin usually uses 8096)." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ningún servidor Jellyfin respondió en esa dirección. Comprueba la dirección y el puerto (Jellyfin suele usar el 8096)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhum servidor Jellyfin respondeu nesse endereço. Verifique o endereço e a porta (o Jellyfin costuma usar a 8096)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun serveur Jellyfin n'a répondu à cette adresse. Vérifiez l'adresse et le port (Jellyfin utilise généralement le 8096)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun server Jellyfin ha risposto a questo indirizzo. Controlla indirizzo e porta (di solito Jellyfin usa la 8096)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter dieser Adresse hat kein Jellyfin-Server geantwortet. Prüfe Adresse und Port (Jellyfin nutzt meist 8096)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er reageerde geen Jellyfin-server op dat adres. Controleer het adres en de poort (Jellyfin gebruikt meestal 8096)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen Jellyfin-server svarade på den adressen. Kontrollera adressen och porten (Jellyfin använder oftast 8096)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Żaden serwer Jellyfin nie odpowiedział pod tym adresem. Sprawdź adres i port (Jellyfin zwykle używa 8096)."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na této adrese neodpověděl žádný server Jellyfin. Zkontroluj adresu a port (Jellyfin obvykle používá 8096)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По этому адресу не ответил ни один сервер Jellyfin. Проверьте адрес и порт (обычно Jellyfin использует 8096)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そのアドレスで応答したJellyfinサーバはありません。アドレスとポートを確認してください（Jellyfinは通常8096を使います）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "해당 주소에서 응답한 Jellyfin 서버가 없습니다. 주소와 포트를 확인하십시오(Jellyfin은 보통 8096을 사용합니다)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该地址没有 Jellyfin 服务器响应。请检查地址和端口（Jellyfin 通常使用 8096）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "該位址沒有 Jellyfin 伺服器回應。請檢查位址和連接埠（Jellyfin 通常使用 8096）。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उस पते पर किसी Jellyfin सर्वर ने जवाब नहीं दिया। पता और पोर्ट जाँचें (Jellyfin आम तौर पर 8096 इस्तेमाल करता है)।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ওই ঠিকানায় কোনো Jellyfin সার্ভার সাড়া দেয়নি। ঠিকানা ও পোর্ট যাচাই করুন (Jellyfin সাধারণত 8096 ব্যবহার করে)।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "त्या पत्त्यावर कोणत्याही Jellyfin सर्व्हरने प्रतिसाद दिला नाही. पत्ता आणि पोर्ट तपासा (Jellyfin सहसा 8096 वापरतो)."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "அந்த முகவரியில் எந்த Jellyfin சர்வரும் பதிலளிக்கவில்லை. முகவரி, போர்ட்டைச் சரிபார்க்கவும் (Jellyfin பொதுவாக 8096-ஐப் பயன்படுத்தும்)."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఆ అడ్రస్‌లో ఏ Jellyfin సర్వర్ స్పందించలేదు. అడ్రస్, పోర్ట్‌ను తనిఖీ చేయండి (Jellyfin సాధారణంగా 8096 ఉపయోగిస్తుంది)."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તે સરનામે કોઈ Jellyfin સર્વરે જવાબ ન આપ્યો. સરનામું અને પોર્ટ તપાસો (Jellyfin સામાન્ય રીતે 8096 વાપરે છે)."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಆ ವಿಳಾಸದಲ್ಲಿ ಯಾವುದೇ Jellyfin ಸರ್ವರ್ ಪ್ರತಿಕ್ರಿಯಿಸಲಿಲ್ಲ. ವಿಳಾಸ ಮತ್ತು ಪೋರ್ಟ್ ಪರಿಶೀಲಿಸಿ (Jellyfin ಸಾಮಾನ್ಯವಾಗಿ 8096 ಬಳಸುತ್ತದೆ)."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ആ വിലാസത്തിൽ Jellyfin സെർവറൊന്നും പ്രതികരിച്ചില്ല. വിലാസവും പോർട്ടും പരിശോധിക്കുക (Jellyfin സാധാരണ 8096 ആണ് ഉപയോഗിക്കുന്നത്)."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਉਸ ਪਤੇ 'ਤੇ ਕਿਸੇ Jellyfin ਸਰਵਰ ਨੇ ਜਵਾਬ ਨਹੀਂ ਦਿੱਤਾ। ਪਤਾ ਅਤੇ ਪੋਰਟ ਜਾਂਚੋ (Jellyfin ਆਮ ਤੌਰ 'ਤੇ 8096 ਵਰਤਦਾ ਹੈ)।"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ସେହି ଠିକଣାରେ କୌଣସି Jellyfin ସର୍ଭର ଉତ୍ତର ଦେଲା ନାହିଁ। ଠିକଣା ଓ ପୋର୍ଟ ଯାଞ୍ଚ କରନ୍ତୁ (Jellyfin ସାଧାରଣତଃ 8096 ବ୍ୟବହାର କରେ)।"
          }
        }
      }
    },
