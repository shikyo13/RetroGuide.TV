    "Pin one channel to stop automatic rotation." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fija un canal para detener la rotación automática."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixe um canal para parar o rodízio automático."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Épinglez une chaîne pour arrêter la rotation automatique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fissa un canale per fermare la rotazione automatica."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixiere einen Kanal, um den automatischen Wechsel zu stoppen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet één zender vast om automatisch wisselen te stoppen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fäst en kanal för att stoppa automatisk rotation."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przypnij jeden kanał, aby zatrzymać automatyczną rotację."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Připni jeden kanál a automatické střídání se zastaví."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закрепите один канал, чтобы отключить автоматическую смену."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1つのチャンネルを固定して、自動切り替えを止めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "채널 하나를 고정하여 자동 순환을 멈춥니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "固定一个频道以停止自动轮换。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "固定一個頻道以停止自動輪替。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने-आप बदलना रोकने के लिए एक चैनल पिन करें।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "স্বয়ংক্রিয় ঘোরানো বন্ধ করতে একটি চ্যানেল পিন করুন।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपोआप बदलणे थांबवण्यासाठी एक चॅनेल पिन करा."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "தானியங்குச் சுழற்சியை நிறுத்த ஒரு சேனலைப் பின் செய்யவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఆటోమేటిక్ రొటేషన్ ఆపడానికి ఒక ఛానెల్‌ను పిన్ చేయండి."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ઑટોમેટિક રોટેશન બંધ કરવા એક ચેનલ પિન કરો."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಸ್ವಯಂಚಾಲಿತ ಸರದಿ ನಿಲ್ಲಿಸಲು ಒಂದು ಚಾನಲ್ ಪಿನ್ ಮಾಡಿ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "സ്വയം മാറുന്നത് നിർത്താൻ ഒരു ചാനൽ പിൻ ചെയ്യുക."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਆਪਣੇ-ਆਪ ਬਦਲਣਾ ਰੋਕਣ ਲਈ ਇੱਕ ਚੈਨਲ ਪਿੰਨ ਕਰੋ।"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ସ୍ୱୟଂଚାଳିତ ପରିବର୍ତ୍ତନ ବନ୍ଦ କରିବାକୁ ଗୋଟିଏ ଚ୍ୟାନେଲ ପିନ୍ କରନ୍ତୁ।"
          }
        }
      }
    },
    "Play clips from a separate commercial library between programs. Shows and movies play without interruptions." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduce clips de una biblioteca de anuncios aparte entre programas. Las series y películas se reproducen sin interrupciones."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passe clipes de uma biblioteca de comerciais separada entre os programas. Séries e filmes passam sem interrupções."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diffusez des spots d'une bibliothèque de pubs distincte entre les programmes. Les séries et films sont diffusés sans interruption."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trasmetti spot da una libreria di pubblicità separata tra un programma e l'altro. Serie e film vanno in onda senza interruzioni."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spiele Clips aus einer separaten Werbebibliothek zwischen Sendungen ab. Serien und Filme laufen ohne Unterbrechung."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speel clips uit een aparte reclamebibliotheek af tussen programma’s. Series en films worden zonder onderbreking afgespeeld."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spela klipp från ett separat reklambibliotek mellan programmen. Serier och filmer spelas utan avbrott."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odtwarzaj klipy z osobnej biblioteki reklam między programami. Seriale i filmy lecą bez przerw."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mezi pořady přehrávej klipy ze samostatné knihovny reklam. Pořady a filmy běží bez přerušení."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывать ролики из отдельной медиатеки рекламы между передачами. Сериалы и фильмы идут без перерывов."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "番組の合間に、別のCMライブラリのクリップを再生します。番組や映画の途中で中断されることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로그램 사이에 별도 광고 라이브러리의 클립을 재생합니다. 프로그램과 영화는 중간에 끊기지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在节目之间播放独立广告片媒体库中的片段。剧集和电影播放时不会被打断。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在節目之間播放獨立廣告片媒體庫中的片段。影集和電影播放時不會被打斷。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रोग्राम के बीच एक अलग विज्ञापन लाइब्रेरी से क्लिप चलाएँ। शो और फ़िल्में बिना रुकावट चलते हैं।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অনুষ্ঠানের মাঝে আলাদা বিজ্ঞাপন লাইব্রেরি থেকে ক্লিপ চালান। শো ও সিনেমা বিনা বাধায় চলে।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कार्यक्रमांदरम्यान वेगळ्या जाहिरात लायब्ररीतील क्लिप प्ले करा. शो आणि चित्रपट विनाव्यत्यय प्ले होतात."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நிகழ்ச்சிகளுக்கு இடையே தனி விளம்பர லைப்ரரியிலிருந்து கிளிப்களை இயக்கும். நிகழ்ச்சிகளும் படங்களும் இடையூறின்றி இயங்கும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ప్రోగ్రామ్‌ల మధ్య ప్రత్యేక కమర్షియల్ లైబ్రరీ నుండి క్లిప్‌లను ప్లే చేయండి. షోలు, సినిమాలు అంతరాయం లేకుండా ప్లే అవుతాయి."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "પ્રોગ્રામ વચ્ચે અલગ જાહેરાત લાઇબ્રેરીમાંથી ક્લિપ્સ ચલાવો. શો અને ફિલ્મો કોઈ વિક્ષેપ વિના ચાલે છે."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಕಾರ್ಯಕ್ರಮಗಳ ನಡುವೆ ಪ್ರತ್ಯೇಕ ಜಾಹೀರಾತು ಲೈಬ್ರರಿಯ ಕ್ಲಿಪ್‌ಗಳನ್ನು ಪ್ಲೇ ಮಾಡಿ. ಶೋಗಳು ಮತ್ತು ಸಿನಿಮಾಗಳು ಅಡಚಣೆಯಿಲ್ಲದೆ ಪ್ಲೇ ಆಗುತ್ತವೆ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "പരിപാടികൾക്കിടയിൽ പ്രത്യേക പരസ്യ ലൈബ്രറിയിൽ നിന്നുള്ള ക്ലിപ്പുകൾ പ്ലേ ചെയ്യുക. ഷോകളും സിനിമകളും തടസ്സമില്ലാതെ പ്ലേ ചെയ്യും."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਪ੍ਰੋਗਰਾਮਾਂ ਵਿਚਕਾਰ ਵੱਖਰੀ ਕਮਰਸ਼ੀਅਲ ਲਾਇਬ੍ਰੇਰੀ ਦੀਆਂ ਕਲਿੱਪਾਂ ਚਲਾਓ। ਸ਼ੋਅ ਅਤੇ ਫ਼ਿਲਮਾਂ ਬਿਨਾਂ ਰੁਕਾਵਟ ਚੱਲਦੇ ਹਨ।"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "କାର୍ଯ୍ୟକ୍ରମ ମଝିରେ ଏକ ଅଲଗା ବିଜ୍ଞାପନ ଲାଇବ୍ରେରୀରୁ କ୍ଲିପ୍ ଚଲାନ୍ତୁ। ଶୋ ଓ ସିନେମା ବିନା ବାଧାରେ ଚାଲେ।"
          }
        }
      }
    },
