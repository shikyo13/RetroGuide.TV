          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "承認を待っています。購入が完了するとすぐにProが使えるようになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "승인을 기다리는 중입니다. 구입이 완료되면 바로 Pro가 잠금 해제됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在等待批准。购买完成后会立即解锁 Pro。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在等待核准。購買完成後會立即解鎖 Pro。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मंज़ूरी का इंतज़ार है। ख़रीदारी पूरी होते ही Pro अनलॉक हो जाएगा।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অনুমোদনের অপেক্ষায়। কেনাকাটা সম্পন্ন হলেই Pro আনলক হবে।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मंजुरीची वाट पाहत आहे. खरेदी पूर्ण होताच Pro अनलॉक होईल."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஒப்புதலுக்குக் காத்திருக்கிறது. வாங்குதல் நிறைவடைந்ததும் Pro திறக்கப்படும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఆమోదం కోసం వేచి ఉంది. కొనుగోలు పూర్తయిన వెంటనే Pro అన్‌లాక్ అవుతుంది."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "મંજૂરીની રાહ જોઈ રહ્યાં છીએ. ખરીદી પૂરી થતાં જ Pro અનલૉક થશે."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಅನುಮೋದನೆಗಾಗಿ ಕಾಯಲಾಗುತ್ತಿದೆ. ಖರೀದಿ ಪೂರ್ಣಗೊಂಡ ತಕ್ಷಣ Pro ಅನ್‌ಲಾಕ್ ಆಗುತ್ತದೆ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "അനുമതിക്കായി കാത്തിരിക്കുന്നു. വാങ്ങൽ പൂർത്തിയായാലുടൻ Pro അൺലോക്ക് ആകും."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਮਨਜ਼ੂਰੀ ਦੀ ਉਡੀਕ ਹੈ। ਖ਼ਰੀਦ ਪੂਰੀ ਹੁੰਦੇ ਹੀ Pro ਅਨਲੌਕ ਹੋ ਜਾਵੇਗਾ।"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଅନୁମୋଦନ ଅପେକ୍ଷାରେ। କ୍ରୟ ସମ୍ପୂର୍ଣ୍ଣ ହେବା ମାତ୍ରେ Pro ଅନଲକ୍ ହେବ।"
          }
        }
      }
    },
