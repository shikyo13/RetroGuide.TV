        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法从此处连接 %@。如需在外出时观看，请添加外出地址。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法從這裡連線到 %@。若要在外出時觀看，請加入外出位址。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यहाँ से %@ तक नहीं पहुँच पा रहे। घर से बाहर देखने के लिए, बाहर का पता जोड़ें।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এখান থেকে %@-এ পৌঁছানো যাচ্ছে না। বাড়ির বাইরে দেখতে, একটি বাইরের ঠিকানা যোগ করুন।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "येथून %@ शी संपर्क होत नाही. घराबाहेरून पाहण्यासाठी, बाहेरचा पत्ता जोडा."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இங்கிருந்து %@-ஐ அணுக முடியவில்லை. வீட்டுக்கு வெளியே பார்க்க, வெளி முகவரியைச் சேர்க்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఇక్కడి నుండి %@ను చేరుకోలేకపోతున్నాము. ఇంటి బయట చూడటానికి, బయటి అడ్రస్‌ను జోడించండి."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "અહીંથી %@ સુધી પહોંચી શકાતું નથી. ઘરથી દૂર જોવા માટે, બહારનું સરનામું ઉમેરો."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಇಲ್ಲಿಂದ %@ ತಲುಪಲು ಸಾಧ್ಯವಾಗುತ್ತಿಲ್ಲ. ಮನೆಯಿಂದ ಹೊರಗೆ ವೀಕ್ಷಿಸಲು, ಹೊರಗಿನ ವಿಳಾಸವನ್ನು ಸೇರಿಸಿ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഇവിടെ നിന്ന് %@-ൽ എത്താനാകുന്നില്ല. വീടിന് പുറത്ത് കാണാൻ, ഒരു പുറത്തെ വിലാസം ചേർക്കുക."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਇੱਥੋਂ %@ ਤੱਕ ਨਹੀਂ ਪਹੁੰਚ ਸਕਦੇ। ਘਰ ਤੋਂ ਬਾਹਰ ਦੇਖਣ ਲਈ, ਬਾਹਰ ਵਾਲਾ ਪਤਾ ਸ਼ਾਮਲ ਕਰੋ।"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଏଠାରୁ %@ ସହ ସଂଯୋଗ ହେଉନାହିଁ। ଘର ବାହାରେ ଦେଖିବାକୁ, ଏକ ବାହାର ଠିକଣା ଯୋଗ କରନ୍ତୁ।"
