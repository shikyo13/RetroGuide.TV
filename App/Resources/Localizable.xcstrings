    "Parental controls could not be read. Try reopening the app after unlocking this device." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron leer los controles parentales. Vuelve a abrir la app después de desbloquear este dispositivo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ler o controle parental. Tente reabrir o app depois de desbloquear este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de lire le contrôle parental. Rouvrez l'app après avoir déverrouillé cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile leggere il controllo parentale. Prova a riaprire l'app dopo aver sbloccato questo dispositivo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kindersicherung konnte nicht gelesen werden. Öffne die App erneut, nachdem du dieses Gerät entsperrt hast."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouderlijk toezicht kon niet worden gelezen. Open de app opnieuw nadat je dit apparaat hebt ontgrendeld."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Föräldrakontrollen kunde inte läsas. Försök öppna appen igen efter att du har låst upp enheten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można odczytać kontroli rodzicielskiej. Spróbuj ponownie otworzyć aplikację po odblokowaniu urządzenia."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rodičovskou kontrolu nelze načíst. Odemkni zařízení a zkus aplikaci otevřít znovu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось прочитать настройки родительского контроля. Разблокируйте устройство и снова откройте приложение."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ペアレンタルコントロールを読み込めませんでした。このデバイスのロックを解除してから、Appを開き直してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자녀 보호 기능을 읽을 수 없습니다. 이 기기의 잠금을 해제한 후 앱을 다시 열어 보십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取家长控制。请解锁此设备后重新打开 App。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法讀取家長監護設定。請解鎖此裝置後重新打開 App。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पेरेंटल कंट्रोल पढ़े नहीं जा सके। इस डिवाइस को अनलॉक करने के बाद ऐप फिर से खोलकर देखें।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্যারেন্টাল কন্ট্রোল পড়া যায়নি। এই ডিভাইস আনলক করার পর অ্যাপটি আবার খুলে দেখুন।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पालक नियंत्रणे वाचता आली नाहीत. हे डिव्हाइस अनलॉक केल्यानंतर ॲप पुन्हा उघडून पाहा."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பெற்றோர் கட்டுப்பாடுகளைப் படிக்க முடியவில்லை. இந்தச் சாதனத்தைத் திறந்த பிறகு ஆப்பை மீண்டும் திறந்து பார்க்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "పేరెంటల్ కంట్రోల్స్‌ను చదవలేకపోయాము. ఈ పరికరాన్ని అన్‌లాక్ చేసిన తర్వాత యాప్‌ను మళ్లీ తెరిచి చూడండి."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "પેરેન્ટલ કંટ્રોલ વાંચી શકાયાં નહીં. આ ડિવાઇસ અનલૉક કર્યા પછી ઍપ ફરી ખોલી જુઓ."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಪೋಷಕರ ನಿಯಂತ್ರಣಗಳನ್ನು ಓದಲಾಗಲಿಲ್ಲ. ಈ ಸಾಧನವನ್ನು ಅನ್‌ಲಾಕ್ ಮಾಡಿದ ನಂತರ ಆ್ಯಪ್ ಅನ್ನು ಮತ್ತೆ ತೆರೆದು ನೋಡಿ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "രക്ഷാകർതൃ നിയന്ത്രണങ്ങൾ വായിക്കാനായില്ല. ഈ ഉപകരണം അൺലോക്ക് ചെയ്ത ശേഷം ആപ്പ് വീണ്ടും തുറന്നുനോക്കുക."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਪੇਰੈਂਟਲ ਕੰਟਰੋਲ ਪੜ੍ਹੇ ਨਹੀਂ ਜਾ ਸਕੇ। ਇਸ ਡਿਵਾਈਸ ਨੂੰ ਅਨਲੌਕ ਕਰਨ ਤੋਂ ਬਾਅਦ ਐਪ ਦੁਬਾਰਾ ਖੋਲ੍ਹ ਕੇ ਦੇਖੋ।"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଅଭିଭାବକ ନିୟନ୍ତ୍ରଣ ପଢ଼ାଯାଇପାରିଲା ନାହିଁ। ଏହି ଡିଭାଇସ୍ ଅନଲକ୍ କରିବା ପରେ ଆପ୍ ପୁଣି ଖୋଲି ଦେଖନ୍ତୁ।"
          }
        }
      }
    },
    "Parental restrictions and the curated parental lineup are available for review in Parental Controls. Save them there to apply them on this device. Sync never changes a PIN or turns the parental lock on or off." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las restricciones parentales y la lista de canales parental están listas para revisar en Controles parentales. Guárdalas allí para aplicarlas en este dispositivo. La sincronización nunca cambia un PIN ni activa o desactiva el bloqueo parental."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As restrições parentais e a grade parental estão disponíveis para revisão em Controle parental. Salve-as lá para aplicá-las neste dispositivo. A sincronização nunca altera um PIN nem ativa ou desativa o bloqueio parental."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les restrictions parentales et le bouquet parental sont à vérifier dans Contrôle parental. Enregistrez-les là pour les appliquer sur cet appareil. La synchro ne change jamais un code et n'active ni ne désactive jamais le verrou parental."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le restrizioni parentali e la lista canali parentale curata sono da verificare in Controllo parentale. Salvale lì per applicarle su questo dispositivo. La sincronizzazione non cambia mai il PIN e non attiva né disattiva mai il blocco parentale."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einschränkungen der Kindersicherung und die kuratierte Kanalliste der Kindersicherung kannst du unter „Kindersicherung“ prüfen. Speichere sie dort, um sie auf diesem Gerät anzuwenden. Die Synchronisierung ändert nie eine PIN und schaltet die Kindersicherung nie ein oder aus."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beperkingen van ouderlijk toezicht en de samengestelde zenderlijst voor ouderlijk toezicht kun je controleren bij ‘Ouderlijk toezicht’. Bewaar ze daar om ze op dit apparaat toe te passen. Synchronisatie wijzigt nooit een pincode en zet ouderlijk toezicht nooit aan of uit."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Föräldrabegränsningar och det kurerade föräldrautbudet kan granskas i Föräldrakontroll. Spara dem där för att tillämpa dem på den här enheten. Synkningen ändrar aldrig en PIN-kod och slår aldrig på eller av föräldralåset."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ograniczenia rodzicielskie i wyselekcjonowany zestaw rodzicielski możesz przejrzeć w Kontroli rodzicielskiej. Zapisz je tam, aby obowiązywały na tym urządzeniu. Synchronizacja nigdy nie zmienia PIN-u ani nie włącza czy wyłącza blokady rodzicielskiej."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rodičovská omezení a sestavenou rodičovskou nabídku můžeš zkontrolovat v Rodičovské kontrole. Uložením tam je použiješ v tomto zařízení. Synchronizace nikdy nemění PIN ani nezapíná či nevypíná rodičovský zámek."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Родительские ограничения и подобранный список каналов родительского контроля можно проверить в разделе «Родительский контроль». Сохраните их там, чтобы применить на этом устройстве. Синхронизация никогда не меняет PIN-код и не включает и не выключает родительскую блокировку."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ペアレンタル制限と厳選されたペアレンタル用ラインナップは、「ペアレンタルコントロール」で確認できます。このデバイスに適用するには、そこで保存してください。同期によってPINが変更されたり、ペアレンタルロックのオン/オフが切り替わったりすることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자녀 보호 제한과 엄선된 자녀 보호 라인업은 자녀 보호 기능에서 검토할 수 있습니다. 이 기기에 적용하려면 그곳에서 저장하십시오. 동기화로 PIN이 변경되거나 자녀 보호 잠금이 켜지거나 꺼지지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可在“家长控制”中审核家长限制和精选家长频道阵容。在那里存储后才会在此设备上生效。同步绝不会更改 PIN 码，也不会打开或关闭家长锁。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可在「家長監護」中檢閱家長限制和精選家長頻道陣容。在那裡儲存後才會在此裝置上生效。同步絕不會更改 PIN 碼，也不會開啟或關閉家長鎖。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पेरेंटल पाबंदियाँ और चुना हुआ पेरेंटल लाइनअप, पेरेंटल कंट्रोल में समीक्षा के लिए उपलब्ध हैं। इस डिवाइस पर लागू करने के लिए उन्हें वहाँ सेव करें। सिंक कभी PIN नहीं बदलता और न ही पेरेंटल लॉक चालू या बंद करता है।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্যারেন্টাল বিধিনিষেধ ও বাছাই করা প্যারেন্টাল লাইনআপ প্যারেন্টাল কন্ট্রোলে পর্যালোচনার জন্য আছে। এই ডিভাইসে প্রয়োগ করতে সেখানে সেভ করুন। সিঙ্ক কখনো PIN বদলায় না, প্যারেন্টাল লক চালু বা বন্ধও করে না।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पालक निर्बंध आणि निवडक पालक यादी पालक नियंत्रणांमध्ये पुनरावलोकनासाठी उपलब्ध आहेत. या डिव्हाइसवर लागू करण्यासाठी त्या तेथे सेव्ह करा. सिंकमुळे PIN कधीही बदलत नाही आणि पालक लॉक सुरू किंवा बंद होत नाही."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பெற்றோர் கட்டுப்பாடுகளும் தேர்ந்தெடுத்த பெற்றோர் வரிசையும் ‘பெற்றோர் கட்டுப்பாடுகள்’ என்பதில் மதிப்பாய்வுக்கு உள்ளன. இந்தச் சாதனத்தில் பயன்படுத்த, அவற்றை அங்கே சேமிக்கவும். ஒத்திசைவு ஒருபோதும் PIN-ஐ மாற்றாது, பெற்றோர் பூட்டை இயக்கவோ முடக்கவோ செய்யாது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "పేరెంటల్ పరిమితులు, క్యూరేటెడ్ పేరెంటల్ లైనప్ పేరెంటల్ కంట్రోల్స్‌లో సమీక్షకు అందుబాటులో ఉన్నాయి. ఈ పరికరంలో వర్తింపజేయడానికి వాటిని అక్కడ సేవ్ చేయండి. సింక్ ఎప్పుడూ PINను మార్చదు, పేరెంటల్ లాక్‌ను ఆన్ లేదా ఆఫ్ చేయదు."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "પેરેન્ટલ પ્રતિબંધો અને ખાસ પસંદ કરેલું પેરેન્ટલ લાઇનઅપ પેરેન્ટલ કંટ્રોલમાં સમીક્ષા માટે ઉપલબ્ધ છે. આ ડિવાઇસ પર લાગુ કરવા ત્યાં સાચવો. સિંક ક્યારેય PIN બદલતું નથી કે પેરેન્ટલ લૉક ચાલુ કે બંધ કરતું નથી."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಪೋಷಕರ ನಿರ್ಬಂಧಗಳು ಮತ್ತು ಆಯ್ದ ಪೋಷಕರ ಚಾನಲ್ ಪಟ್ಟಿ ಪೋಷಕರ ನಿಯಂತ್ರಣಗಳಲ್ಲಿ ಪರಿಶೀಲನೆಗೆ ಲಭ್ಯವಿವೆ. ಈ ಸಾಧನದಲ್ಲಿ ಅನ್ವಯಿಸಲು ಅವುಗಳನ್ನು ಅಲ್ಲಿ ಸೇವ್ ಮಾಡಿ. ಸಿಂಕ್ ಎಂದಿಗೂ PIN ಬದಲಿಸುವುದಿಲ್ಲ ಅಥವಾ ಪೋಷಕರ ಲಾಕ್ ಅನ್ನು ಆನ್ ಅಥವಾ ಆಫ್ ಮಾಡುವುದಿಲ್ಲ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "രക്ഷാകർതൃ നിയന്ത്രണങ്ങളും തിരഞ്ഞെടുത്ത രക്ഷാകർതൃ ചാനൽ നിരയും രക്ഷാകർതൃ നിയന്ത്രണങ്ങളിൽ പരിശോധിക്കാം. ഈ ഉപകരണത്തിൽ ബാധകമാക്കാൻ അവിടെ സേവ് ചെയ്യുക. സമന്വയം ഒരിക്കലും PIN മാറ്റുകയോ രക്ഷാകർതൃ ലോക്ക് ഓണാക്കുകയോ ഓഫാക്കുകയോ ചെയ്യില്ല."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਪੇਰੈਂਟਲ ਪਾਬੰਦੀਆਂ ਅਤੇ ਚੁਣਿਆ ਹੋਇਆ ਪੇਰੈਂਟਲ ਲਾਈਨਅੱਪ ਪੇਰੈਂਟਲ ਕੰਟਰੋਲ ਵਿੱਚ ਸਮੀਖਿਆ ਲਈ ਉਪਲਬਧ ਹਨ। ਇਸ ਡਿਵਾਈਸ 'ਤੇ ਲਾਗੂ ਕਰਨ ਲਈ ਉਹਨਾਂ ਨੂੰ ਉੱਥੇ ਸੇਵ ਕਰੋ। ਸਿੰਕ ਕਦੇ ਵੀ PIN ਨਹੀਂ ਬਦਲਦਾ ਅਤੇ ਨਾ ਹੀ ਪੇਰੈਂਟਲ ਲੌਕ ਚਾਲੂ ਜਾਂ ਬੰਦ ਕਰਦਾ ਹੈ।"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଅଭିଭାବକ ପ୍ରତିବନ୍ଧ ଓ ବଛା ଅଭିଭାବକ ଚ୍ୟାନେଲ ତାଲିକା ଅଭିଭାବକ ନିୟନ୍ତ୍ରଣରେ ସମୀକ୍ଷା ପାଇଁ ଉପଲବ୍ଧ। ଏହି ଡିଭାଇସରେ ଲାଗୁ କରିବାକୁ ସେଠାରେ ସେଭ୍ କରନ୍ତୁ। ସିଙ୍କ କେବେ ବି PIN ବଦଳାଏ ନାହିଁ କିମ୍ବା ଅଭିଭାବକ ଲକ୍ ଚାଲୁ ବା ବନ୍ଦ କରେ ନାହିଁ।"
          }
        }
      }
    },
