    "Left and Right move subtitles earlier or later. Select restores the original timing." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izquierda y derecha adelantan o atrasan los subtítulos. Seleccionar restaura la sincronía original."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esquerda e direita adiantam ou atrasam as legendas. Selecionar restaura a sincronia original."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gauche et droite avancent ou retardent les sous-titres. Sélectionner rétablit le minutage d'origine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinistra e destra anticipano o ritardano i sottotitoli. Seleziona ripristina i tempi originali."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Links und Rechts lässt du Untertitel früher oder später erscheinen. Mit Auswählen stellst du das ursprüngliche Timing wieder her."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met links en rechts zet je ondertitels eerder of later. Met Selecteer herstel je de oorspronkelijke timing."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vänster och höger flyttar undertexterna tidigare eller senare. Ett klick återställer den ursprungliga timingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W lewo i w prawo przesuwasz napisy wcześniej lub później. Kliknięcie przywraca oryginalny czas."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vlevo a vpravo posouvá titulky dříve nebo později. Výběr obnoví původní časování."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Влево и вправо сдвигают субтитры раньше или позже. Выбор восстанавливает исходную синхронизацию."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "左右で字幕のタイミングを前後に移動します。選択ボタンを押すと元のタイミングに戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "왼쪽과 오른쪽으로 자막을 앞뒤로 이동합니다. 선택 버튼을 누르면 원래 타이밍으로 돌아갑니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按左或右可将字幕提前或延后。按选择键可恢复原始时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按左或右可將字幕提早或延後。按選取鍵可回復原始時間。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बाएँ और दाएँ से सबटाइटल पहले या बाद में होते हैं। सिलेक्ट दबाने पर ओरिजिनल टाइमिंग वापस आती है।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বাঁয়ে ও ডানে চাপলে সাবটাইটেল আগে বা পরে সরে। সিলেক্ট চাপলে আসল টাইমিং ফিরে আসে।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डावीकडे आणि उजवीकडे केल्याने सबटायटल्स आधी किंवा नंतर सरकतात. सिलेक्ट केल्याने मूळ वेळ परत येते."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இடது, வலது சப்டைட்டில்களை முன்னதாக அல்லது தாமதமாக நகர்த்தும். தேர்வு பொத்தான் அசல் நேரத்தை மீட்டமைக்கும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఎడమ, కుడి బటన్‌లు సబ్‌టైటిల్‌లను ముందుకు లేదా ఆలస్యానికి జరుపుతాయి. సెలెక్ట్ అసలు టైమింగ్‌ను పునరుద్ధరిస్తుంది."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ડાબે અને જમણે સબટાઇટલને પહેલાં કે પછી ખસેડે છે. સિલેક્ટ દબાવવાથી મૂળ ટાઇમિંગ પાછું આવે છે."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಎಡ ಮತ್ತು ಬಲ ಬಟನ್‌ಗಳು ಉಪಶೀರ್ಷಿಕೆಗಳನ್ನು ಮೊದಲು ಅಥವಾ ತಡವಾಗಿ ಸರಿಸುತ್ತವೆ. ಸೆಲೆಕ್ಟ್ ಒತ್ತಿದರೆ ಮೂಲ ಸಮಯ ಮರಳುತ್ತದೆ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഇടത്തും വലത്തും സബ്ടൈറ്റിലുകൾ മുമ്പോട്ടോ പിന്നോട്ടോ നീക്കുന്നു. സെലക്റ്റ് യഥാർഥ സമയം പുനഃസ്ഥാപിക്കുന്നു."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਖੱਬਾ ਅਤੇ ਸੱਜਾ ਸਬਟਾਈਟਲਾਂ ਨੂੰ ਪਹਿਲਾਂ ਜਾਂ ਬਾਅਦ ਵਿੱਚ ਕਰਦੇ ਹਨ। ਚੁਣੋ ਦਬਾਉਣ ਨਾਲ ਅਸਲ ਟਾਈਮਿੰਗ ਬਹਾਲ ਹੁੰਦੀ ਹੈ।"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ବାମ ଓ ଡାହାଣ ସବଟାଇଟଲ୍‌କୁ ଆଗୁଆ ବା ବିଳମ୍ବ କରେ। ସିଲେକ୍ଟ ଦବାଇଲେ ମୂଳ ସମୟ ଫେରେ।"
          }
        }
      }
    },
