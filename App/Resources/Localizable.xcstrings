    "Or publish the server with HTTPS and a domain name." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O publica el servidor con HTTPS y un nombre de dominio."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou publique o servidor com HTTPS e um nome de domínio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou publiez le serveur avec HTTPS et un nom de domaine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oppure pubblica il server con HTTPS e un nome di dominio."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oder stelle den Server mit HTTPS und einem Domainnamen bereit."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Of publiceer de server met HTTPS en een domeinnaam."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eller publicera servern med HTTPS och ett domännamn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Możesz też udostępnić serwer przez HTTPS z nazwą domeny."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nebo server zveřejni přes HTTPS s názvem domény."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Или откройте доступ к серверу через HTTPS с доменным именем."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "または、HTTPSとドメイン名でサーバを公開してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "또는 HTTPS와 도메인 이름으로 서버를 공개하십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "或使用 HTTPS 和域名发布服务器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "或以 HTTPS 和網域名稱發佈伺服器。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "या सर्वर को HTTPS और डोमेन नेम के साथ पब्लिश करें।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অথবা HTTPS ও একটি ডোমেন নেম দিয়ে সার্ভারটি পাবলিশ করুন।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किंवा सर्व्हर HTTPS आणि डोमेन नावासह प्रकाशित करा."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "அல்லது HTTPS, டொமைன் பெயருடன் சர்வரை வெளியிடவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "లేదా సర్వర్‌ను HTTPS, డొమైన్ నేమ్‌తో పబ్లిష్ చేయండి."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "અથવા HTTPS અને ડોમેન નામ સાથે સર્વર પબ્લિશ કરો."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಅಥವಾ HTTPS ಮತ್ತು ಡೊಮೇನ್ ಹೆಸರಿನೊಂದಿಗೆ ಸರ್ವರ್ ಅನ್ನು ಪ್ರಕಟಿಸಿ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "അല്ലെങ്കിൽ HTTPS-ഉം ഡൊമെയ്ൻ നെയിമും ഉപയോഗിച്ച് സെർവർ പ്രസിദ്ധീകരിക്കുക."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਜਾਂ ਸਰਵਰ ਨੂੰ HTTPS ਅਤੇ ਡੋਮੇਨ ਨਾਂ ਨਾਲ ਪ੍ਰਕਾਸ਼ਿਤ ਕਰੋ।"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "କିମ୍ବା HTTPS ଓ ଏକ ଡୋମେନ୍ ନାମ ସହ ସର୍ଭରକୁ ପ୍ରକାଶ କରନ୍ତୁ।"
          }
        }
      }
    },
