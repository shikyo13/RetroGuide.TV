          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前回の起動が完了しませんでした。もう一度試す前に、ライブラリを変更したりサーバを削除したりできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이전 시작이 완료되지 않았습니다. 다시 시도하기 전에 라이브러리를 변경하거나 서버를 제거할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
