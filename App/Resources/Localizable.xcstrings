        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 同步无法完成。你的更改已保存在此设备上。请稍后再试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 同步無法完成。你的變更已儲存在此裝置上。請稍後再試。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud सिंक पूरा नहीं हो सका। आपके बदलाव इस डिवाइस पर सेव हैं। बाद में दोबारा कोशिश करें।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud সিঙ্ক শেষ করা যায়নি। আপনার পরিবর্তন এই ডিভাইসে সেভ করা আছে। পরে আবার চেষ্টা করুন।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud सिंक पूर्ण होऊ शकले नाही. तुमचे बदल या डिव्हाइसवर सेव्ह आहेत. नंतर पुन्हा प्रयत्न करा."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud ஒத்திசைவை முடிக்க முடியவில்லை. உங்கள் மாற்றங்கள் இந்தச் சாதனத்தில் சேமிக்கப்பட்டுள்ளன. பின்னர் மீண்டும் முயலவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud సింక్ పూర్తి కాలేదు. మీ మార్పులు ఈ పరికరంలో సేవ్ అయ్యాయి. తర్వాత మళ్లీ ప్రయత్నించండి."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud સિંક પૂરું થઈ શક્યું નહીં. તમારા ફેરફારો આ ડિવાઇસ પર સચવાયા છે. પછીથી ફરી પ્રયાસ કરો."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud ಸಿಂಕ್ ಪೂರ್ಣಗೊಳ್ಳಲಿಲ್ಲ. ನಿಮ್ಮ ಬದಲಾವಣೆಗಳು ಈ ಸಾಧನದಲ್ಲಿ ಸೇವ್ ಆಗಿವೆ. ನಂತರ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud സമന്വയം പൂർത്തിയാക്കാനായില്ല. നിങ്ങളുടെ മാറ്റങ്ങൾ ഈ ഉപകരണത്തിൽ സേവ് ചെയ്തിട്ടുണ്ട്. പിന്നീട് വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud ਸਿੰਕ ਪੂਰਾ ਨਹੀਂ ਹੋ ਸਕਿਆ। ਤੁਹਾਡੇ ਬਦਲਾਅ ਇਸ ਡਿਵਾਈਸ 'ਤੇ ਸੇਵ ਹਨ। ਬਾਅਦ ਵਿੱਚ ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud ସିଙ୍କ ଶେଷ ହୋଇପାରିଲା ନାହିଁ। ଆପଣଙ୍କ ପରିବର୍ତ୍ତନ ଏହି ଡିଭାଇସରେ ସେଭ୍ ଅଛି। ପରେ ପୁଣି ଚେଷ୍ଟା କରନ୍ତୁ।"
          }
        }
      }
    },
