    "Settings are waiting for setup or a library refresh to finish. If parental settings are locked, unlock them to apply changes." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los cambios esperan a que termine la configuración inicial o la actualización de una biblioteca. Si los controles parentales están bloqueados, desbloquéalos para aplicar los cambios."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os ajustes estão aguardando a configuração inicial ou a atualização de uma biblioteca terminar. Se o controle parental estiver bloqueado, desbloqueie-o para aplicar as alterações."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les réglages attendent la fin de la configuration ou de l'actualisation d'une bibliothèque. Si le contrôle parental est verrouillé, déverrouillez-le pour appliquer les modifications."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le impostazioni attendono la fine della configurazione o dell'aggiornamento di una libreria. Se le impostazioni parentali sono bloccate, sbloccale per applicare le modifiche."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Einstellungen warten auf den Abschluss der Einrichtung oder einer Bibliotheksaktualisierung. Wenn die Einstellungen der Kindersicherung gesperrt sind, entsperre sie, um Änderungen anzuwenden."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instellingen wachten tot de configuratie of een bibliotheekvernieuwing klaar is. Als de instellingen voor ouderlijk toezicht vergrendeld zijn, ontgrendel ze dan om wijzigingen toe te passen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inställningarna väntar på att konfigurationen eller en biblioteksuppdatering ska bli klar. Om föräldrainställningarna är låsta låser du upp dem för att tillämpa ändringar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustawienia czekają na zakończenie konfiguracji lub odświeżania biblioteki. Jeśli ustawienia rodzicielskie są zablokowane, odblokuj je, aby zastosować zmiany."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavení čeká na dokončení nastavování nebo obnovení knihovny. Pokud je rodičovské nastavení zamčené, odemkni ho, aby se změny použily."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройки ждут завершения подготовки или обновления медиатеки. Если настройки родительского контроля заблокированы, разблокируйте их, чтобы применить изменения."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セットアップまたはライブラリの更新が終わると設定が適用されます。ペアレンタル設定がロックされている場合は、ロックを解除して変更を適用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "초기 설정이나 라이브러리 새로 고침이 끝나면 설정이 적용됩니다. 자녀 보호 설정이 잠겨 있으면 잠금을 해제하여 변경 사항을 적용하십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置正在等待初始设置或媒体库刷新完成。如果家长设置已锁定，请解锁以应用更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定正在等待初始設定或媒體庫重新整理完成。如果家長設定已鎖定，請解鎖以套用變更。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सेटिंग्ज़ सेटअप या लाइब्रेरी रीफ़्रेश पूरा होने का इंतज़ार कर रही हैं। अगर पेरेंटल सेटिंग्ज़ लॉक हैं, तो बदलाव लागू करने के लिए उन्हें अनलॉक करें।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সেটিংস সেটআপ বা লাইব্রেরি রিফ্রেশ শেষ হওয়ার অপেক্ষায় আছে। প্যারেন্টাল সেটিংস লক থাকলে, পরিবর্তন প্রয়োগ করতে আনলক করুন।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सेटअप किंवा लायब्ररी रिफ्रेश पूर्ण होण्याची सेटिंग्ज वाट पाहत आहेत. पालक सेटिंग्ज लॉक असल्यास, बदल लागू करण्यासाठी ती अनलॉक करा."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "அமைவு அல்லது லைப்ரரி புதுப்பிப்பு முடியும் வரை அமைப்புகள் காத்திருக்கின்றன. பெற்றோர் அமைப்புகள் பூட்டப்பட்டிருந்தால், மாற்றங்களைப் பயன்படுத்த அவற்றைத் திறக்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "సెటప్ లేదా లైబ్రరీ రిఫ్రెష్ పూర్తయ్యే వరకు సెట్టింగ్‌లు వేచి ఉన్నాయి. పేరెంటల్ సెట్టింగ్‌లు లాక్ అయి ఉంటే, మార్పులు వర్తింపజేయడానికి వాటిని అన్‌లాక్ చేయండి."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "સેટિંગ્સ સેટઅપ કે લાઇબ્રેરી રિફ્રેશ પૂરું થવાની રાહ જુએ છે. જો પેરેન્ટલ સેટિંગ્સ લૉક હોય, તો ફેરફારો લાગુ કરવા તેને અનલૉક કરો."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಸೆಟಪ್ ಅಥವಾ ಲೈಬ್ರರಿ ರಿಫ್ರೆಶ್ ಮುಗಿಯಲು ಸೆಟ್ಟಿಂಗ್‌ಗಳು ಕಾಯುತ್ತಿವೆ. ಪೋಷಕರ ಸೆಟ್ಟಿಂಗ್‌ಗಳು ಲಾಕ್ ಆಗಿದ್ದರೆ, ಬದಲಾವಣೆಗಳನ್ನು ಅನ್ವಯಿಸಲು ಅವುಗಳನ್ನು ಅನ್‌ಲಾಕ್ ಮಾಡಿ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "സജ്ജീകരണമോ ലൈബ്രറി പുതുക്കലോ പൂർത്തിയാകാൻ ക്രമീകരണങ്ങൾ കാത്തിരിക്കുന്നു. രക്ഷാകർതൃ ക്രമീകരണങ്ങൾ ലോക്ക് ചെയ്തിട്ടുണ്ടെങ്കിൽ, മാറ്റങ്ങൾ ബാധകമാക്കാൻ അവ അൺലോക്ക് ചെയ്യുക."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਸੈਟਿੰਗਾਂ ਸੈੱਟਅੱਪ ਜਾਂ ਲਾਇਬ੍ਰੇਰੀ ਤਾਜ਼ਾ ਹੋਣ ਦੇ ਪੂਰਾ ਹੋਣ ਦੀ ਉਡੀਕ ਕਰ ਰਹੀਆਂ ਹਨ। ਜੇ ਪੇਰੈਂਟਲ ਸੈਟਿੰਗਾਂ ਲੌਕ ਹਨ, ਤਾਂ ਬਦਲਾਅ ਲਾਗੂ ਕਰਨ ਲਈ ਉਹਨਾਂ ਨੂੰ ਅਨਲੌਕ ਕਰੋ।"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ସେଟିଂସ୍ ସେଟଅପ୍ ବା ଲାଇବ୍ରେରୀ ରିଫ୍ରେସ୍ ଶେଷ ହେବାକୁ ଅପେକ୍ଷା କରୁଛି। ଅଭିଭାବକ ସେଟିଂସ୍ ଲକ୍ ଥିଲେ, ପରିବର୍ତ୍ତନ ଲାଗୁ କରିବାକୁ ସେଗୁଡ଼ିକୁ ଅନଲକ୍ କରନ୍ତୁ।"
          }
        }
      }
    },
