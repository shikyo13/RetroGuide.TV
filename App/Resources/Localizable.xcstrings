    "Limit content and lock settings on this device." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limita el contenido y bloquea la configuración en este dispositivo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limite o conteúdo e bloqueie os ajustes neste dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limitez le contenu et verrouillez les réglages sur cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limita i contenuti e blocca le impostazioni su questo dispositivo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inhalte einschränken und Einstellungen auf diesem Gerät sperren."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beperk inhoud en vergrendel instellingen op dit apparaat."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begränsa innehåll och lås inställningar på den här enheten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogranicz treści i zablokuj ustawienia na tym urządzeniu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omez obsah a zamkni nastavení v tomto zařízení."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ограничьте контент и заблокируйте настройки на этом устройстве."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスでコンテンツを制限し、設定をロックします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기에서 콘텐츠를 제한하고 설정을 잠급니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在此设备上限制内容并锁定设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在此裝置上限制內容並鎖定設定。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस डिवाइस पर कंटेंट सीमित करें और सेटिंग्ज़ लॉक करें।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই ডিভাইসে কনটেন্ট সীমিত করুন ও সেটিংস লক করুন।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "या डिव्हाइसवर सामग्री मर्यादित करा आणि सेटिंग्ज लॉक करा."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இந்தச் சாதனத்தில் உள்ளடக்கத்தைக் கட்டுப்படுத்தி, அமைப்புகளைப் பூட்டவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఈ పరికరంలో కంటెంట్‌ను పరిమితం చేసి, సెట్టింగ్‌లను లాక్ చేయండి."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આ ડિવાઇસ પર કન્ટેન્ટ મર્યાદિત કરો અને સેટિંગ્સ લૉક કરો."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಈ ಸಾಧನದಲ್ಲಿ ವಿಷಯವನ್ನು ಮಿತಿಗೊಳಿಸಿ ಮತ್ತು ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಲಾಕ್ ಮಾಡಿ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഈ ഉപകരണത്തിൽ ഉള്ളടക്കം പരിമിതപ്പെടുത്തുകയും ക്രമീകരണങ്ങൾ ലോക്ക് ചെയ്യുകയും ചെയ്യുക."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਇਸ ਡਿਵਾਈਸ 'ਤੇ ਸਮੱਗਰੀ ਸੀਮਤ ਕਰੋ ਅਤੇ ਸੈਟਿੰਗਾਂ ਲੌਕ ਕਰੋ।"
          }
