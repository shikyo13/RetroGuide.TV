    "Uses Apple's player. MKV and other formats are converted by your server." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el reproductor de Apple. Tu servidor convierte MKV y otros formatos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa o player da Apple. MKV e outros formatos são convertidos pelo seu servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise le lecteur d'Apple. Les MKV et autres formats sont convertis par votre serveur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa il lettore di Apple. I file MKV e altri formati vengono convertiti dal server."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwendet Apples Player. MKV und andere Formate werden von deinem Server umgewandelt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruikt de speler van Apple. MKV en andere formaten worden door je server omgezet."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Använder Apples spelare. MKV och andra format konverteras av din server."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Używa odtwarzacza Apple. MKV i inne formaty są konwertowane przez serwer."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Používá přehrávač Apple. MKV a další formáty převádí tvůj server."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используется плеер Apple. MKV и другие форматы преобразует ваш сервер."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appleのプレーヤーを使用します。MKVなどの形式はサーバで変換されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 플레이어를 사용합니다. MKV 등의 형식은 서버에서 변환됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 Apple 的播放器。MKV 等格式会由服务器转换。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 Apple 的播放器。MKV 等格式會由伺服器轉換。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple का प्लेयर इस्तेमाल करता है। MKV और दूसरे फ़ॉर्मैट आपका सर्वर कन्वर्ट करता है।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple-এর প্লেয়ার ব্যবহার করে। MKV ও অন্যান্য ফরম্যাট আপনার সার্ভার রূপান্তর করে।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple चा प्लेअर वापरते. MKV आणि इतर फॉरमॅट तुमचा सर्व्हर रूपांतरित करतो."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple-இன் பிளேயரைப் பயன்படுத்தும். MKV, பிற வடிவங்கள் உங்கள் சர்வரால் மாற்றப்படும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple ప్లేయర్‌ను ఉపయోగిస్తుంది. MKV, ఇతర ఫార్మాట్‌లను మీ సర్వర్ కన్వర్ట్ చేస్తుంది."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appleનું પ્લેયર વાપરે છે. MKV અને અન્ય ફૉર્મેટ તમારું સર્વર કન્વર્ટ કરે છે."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple ನ ಪ್ಲೇಯರ್ ಬಳಸುತ್ತದೆ. MKV ಮತ್ತು ಇತರ ಫಾರ್ಮ್ಯಾಟ್‌ಗಳನ್ನು ನಿಮ್ಮ ಸರ್ವರ್ ಪರಿವರ್ತಿಸುತ್ತದೆ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple-ന്റെ പ്ലെയർ ഉപയോഗിക്കുന്നു. MKV-യും മറ്റ് ഫോർമാറ്റുകളും നിങ്ങളുടെ സെർവർ കൺവേർട്ട് ചെയ്യും."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple ਦਾ ਪਲੇਅਰ ਵਰਤਦਾ ਹੈ। MKV ਅਤੇ ਹੋਰ ਫ਼ਾਰਮੈਟ ਤੁਹਾਡਾ ਸਰਵਰ ਕਨਵਰਟ ਕਰਦਾ ਹੈ।"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appleର ପ୍ଲେୟାର୍ ବ୍ୟବହାର କରେ। MKV ଓ ଅନ୍ୟ ଫର୍ମାଟ୍ ଆପଣଙ୍କ ସର୍ଭର କନଭର୍ଟ କରେ।"
          }
        }
      }
    },
