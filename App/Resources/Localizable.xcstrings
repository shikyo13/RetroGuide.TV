    "On %@ · not scheduled in the next two days" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En %@ · sin emisiones en los próximos dos días"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em %@ · sem exibição nos próximos dois dias"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur %@ · pas programmé dans les deux prochains jours"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su %@ · non in programma nei prossimi due giorni"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf %@ · nicht in den nächsten zwei Tagen geplant"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Op %@ · niet gepland in de komende twee dagen"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På %@ · inte schemalagd de närmaste två dagarna"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na kanale %@ · brak emisji w ciągu najbliższych dwóch dni"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na %@ · v příštích dvou dnech se nevysílá"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На канале %@ · не запланировано в ближайшие два дня"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · 今後2日間の放送予定なし"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · 향후 2일간 편성 없음"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 %@ · 未来两天内没有排播"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 %@ · 未來兩天內沒有排播"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ पर · अगले दो दिनों में शेड्यूल नहीं"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@-এ · পরের দুই দিনে শিডিউল নেই"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ वर · पुढील दोन दिवसांत नियोजित नाही"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@-இல் · அடுத்த இரண்டு நாட்களில் அட்டவணையில் இல்லை"
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@లో · రాబోయే రెండు రోజుల్లో షెడ్యూల్ లేదు"
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ પર · આવતા બે દિવસમાં શેડ્યૂલ નથી"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ಚಾನಲ್‌ನಲ್ಲಿ · ಮುಂದಿನ ಎರಡು ದಿನಗಳಲ್ಲಿ ನಿಗದಿಯಾಗಿಲ್ಲ"
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@-ൽ · അടുത്ത രണ്ട് ദിവസം ഷെഡ്യൂൾ ചെയ്തിട്ടില്ല"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 'ਤੇ · ਅਗਲੇ ਦੋ ਦਿਨਾਂ ਵਿੱਚ ਨਿਯਤ ਨਹੀਂ"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ରେ · ଆଗାମୀ ଦୁଇ ଦିନରେ ନିର୍ଦ୍ଧାରିତ ନାହିଁ"
          }
        }
      }
    },
    "On Apple TV, reminders appear while RetroGuide is open. Set reminders on your iPhone or iPad for notifications outside the app." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el Apple TV, los recordatorios aparecen mientras RetroGuide está abierto. Crea recordatorios en tu iPhone o iPad para recibir notificaciones fuera de la app."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na Apple TV, os lembretes aparecem enquanto o RetroGuide está aberto. Crie lembretes no iPhone ou iPad para receber notificações fora do app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur Apple TV, les rappels s'affichent quand RetroGuide est ouvert. Créez des rappels sur votre iPhone ou iPad pour recevoir des notifications hors de l'app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su Apple TV, i promemoria compaiono mentre RetroGuide è aperta. Imposta i promemoria su iPhone o iPad per ricevere notifiche fuori dall'app."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf dem Apple TV erscheinen Erinnerungen, während RetroGuide geöffnet ist. Stelle Erinnerungen auf deinem iPhone oder iPad ein, um auch außerhalb der App Mitteilungen zu erhalten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Op de Apple TV verschijnen herinneringen terwijl RetroGuide open is. Stel herinneringen in op je iPhone of iPad voor meldingen buiten de app."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På Apple TV visas påminnelser medan RetroGuide är öppet. Ställ in påminnelser på din iPhone eller iPad för att få notiser utanför appen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na Apple TV przypomnienia pojawiają się, gdy RetroGuide jest otwarty. Ustaw przypomnienia na iPhonie lub iPadzie, aby dostawać powiadomienia poza aplikacją."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na Apple TV se připomínky zobrazují, když je RetroGuide otevřená. Chceš-li oznámení i mimo aplikaci, nastav připomínky na iPhonu nebo iPadu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На Apple TV напоминания появляются, пока RetroGuide открыт. Чтобы получать уведомления вне приложения, создавайте напоминания на iPhone или iPad."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple TVでは、リマインダーはRetroGuideを開いているときに表示されます。App外で通知を受け取るには、iPhoneまたはiPadでリマインダーを設定してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple TV에서는 RetroGuide가 열려 있을 때 방송 알림이 표시됩니다. 앱 밖에서 알림을 받으려면 iPhone 또는 iPad에서 방송 알림을 설정하십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Apple TV 上，提醒会在 RetroGuide 打开时显示。在 iPhone 或 iPad 上设置提醒，即可在 App 外收到通知。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Apple TV 上，提醒會在 RetroGuide 開啟時顯示。在 iPhone 或 iPad 上設定提醒，即可在 App 外收到通知。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple TV पर रिमाइंडर तभी दिखते हैं जब RetroGuide खुला हो। ऐप के बाहर सूचनाएँ पाने के लिए अपने iPhone या iPad पर रिमाइंडर सेट करें।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple TV-তে রিমাইন্ডার দেখা যায় শুধু RetroGuide খোলা থাকলে। অ্যাপের বাইরে নোটিফিকেশন পেতে আপনার iPhone বা iPad-এ রিমাইন্ডার সেট করুন।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple TV वर, RetroGuide उघडे असताना रिमाइंडर दिसतात. ॲपबाहेर नोटिफिकेशन मिळवण्यासाठी तुमच्या iPhone किंवा iPad वर रिमाइंडर सेट करा."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple TV-இல், RetroGuide திறந்திருக்கும்போது நினைவூட்டல்கள் தோன்றும். ஆப்புக்கு வெளியே அறிவிப்புகளைப் பெற, உங்கள் iPhone அல்லது iPad-இல் நினைவூட்டல்களை அமைக்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple TVలో, RetroGuide తెరిచి ఉన్నప్పుడు రిమైండర్‌లు కనిపిస్తాయి. యాప్ బయట నోటిఫికేషన్‌ల కోసం మీ iPhone లేదా iPadలో రిమైండర్‌లు సెట్ చేయండి."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple TV પર, RetroGuide ખુલ્લી હોય ત્યારે રિમાઇન્ડર દેખાય છે. ઍપની બહાર નોટિફિકેશન મેળવવા તમારા iPhone કે iPad પર રિમાઇન્ડર સેટ કરો."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple TV ಯಲ್ಲಿ, RetroGuide ತೆರೆದಿರುವಾಗ ಜ್ಞಾಪನೆಗಳು ಕಾಣಿಸುತ್ತವೆ. ಆ್ಯಪ್‌ನ ಹೊರಗೆ ಅಧಿಸೂಚನೆಗಳಿಗಾಗಿ ನಿಮ್ಮ iPhone ಅಥವಾ iPad ನಲ್ಲಿ ಜ್ಞಾಪನೆಗಳನ್ನು ಹೊಂದಿಸಿ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple TV-യിൽ RetroGuide തുറന്നിരിക്കുമ്പോൾ റിമൈൻഡറുകൾ കാണിക്കും. ആപ്പിന് പുറത്ത് അറിയിപ്പുകൾ ലഭിക്കാൻ iPhone-ലോ iPad-ലോ റിമൈൻഡറുകൾ സജ്ജമാക്കുക."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple TV 'ਤੇ, ਰਿਮਾਈਂਡਰ RetroGuide ਖੁੱਲ੍ਹਾ ਹੋਣ 'ਤੇ ਦਿਖਦੇ ਹਨ। ਐਪ ਤੋਂ ਬਾਹਰ ਸੂਚਨਾਵਾਂ ਲਈ ਆਪਣੇ iPhone ਜਾਂ iPad 'ਤੇ ਰਿਮਾਈਂਡਰ ਸੈੱਟ ਕਰੋ।"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple TVରେ, RetroGuide ଖୋଲା ଥିବା ବେଳେ ସ୍ମାରକ ଦେଖାଯାଏ। ଆପ୍ ବାହାରେ ବିଜ୍ଞପ୍ତି ପାଇଁ ଆପଣଙ୍କ iPhone ବା iPadରେ ସ୍ମାରକ ସେଟ୍ କରନ୍ତୁ।"
          }
        }
      }
    },
