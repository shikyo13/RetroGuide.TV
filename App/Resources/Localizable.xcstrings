          "stringUnit" : {
            "state" : "translated",
            "value" : "Na twoich kanałach nic nie pasuje do „%@”."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na tvých kanálech nic neodpovídá „%@“."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На ваших каналах ничего не найдено по запросу «%@»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チャンネルに「%@」に一致するものはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "채널에서 “%@”과(와) 일치하는 항목이 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "频道中没有与“%@”匹配的内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "頻道中沒有與「%@」相符的內容。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके चैनलों पर “%@” से मेल खाता कुछ नहीं है।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার চ্যানেলে “%@”-এর সাথে মেলে এমন কিছু নেই।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुमच्या चॅनेलवर “%@” शी काहीही जुळत नाही."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் சேனல்களில் “%@” உடன் எதுவும் பொருந்தவில்லை."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీ ఛానెల్‌లలో “%@”కు సరిపోయేది ఏదీ లేదు."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમારી ચેનલો પર “%@” સાથે કંઈ મેળ ખાતું નથી."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಿಮ್ಮ ಚಾನಲ್‌ಗಳಲ್ಲಿ “%@” ಗೆ ಹೊಂದುವ ಏನೂ ಇಲ್ಲ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിങ്ങളുടെ ചാനലുകളിൽ “%@” എന്നതുമായി യോജിക്കുന്നതൊന്നുമില്ല."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤੁਹਾਡੇ ਚੈਨਲਾਂ 'ਤੇ “%@” ਨਾਲ ਕੁਝ ਵੀ ਮੇਲ ਨਹੀਂ ਖਾਂਦਾ।"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆପଣଙ୍କ ଚ୍ୟାନେଲରେ “%@” ସହ କିଛି ମେଳ ଖାଉନାହିଁ।"
          }
        }
      }
    },
    "Notifications are off. Enable them for RetroGuide.TV in iPhone or iPad Settings to receive reminders." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las notificaciones están desactivadas. Actívalas para RetroGuide.TV en la configuración del iPhone o iPad para recibir recordatorios."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As notificações estão desativadas. Ative-as para o RetroGuide.TV nos Ajustes do iPhone ou iPad para receber lembretes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les notifications sont désactivées. Activez-les pour RetroGuide.TV dans les Réglages de l'iPhone ou de l'iPad pour recevoir les rappels."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le notifiche sono disattivate. Attivale per RetroGuide.TV nelle Impostazioni di iPhone o iPad per ricevere i promemoria."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitteilungen sind deaktiviert. Aktiviere sie für RetroGuide.TV in den Einstellungen deines iPhone oder iPad, um Erinnerungen zu erhalten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldingen staan uit. Schakel ze in voor RetroGuide.TV in Instellingen op je iPhone of iPad om herinneringen te ontvangen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notiser är avstängda. Slå på dem för RetroGuide.TV i Inställningar på iPhone eller iPad för att få påminnelser."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powiadomienia są wyłączone. Włącz je dla RetroGuide.TV w Ustawieniach iPhone’a lub iPada, aby otrzymywać przypomnienia."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oznámení jsou vypnutá. Chceš-li dostávat připomínky, zapni je pro RetroGuide.TV v Nastavení iPhonu nebo iPadu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уведомления выключены. Чтобы получать напоминания, включите их для RetroGuide.TV в Настройках iPhone или iPad."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知がオフになっています。リマインダーを受け取るには、iPhoneまたはiPadの設定でRetroGuide.TVの通知をオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "알림이 꺼져 있습니다. 방송 알림을 받으려면 iPhone 또는 iPad 설정에서 RetroGuide.TV의 알림을 켜십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知已关闭。请在 iPhone 或 iPad 的设置中为 RetroGuide.TV 启用通知，以接收提醒。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知已關閉。請在 iPhone 或 iPad 的設定中為 RetroGuide.TV 開啟通知，以接收提醒。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सूचनाएँ बंद हैं। रिमाइंडर पाने के लिए iPhone या iPad की सेटिंग्ज़ में RetroGuide.TV के लिए इन्हें चालू करें।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নোটিফিকেশন বন্ধ আছে। রিমাইন্ডার পেতে iPhone বা iPad-এর সেটিংসে RetroGuide.TV-র জন্য সেগুলো চালু করুন।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नोटिफिकेशन बंद आहेत. रिमाइंडर मिळवण्यासाठी iPhone किंवा iPad च्या सेटिंग्जमध्ये RetroGuide.TV साठी ती सुरू करा."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "அறிவிப்புகள் முடக்கப்பட்டுள்ளன. நினைவூட்டல்களைப் பெற, iPhone அல்லது iPad அமைப்புகளில் RetroGuide.TV-க்கு அவற்றை இயக்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "నోటిఫికేషన్‌లు ఆఫ్‌లో ఉన్నాయి. రిమైండర్‌లు పొందడానికి iPhone లేదా iPad సెట్టింగ్‌లలో RetroGuide.TV కోసం వాటిని ఎనేబుల్ చేయండి."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "નોટિફિકેશન બંધ છે. રિમાઇન્ડર મેળવવા iPhone કે iPadનાં સેટિંગ્સમાં RetroGuide.TV માટે તેને ચાલુ કરો."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಅಧಿಸೂಚನೆಗಳು ಆಫ್ ಆಗಿವೆ. ಜ್ಞಾಪನೆಗಳನ್ನು ಪಡೆಯಲು iPhone ಅಥವಾ iPad ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ RetroGuide.TV ಗಾಗಿ ಅವುಗಳನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಿ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "അറിയിപ്പുകൾ ഓഫാണ്. റിമൈൻഡറുകൾ ലഭിക്കാൻ iPhone അല്ലെങ്കിൽ iPad ക്രമീകരണത്തിൽ RetroGuide.TV-ക്ക് അറിയിപ്പുകൾ ഓണാക്കുക."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਸੂਚਨਾਵਾਂ ਬੰਦ ਹਨ। ਰਿਮਾਈਂਡਰ ਪ੍ਰਾਪਤ ਕਰਨ ਲਈ iPhone ਜਾਂ iPad ਦੀਆਂ ਸੈਟਿੰਗਾਂ ਵਿੱਚ RetroGuide.TV ਲਈ ਇਹਨਾਂ ਨੂੰ ਚਾਲੂ ਕਰੋ।"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ବିଜ୍ଞପ୍ତି ବନ୍ଦ ଅଛି। ସ୍ମାରକ ପାଇବାକୁ iPhone ବା iPad ସେଟିଂସ୍‌ରେ RetroGuide.TV ପାଇଁ ବିଜ୍ଞପ୍ତି ଚାଲୁ କରନ୍ତୁ।"
          }
        }
      }
    },
