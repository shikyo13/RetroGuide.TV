    "%@ is for %@, and %@ is %@, going by RetroGuide's title data, checked against your server's genre tags." : {
      "comment" : "Channel name, the genres it carries, a show or movie title, and the genres it has",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is for %2$@, and %3$@ is %4$@, going by RetroGuide's title data, checked against your server's genre tags."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ incluye %2$@, y %3$@ es del género %4$@, según los datos de títulos de RetroGuide, contrastados con las etiquetas de género de tu servidor."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ exibe %2$@, e %3$@ é do gênero %4$@, segundo os dados de títulos do RetroGuide, conferidos com as tags de gênero do seu servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ diffuse du genre %2$@, et %3$@ est du genre %4$@, selon les données de titres de RetroGuide, vérifiées avec les tags de genre de votre serveur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ trasmette titoli di genere %2$@, e %3$@ è di genere %4$@, secondo i dati sui titoli di RetroGuide, verificati con i tag di genere del tuo server."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ steht für %2$@, und %3$@ ist %4$@, laut den Titeldaten von RetroGuide, abgeglichen mit den Genre-Tags deines Servers."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ is voor %2$@, en %3$@ is %4$@, volgens de titelgegevens van RetroGuide, gecontroleerd aan de hand van de genretags van je server."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ är till för %2$@, och %3$@ är %4$@, enligt RetroGuides titeldata, kontrollerat mot din servers genretaggar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ nadaje gatunki: %2$@, a %3$@ to: %4$@ – według danych tytułów RetroGuide, sprawdzonych z tagami gatunków na twoim serwerze."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanál %1$@ je pro žánry %2$@ a titul %3$@ má žánry %4$@ podle údajů RetroGuide o titulech, ověřených podle žánrových štítků tvého serveru."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Канал %1$@ — для жанров «%2$@», а «%3$@» относится к жанрам «%4$@» по данным RetroGuide, сверенным с жанровыми тегами вашего сервера."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RetroGuideの作品データ（サーバのジャンルタグで照合済み）によると、%1$@は%2$@のチャンネルで、%3$@は%4$@です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RetroGuide의 작품 데이터(서버의 장르 태그와 대조)에 따르면 %1$@은(는) %2$@ 채널이고, %3$@은(는) %4$@입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 专播%2$@，而 %3$@ 属于%4$@。依据 RetroGuide 的作品数据，并已对照服务器的类型标签。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 專播%2$@，而 %3$@ 屬於%4$@。依據 RetroGuide 的作品資料，並已對照伺服器的類型標籤。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ के लिए है, और %3$@ %4$@ है। यह RetroGuide के टाइटल डेटा पर आधारित है, जिसे आपके सर्वर के शैली टैग से जाँचा गया है।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ হলো %2$@-এর জন্য, আর %3$@ হলো %4$@। এটি RetroGuide-এর টাইটেল ডেটা অনুযায়ী, যা আপনার সার্ভারের ধরন ট্যাগের সাথে মিলিয়ে দেখা হয়েছে।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ मध्ये %2$@ येतात, आणि %3$@ ची शैली %4$@ आहे, RetroGuide च्या शीर्षक डेटानुसार, तुमच्या सर्व्हरच्या शैली टॅगशी पडताळून."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RetroGuide-இன் தலைப்புத் தரவின்படி, உங்கள் சர்வரின் வகைக் குறிச்சொற்களுடன் சரிபார்த்து: %1$@ என்பது %2$@ சேனல்; %3$@ என்பது %4$@."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ఛానెల్ %2$@ కోసం; %3$@ జానర్: %4$@. ఇది RetroGuide టైటిల్ డేటా ఆధారంగా, మీ సర్వర్ జానర్ ట్యాగ్‌లతో సరిచూసినది."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ચેનલ %2$@ માટે છે, અને %3$@ %4$@ છે. આ RetroGuideના ટાઇટલ ડેટા પર આધારિત છે, જે તમારા સર્વરના શૈલી ટૅગ સાથે ચકાસેલો છે."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ಚಾನಲ್ ಈ ಪ್ರಕಾರಗಳಿಗಾಗಿ: %2$@. %3$@ ಈ ಪ್ರಕಾರಕ್ಕೆ ಸೇರಿದೆ: %4$@. ಇದು RetroGuide ಶೀರ್ಷಿಕೆ ಡೇಟಾವನ್ನು ಆಧರಿಸಿದೆ, ನಿಮ್ಮ ಸರ್ವರ್‌ನ ಪ್ರಕಾರ ಟ್ಯಾಗ್‌ಗಳೊಂದಿಗೆ ಪರಿಶೀಲಿಸಲಾಗಿದೆ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ചാനൽ %2$@ വിഭാഗത്തിനുള്ളതാണ്. RetroGuide-ന്റെ ടൈറ്റിൽ ഡാറ്റ പ്രകാരം, നിങ്ങളുടെ സെർവറിലെ വിഭാഗ ടാഗുകളുമായി ഒത്തുനോക്കിയപ്പോൾ, %3$@ ഇതാണ്: %4$@."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ ਲਈ ਹੈ, ਅਤੇ RetroGuide ਦੇ ਟਾਈਟਲ ਡਾਟਾ ਮੁਤਾਬਕ, ਜੋ ਤੁਹਾਡੇ ਸਰਵਰ ਦੇ ਸ਼ੈਲੀ ਟੈਗਾਂ ਨਾਲ ਮਿਲਾ ਕੇ ਜਾਂਚਿਆ ਗਿਆ ਹੈ, %3$@ %4$@ ਹੈ।"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ ପାଇଁ, ଏବଂ %3$@ ହେଉଛି %4$@, RetroGuideର ଟାଇଟଲ୍ ତଥ୍ୟ ଅନୁସାରେ, ଆପଣଙ୍କ ସର୍ଭରର ଶୈଳୀ ଟ୍ୟାଗ୍ ସହ ମିଳାଇ।"
          }
        }
      }
    },
