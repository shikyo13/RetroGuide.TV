        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервер %@ отсюда недоступен. Чтобы смотреть вне дома, добавьте внешний адрес."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここからは%@に接続できません。外出先で視聴するには、外出先用アドレスを追加してください。"
