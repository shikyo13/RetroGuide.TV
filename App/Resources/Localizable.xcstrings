          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस डिवाइस की सेटिंग्ज़ में iCloud में साइन इन करें, फिर दोबारा कोशिश करें।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই ডিভাইসের সেটিংসে iCloud-এ সাইন ইন করুন, তারপর আবার চেষ্টা করুন।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "या डिव्हाइसच्या सेटिंग्जमध्ये iCloud मध्ये साइन इन करा, मग पुन्हा प्रयत्न करा."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இந்தச் சாதனத்தின் அமைப்புகளில் iCloud-இல் உள்நுழைந்து, மீண்டும் முயலவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఈ పరికరం సెట్టింగ్‌లలో iCloudకు సైన్ ఇన్ చేసి, మళ్లీ ప్రయత్నించండి."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આ ડિવાઇસનાં સેટિંગ્સમાં iCloudમાં સાઇન ઇન કરો, પછી ફરી પ્રયાસ કરો."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಈ ಸಾಧನದ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ iCloud ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ, ನಂತರ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഈ ഉപകരണത്തിന്റെ ക്രമീകരണത്തിൽ iCloud-ലേക്ക് സൈൻ ഇൻ ചെയ്ത് വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਇਸ ਡਿਵਾਈਸ ਦੀਆਂ ਸੈਟਿੰਗਾਂ ਵਿੱਚ iCloud ਵਿੱਚ ਸਾਈਨ ਇਨ ਕਰੋ, ਫਿਰ ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଏହି ଡିଭାଇସର ସେଟିଂସ୍‌ରେ iCloudରେ ସାଇନ୍ ଇନ୍ କରନ୍ତୁ, ତା'ପରେ ପୁଣି ଚେଷ୍ଟା କରନ୍ତୁ।"
          }
        }
      }
    },
    "Sign in with the Plex account that has your server, or the one a friend shared their server with." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión con la cuenta de Plex que tiene tu servidor, o con la cuenta con la que un amigo compartió su servidor."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entre com a conta Plex que tem seu servidor, ou com a conta com que um amigo compartilhou o servidor dele."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous avec le compte Plex qui possède votre serveur, ou celui avec lequel un ami a partagé son serveur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accedi con l'account Plex che possiede il tuo server, o con quello con cui un amico ha condiviso il suo server."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melde dich mit dem Plex-Account an, zu dem dein Server gehört, oder mit dem, für den ein Freund seinen Server freigegeben hat."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log in met het Plex-account waarop je server staat, of met het account waarmee een vriend zijn server heeft gedeeld."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logga in med Plex-kontot som har din server, eller det konto som en vän har delat sin server med."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaloguj się kontem Plex, na którym jest twój serwer, lub tym, któremu znajomy udostępnił swój serwer."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přihlas se účtem Plex, ke kterému patří tvůj server, nebo tím, se kterým kamarád sdílí svůj server."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Войдите с учётной записью Plex, к которой привязан ваш сервер, или с той, которой друг открыл доступ к своему серверу."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバを所有しているPlexアカウント、または友人がサーバを共有したPlexアカウントでサインインしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버가 있는 Plex 계정이나 친구가 서버를 공유한 Plex 계정으로 로그인하십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用拥有你服务器的 Plex 账户登录，或使用朋友共享服务器给你时所用的账户登录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用擁有你伺服器的 Plex 帳號登入，或使用朋友分享伺服器給你時所用的帳號登入。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उस Plex अकाउंट से साइन इन करें जिसमें आपका सर्वर है, या जिसके साथ किसी दोस्त ने अपना सर्वर शेयर किया है।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যে Plex অ্যাকাউন্টে আপনার সার্ভার আছে, বা যে অ্যাকাউন্টের সাথে কোনো বন্ধু তার সার্ভার শেয়ার করেছেন, সেটি দিয়ে সাইন ইন করুন।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुमचा सर्व्हर असलेल्या Plex खात्याने साइन इन करा, किंवा ज्या खात्यासोबत मित्राने त्याचा सर्व्हर शेअर केला आहे त्याने."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் சர்வர் உள்ள Plex கணக்குடன், அல்லது நண்பர் தம் சர்வரைப் பகிர்ந்த கணக்குடன் உள்நுழையவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీ సర్వర్ ఉన్న Plex ఖాతాతో, లేదా స్నేహితులు తమ సర్వర్‌ను షేర్ చేసిన ఖాతాతో సైన్ ఇన్ చేయండి."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "જે Plex એકાઉન્ટમાં તમારું સર્વર છે, અથવા જેની સાથે કોઈ મિત્રએ પોતાનું સર્વર શેર કર્યું છે, તેનાથી સાઇન ઇન કરો."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಿಮ್ಮ ಸರ್ವರ್ ಇರುವ Plex ಖಾತೆಯಿಂದ, ಅಥವಾ ಸ್ನೇಹಿತರು ತಮ್ಮ ಸರ್ವರ್ ಹಂಚಿಕೊಂಡ ಖಾತೆಯಿಂದ ಸೈನ್ ಇನ್ ಮಾಡಿ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിങ്ങളുടെ സെർവറുള്ള Plex അക്കൗണ്ട് ഉപയോഗിച്ചോ, ഒരു സുഹൃത്ത് സെർവർ പങ്കിട്ട അക്കൗണ്ട് ഉപയോഗിച്ചോ സൈൻ ഇൻ ചെയ്യുക."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਉਸ Plex ਖਾਤੇ ਨਾਲ ਸਾਈਨ ਇਨ ਕਰੋ ਜਿਸ ਵਿੱਚ ਤੁਹਾਡਾ ਸਰਵਰ ਹੈ, ਜਾਂ ਜਿਸ ਨਾਲ ਕਿਸੇ ਦੋਸਤ ਨੇ ਆਪਣਾ ਸਰਵਰ ਸਾਂਝਾ ਕੀਤਾ ਹੈ।"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆପଣଙ୍କ ସର୍ଭର ଥିବା Plex ଆକାଉଣ୍ଟରେ, କିମ୍ବା ଜଣେ ବନ୍ଧୁ ଯେଉଁ ଆକାଉଣ୍ଟ ସହ ସର୍ଭର ସେୟାର୍ କରିଛନ୍ତି ସେଥିରେ ସାଇନ୍ ଇନ୍ କରନ୍ତୁ।"
          }
        }
      }
    },
