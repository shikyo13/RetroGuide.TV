          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одна покупка, без подписки. Открывает Pro на iPhone, iPad и Apple TV."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1回購入するだけで、サブスクリプションは不要です。iPhone、iPad、Apple TVでProが使えるようになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 번 구입하면 구독이 필요 없습니다. iPhone, iPad 및 Apple TV에서 Pro가 잠금 해제됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一次购买，无需订阅。可在你的 iPhone、iPad 和 Apple TV 上解锁 Pro。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一次購買，無須訂閱。可在你的 iPhone、iPad 和 Apple TV 上解鎖 Pro。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक बार ख़रीदें, कोई सब्सक्रिप्शन नहीं। इससे आपके iPhone, iPad और Apple TV पर Pro अनलॉक होता है।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একবার কিনুন, কোনো সাবস্ক্রিপশন নেই। এতে আপনার iPhone, iPad ও Apple TV-তে Pro আনলক হয়।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एकदाच खरेदी, सबस्क्रिप्शन नाही. यामुळे तुमच्या iPhone, iPad आणि Apple TV वर Pro अनलॉक होते."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஒருமுறை வாங்குதல், சந்தா இல்லை. இது உங்கள் iPhone, iPad, Apple TV-இல் Pro-வைத் திறக்கும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఒక్కసారి కొనుగోలు, సబ్‌స్క్రిప్షన్ లేదు. ఇది మీ iPhone, iPad, Apple TVలో Proను అన్‌లాక్ చేస్తుంది."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "એક જ ખરીદી, કોઈ સબ્સ્ક્રિપ્શન નહીં. તે તમારા iPhone, iPad અને Apple TV પર Pro અનલૉક કરે છે."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಒಂದು ಬಾರಿ ಖರೀದಿ, ಚಂದಾದಾರಿಕೆ ಇಲ್ಲ. ಇದು ನಿಮ್ಮ iPhone, iPad ಮತ್ತು Apple TV ಯಲ್ಲಿ Pro ಅನ್‌ಲಾಕ್ ಮಾಡುತ್ತದೆ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഒറ്റ വാങ്ങൽ, സബ്സ്ക്രിപ്ഷൻ ഇല്ല. നിങ്ങളുടെ iPhone, iPad, Apple TV എന്നിവയിൽ Pro അൺലോക്ക് ചെയ്യുന്നു."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਇੱਕ ਵਾਰ ਦੀ ਖ਼ਰੀਦ, ਕੋਈ ਸਬਸਕ੍ਰਿਪਸ਼ਨ ਨਹੀਂ। ਇਹ ਤੁਹਾਡੇ iPhone, iPad ਅਤੇ Apple TV 'ਤੇ Pro ਅਨਲੌਕ ਕਰਦੀ ਹੈ।"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଥରେ କିଣନ୍ତୁ, କୌଣସି ସବସ୍କ୍ରିପସନ୍ ନାହିଁ। ଏହା ଆପଣଙ୍କ iPhone, iPad ଓ Apple TVରେ Pro ଅନଲକ୍ କରେ।"
          }
        }
      }
    },
