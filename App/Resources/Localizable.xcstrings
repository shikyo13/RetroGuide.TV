    },
    "One purchase, no subscription. It unlocks Pro on your iPhone, iPad and Apple TV." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un solo pago, sin suscripción. Desbloquea Pro en tu iPhone, iPad y Apple TV."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma compra, sem assinatura. Desbloqueia o Pro no seu iPhone, iPad e Apple TV."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un seul achat, sans abonnement. Il débloque Pro sur votre iPhone, iPad et Apple TV."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un solo acquisto, nessun abbonamento. Sblocca Pro su iPhone, iPad e Apple TV."
