          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blanda din server och servrar som delats med dig i ett och samma utbud."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Połącz swój serwer i serwery udostępnione ci w jeden zestaw kanałów."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spoj svůj server a servery sdílené s tebou do jedné nabídky."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Объедините свой сервер и серверы, к которым вам открыли доступ, в один список каналов."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分のサーバと共有されたサーバを1つのラインナップにまとめられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내 서버와 공유받은 서버를 하나의 라인업으로 합칠 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将你的服务器和别人共享给你的服务器合并为一个频道阵容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將你的伺服器和別人分享給你的伺服器合併為一個頻道陣容。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपना सर्वर और आपके साथ शेयर किए गए सर्वर एक ही लाइनअप में मिलाएँ।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার সার্ভার আর আপনার সাথে শেয়ার করা সার্ভারগুলো একটি লাইনআপে মিলিয়ে নিন।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुमचा सर्व्हर आणि तुमच्यासोबत शेअर केलेले सर्व्हर एकाच यादीत एकत्र करा."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் சர்வரையும் உங்களுடன் பகிர்ந்த சர்வர்களையும் ஒரே வரிசையில் இணைக்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీ సర్వర్‌ను, మీతో షేర్ చేసినవాటిని ఒకే లైనప్‌లో కలపండి."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમારું સર્વર અને તમારી સાથે શેર કરેલાં સર્વર એક જ લાઇનઅપમાં જોડો."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಿಮ್ಮ ಸರ್ವರ್ ಮತ್ತು ನಿಮ್ಮೊಂದಿಗೆ ಹಂಚಿಕೊಂಡ ಸರ್ವರ್‌ಗಳನ್ನು ಒಂದೇ ಚಾನಲ್ ಪಟ್ಟಿಯಲ್ಲಿ ಸೇರಿಸಿ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിങ്ങളുടെ സെർവറും നിങ്ങളുമായി പങ്കിട്ടവയും ഒരേ ചാനൽ നിരയിൽ ചേർക്കുക."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਆਪਣੇ ਸਰਵਰ ਅਤੇ ਤੁਹਾਡੇ ਨਾਲ ਸਾਂਝੇ ਕੀਤੇ ਸਰਵਰਾਂ ਨੂੰ ਇੱਕ ਲਾਈਨਅੱਪ ਵਿੱਚ ਮਿਲਾਓ।"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆପଣଙ୍କ ସର୍ଭର ଓ ଆପଣଙ୍କ ସହ ସେୟାର୍ ହୋଇଥିବା ସର୍ଭରକୁ ଗୋଟିଏ ଚ୍ୟାନେଲ ତାଲିକାରେ ମିଶାନ୍ତୁ।"
          }
        }
      }
    },
