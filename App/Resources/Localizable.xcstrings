          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blockerade serier och filmer döljs från alla kanaler, även matchande kopior på andra servrar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zablokowane seriale i filmy są ukryte na wszystkich kanałach, łącznie z pasującymi kopiami na innych serwerach."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blokované pořady a filmy se skryjí na všech kanálech, včetně stejných kopií na jiných serverech."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заблокированные сериалы и фильмы скрываются на всех каналах, включая их копии на других серверах."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブロックした番組と映画は、他のサーバにある同じ作品も含め、すべてのチャンネルで非表示になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "차단한 프로그램과 영화는 다른 서버에 있는 같은 작품을 포함해 모든 채널에서 숨겨집니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已屏蔽的剧集和电影会从所有频道中隐藏，包括其他服务器上的相同作品。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已封鎖的影集和電影會從所有頻道中隱藏，包括其他伺服器上的相同作品。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ब्लॉक किए गए शो और फ़िल्में हर चैनल से छिपे रहते हैं, दूसरे सर्वर पर मौजूद उनकी कॉपी भी।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ব্লক করা শো ও সিনেমা সব চ্যানেল থেকে লুকানো থাকে, অন্য সার্ভারে থাকা এগুলোর কপিও।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ब्लॉक केलेले शो आणि चित्रपट प्रत्येक चॅनेलमधून लपवले जातात, इतर सर्व्हरवरील जुळणाऱ्या प्रतींसह."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "தடுத்த நிகழ்ச்சிகளும் படங்களும், பிற சர்வர்களில் உள்ள பொருந்தும் பிரதிகள் உட்பட, எல்லாச் சேனல்களிலிருந்தும் மறைக்கப்படும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "బ్లాక్ చేసిన షోలు, సినిమాలు ప్రతి ఛానెల్ నుండి దాచబడతాయి, ఇతర సర్వర్‌లలోని సరిపోలే కాపీలతో సహా."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "બ્લૉક કરેલા શો અને ફિલ્મો દરેક ચેનલમાંથી છુપાવાય છે, બીજાં સર્વર પરની મેળ ખાતી કૉપી સહિત."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಿರ್ಬಂಧಿಸಿದ ಶೋಗಳು ಮತ್ತು ಸಿನಿಮಾಗಳು ಎಲ್ಲಾ ಚಾನಲ್‌ಗಳಿಂದ ಮರೆಯಾಗುತ್ತವೆ, ಇತರ ಸರ್ವರ್‌ಗಳಲ್ಲಿನ ಹೊಂದುವ ಪ್ರತಿಗಳೂ ಸೇರಿದಂತೆ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "തടഞ്ഞ ഷോകളും സിനിമകളും എല്ലാ ചാനലുകളിൽ നിന്നും മറയ്ക്കും, മറ്റ് സെർവറുകളിലെ അതേ പകർപ്പുകൾ ഉൾപ്പെടെ."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਬਲੌਕ ਕੀਤੇ ਸ਼ੋਅ ਅਤੇ ਫ਼ਿਲਮਾਂ ਹਰ ਚੈਨਲ ਤੋਂ ਲੁਕਾਏ ਜਾਂਦੇ ਹਨ, ਹੋਰ ਸਰਵਰਾਂ 'ਤੇ ਮੇਲ ਖਾਂਦੀਆਂ ਕਾਪੀਆਂ ਸਮੇਤ।"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଅବରୋଧିତ ଶୋ ଓ ସିନେମା ସବୁ ଚ୍ୟାନେଲରୁ ଲୁଚାଯାଏ, ଅନ୍ୟ ସର୍ଭରରେ ଥିବା ମେଳ ଖାଉଥିବା କପି ସମେତ।"
          }
        }
      }
    },
    "Breaks use the combined running time of the selected clips, which is included in the guide. If fewer clips are available, each plays once. Program start-time alignment may add an intermission before the next program." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las pausas duran lo mismo que los clips seleccionados juntos, y esa duración se incluye en la guía. Si hay menos clips disponibles, cada uno se reproduce una vez. Alinear las horas de inicio puede agregar un intermedio antes del siguiente programa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os intervalos duram o tempo somado dos clipes selecionados, que é incluído no guia. Se houver menos clipes disponíveis, cada um passa uma vez. O alinhamento do horário de início pode adicionar uma pausa antes do próximo programa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les coupures durent le temps cumulé des spots sélectionnés, inclus dans le guide. S'il y a moins de spots disponibles, chacun est diffusé une fois. L'alignement des heures de début peut ajouter un entracte avant le programme suivant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le pause durano quanto la somma degli spot selezionati, inclusa nella guida. Se ci sono meno spot disponibili, ognuno va in onda una volta. L'allineamento degli orari di inizio può aggiungere un intervallo prima del programma successivo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werbepausen nutzen die gesamte Laufzeit der ausgewählten Clips, die im TV-Programm eingerechnet ist. Sind weniger Clips verfügbar, läuft jeder einmal. Das Ausrichten der Startzeiten kann vor der nächsten Sendung eine Pause einfügen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reclameblokken gebruiken de totale speelduur van de geselecteerde clips, die in de tv-gids is meegerekend. Zijn er minder clips beschikbaar, dan wordt elke clip één keer afgespeeld. Uitlijning van de begintijden kan een pauze toevoegen vóór het volgende programma."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pauserna använder de valda klippens sammanlagda speltid, som räknas in i guiden. Om det finns färre klipp spelas vart och ett en gång. Justering av programmens starttider kan lägga till en paus före nästa program."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przerwa trwa tyle, ile łącznie wybrane klipy, a ten czas jest uwzględniony w przewodniku. Jeśli klipów jest mniej, każdy leci raz. Wyrównywanie godzin rozpoczęcia może dodać pauzę przed kolejnym programem."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přestávky trvají tak dlouho jako vybrané klipy dohromady a tato doba je zahrnutá v TV programu. Pokud je klipů méně, každý se přehraje jednou. Zarovnání začátků pořadů může před dalším pořadem přidat pauzu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Длительность паузы равна общей длительности выбранных роликов и учитывается в телегиде. Если роликов меньше, каждый показывается один раз. Выравнивание времени начала передач может добавить перерыв перед следующей передачей."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CM枠の長さは選択したクリップの合計時間になり、番組表にも反映されます。クリップが足りない場合は、各クリップを1回ずつ再生します。番組の開始時刻をそろえるため、次の番組の前に休憩が入ることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "광고 시간은 선택한 클립의 총 재생 시간이며 편성표에 포함됩니다. 클립이 부족하면 각 클립을 한 번씩 재생합니다. 프로그램 시작 시간을 맞추기 위해 다음 프로그램 전에 휴식 시간이 추가될 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "广告时段使用所选片段的总时长，并计入节目表。如果可用片段较少，每个片段只播放一次。对齐节目开始时间可能会在下一个节目前加入幕间休息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "廣告時段使用所選片段的總長度，並計入節目表。如果可用片段較少，每個片段只會播放一次。對齊節目開始時間可能會在下一個節目前加入中場休息。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ब्रेक की लंबाई चुनी गई क्लिप के कुल समय जितनी होती है, जो गाइड में शामिल है। कम क्लिप उपलब्ध हों, तो हर क्लिप एक बार चलती है। प्रोग्राम के शुरू होने का समय मिलाने के लिए अगले प्रोग्राम से पहले एक छोटा ब्रेक जुड़ सकता है।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বিরতির দৈর্ঘ্য বাছাই করা ক্লিপগুলোর মোট সময়ের সমান, যা গাইডে ধরা আছে। কম ক্লিপ থাকলে, প্রতিটি একবার চলে। অনুষ্ঠানের শুরুর সময় মেলাতে পরের অনুষ্ঠানের আগে একটি ছোট বিরতি যোগ হতে পারে।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ब्रेकमध्ये निवडलेल्या क्लिपचा एकूण कालावधी वापरला जातो, जो गाइडमध्ये समाविष्ट असतो. कमी क्लिप उपलब्ध असल्यास, प्रत्येक एकदाच प्ले होते. कार्यक्रम सुरू होण्याची वेळ जुळवल्यामुळे पुढील कार्यक्रमापूर्वी मध्यंतर येऊ शकते."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இடைவேளைகள் தேர்ந்தெடுத்த கிளிப்களின் மொத்த நேரத்தைப் பயன்படுத்தும்; அது வழிகாட்டியிலும் சேர்க்கப்படும். குறைவான கிளிப்கள் இருந்தால், ஒவ்வொன்றும் ஒருமுறை இயங்கும். நிகழ்ச்சித் தொடக்க நேரச் சீரமைப்பு அடுத்த நிகழ்ச்சிக்கு முன் ஓர் இடைவேளையைச் சேர்க்கலாம்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "బ్రేక్‌లు ఎంచుకున్న క్లిప్‌ల మొత్తం నిడివిని ఉపయోగిస్తాయి, ఇది గైడ్‌లో చేర్చబడుతుంది. తక్కువ క్లిప్‌లు ఉంటే, ఒక్కొక్కటి ఒకసారి ప్లే అవుతుంది. ప్రోగ్రామ్ ప్రారంభ సమయ అమరిక వల్ల తదుపరి ప్రోగ్రామ్‌కు ముందు విరామం రావచ్చు."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "બ્રેકમાં પસંદ કરેલી ક્લિપ્સનો કુલ સમય વપરાય છે, જે ગાઇડમાં સામેલ હોય છે. ઓછી ક્લિપ્સ ઉપલબ્ધ હોય, તો દરેક એક વાર ચાલે છે. પ્રોગ્રામના શરૂ થવાના સમય ગોઠવવાથી આગલા પ્રોગ્રામ પહેલાં ઇન્ટરવલ ઉમેરાઈ શકે છે."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ವಿರಾಮಗಳು ಆಯ್ದ ಕ್ಲಿಪ್‌ಗಳ ಒಟ್ಟು ಅವಧಿಯನ್ನು ಬಳಸುತ್ತವೆ, ಅದು ಗೈಡ್‌ನಲ್ಲಿ ಸೇರಿರುತ್ತದೆ. ಕಡಿಮೆ ಕ್ಲಿಪ್‌ಗಳು ಲಭ್ಯವಿದ್ದರೆ, ಪ್ರತಿಯೊಂದೂ ಒಮ್ಮೆ ಪ್ಲೇ ಆಗುತ್ತದೆ. ಕಾರ್ಯಕ್ರಮದ ಆರಂಭ ಸಮಯದ ಹೊಂದಾಣಿಕೆಯಿಂದ ಮುಂದಿನ ಕಾರ್ಯಕ್ರಮದ ಮೊದಲು ಮಧ್ಯಂತರ ಸೇರಬಹುದು."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "തിരഞ്ഞെടുത്ത ക്ലിപ്പുകളുടെ ആകെ ദൈർഘ്യമാണ് ഇടവേളകൾക്ക്, അത് ഗൈഡിലും ഉൾപ്പെടുത്തും. ക്ലിപ്പുകൾ കുറവാണെങ്കിൽ ഓരോന്നും ഒരു തവണ പ്ലേ ചെയ്യും. പരിപാടി ആരംഭ സമയം ക്രമീകരിക്കുമ്പോൾ അടുത്ത പരിപാടിക്ക് മുമ്പ് ഒരു ചെറിയ ഇടവേള വന്നേക്കാം."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਬ੍ਰੇਕਾਂ ਚੁਣੀਆਂ ਕਲਿੱਪਾਂ ਦਾ ਕੁੱਲ ਸਮਾਂ ਵਰਤਦੀਆਂ ਹਨ, ਜੋ ਗਾਈਡ ਵਿੱਚ ਸ਼ਾਮਲ ਹੁੰਦਾ ਹੈ। ਜੇ ਘੱਟ ਕਲਿੱਪਾਂ ਉਪਲਬਧ ਹੋਣ, ਤਾਂ ਹਰ ਇੱਕ ਇੱਕ ਵਾਰ ਚੱਲਦੀ ਹੈ। ਪ੍ਰੋਗਰਾਮਾਂ ਦੇ ਸ਼ੁਰੂ ਹੋਣ ਦਾ ਸਮਾਂ ਮਿਲਾਉਣ ਕਾਰਨ ਅਗਲੇ ਪ੍ਰੋਗਰਾਮ ਤੋਂ ਪਹਿਲਾਂ ਇੰਟਰਵਲ ਆ ਸਕਦਾ ਹੈ।"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ବିରତି ବଛା କ୍ଲିପ୍‌ଗୁଡ଼ିକର ମିଳିତ ଅବଧି ବ୍ୟବହାର କରେ, ଯାହା ଗାଇଡ୍‌ରେ ସାମିଲ। କମ୍ କ୍ଲିପ୍ ଉପଲବ୍ଧ ଥିଲେ, ପ୍ରତ୍ୟେକ ଥରେ ଚାଲେ। କାର୍ଯ୍ୟକ୍ରମ ଆରମ୍ଭ ସମୟ ମିଳାଇବା ପାଇଁ ପରବର୍ତ୍ତୀ କାର୍ଯ୍ୟକ୍ରମ ପୂର୍ବରୁ ଏକ ବିରତି ଯୋଗ ହୋଇପାରେ।"
          }
        }
      }
    },
    "Browse ahead in the guide, select a program, then choose Remind me. Reminders never change channels automatically." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avanza en la guía, selecciona un programa y elige Recordármelo. Los recordatorios nunca cambian de canal automáticamente."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avance no guia, selecione um programa e escolha Lembrar. Os lembretes nunca trocam de canal automaticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parcourez le guide, sélectionnez un programme, puis choisissez Me le rappeler. Les rappels ne changent jamais de chaîne automatiquement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri la guida in avanti, seleziona un programma, poi scegli Ricordamelo. I promemoria non cambiano mai canale automaticamente."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blättere im TV-Programm vor, wähle eine Sendung und dann „Erinnern“. Erinnerungen wechseln nie automatisch den Kanal."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blader vooruit in de tv-gids, selecteer een programma en kies ‘Herinner me’. Herinneringen schakelen nooit automatisch van zender."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bläddra framåt i guiden, välj ett program och välj sedan Påminn mig. Påminnelser byter aldrig kanal automatiskt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przejrzyj przewodnik do przodu, wybierz program, a potem Przypomnij mi. Przypomnienia nigdy nie zmieniają kanału automatycznie."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prolistuj TV program dopředu, vyber pořad a zvol Připomenout. Připomínky nikdy samy nepřepínají kanál."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Найдите передачу в телегиде, выберите её, затем нажмите «Напомнить». Напоминания никогда не переключают каналы автоматически."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "番組表で先の時間帯を見て番組を選択し、「リマインド」を選びます。リマインダーで自動的にチャンネルが切り替わることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "편성표에서 이후 시간대를 둘러보고 프로그램을 선택한 다음 “알림 받기”를 선택하십시오. 방송 알림이 채널을 자동으로 바꾸지는 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在节目表中向后浏览，选择一个节目，然后选择“提醒我”。提醒绝不会自动转台。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在節目表中往後瀏覽，選擇一個節目，然後選擇「提醒我」。提醒絕不會自動轉台。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "गाइड में आगे देखें, कोई प्रोग्राम चुनें, फिर “याद दिलाएँ” चुनें। रिमाइंडर कभी अपने-आप चैनल नहीं बदलते।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "গাইডে সামনের দিকে দেখুন, একটি অনুষ্ঠান বেছে নিন, তারপর “মনে করিয়ে দিন” বেছে নিন। রিমাইন্ডার কখনো নিজে থেকে চ্যানেল বদলায় না।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "गाइडमध्ये पुढचे पाहा, एखादा कार्यक्रम निवडा, मग “आठवण करून द्या” निवडा. रिमाइंडर कधीही आपोआप चॅनेल बदलत नाहीत."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "வழிகாட்டியில் முன்னே சென்று, ஒரு நிகழ்ச்சியைத் தேர்ந்தெடுத்து, ‘நினைவூட்டு’ என்பதைத் தேர்வுசெய்யவும். நினைவூட்டல்கள் ஒருபோதும் தானாகச் சேனலை மாற்றாது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "గైడ్‌లో ముందుకు బ్రౌజ్ చేసి, ఒక ప్రోగ్రామ్‌ను ఎంచుకుని, ‘గుర్తు చేయండి’ ఎంచుకోండి. రిమైండర్‌లు ఎప్పుడూ ఛానెల్‌ను ఆటోమేటిక్‌గా మార్చవు."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ગાઇડમાં આગળ જુઓ, કોઈ પ્રોગ્રામ પસંદ કરો, પછી “યાદ અપાવો” પસંદ કરો. રિમાઇન્ડર ક્યારેય આપમેળે ચેનલ બદલતાં નથી."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಗೈಡ್‌ನಲ್ಲಿ ಮುಂದೆ ನೋಡಿ, ಕಾರ್ಯಕ್ರಮವನ್ನು ಆಯ್ಕೆಮಾಡಿ, ನಂತರ “ನನಗೆ ನೆನಪಿಸಿ” ಆಯ್ಕೆಮಾಡಿ. ಜ್ಞಾಪನೆಗಳು ಎಂದಿಗೂ ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಚಾನಲ್ ಬದಲಿಸುವುದಿಲ್ಲ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഗൈഡിൽ മുന്നോട്ട് നോക്കി ഒരു പരിപാടി തിരഞ്ഞെടുത്ത്, \"ഓർമ്മിപ്പിക്കുക\" തിരഞ്ഞെടുക്കുക. റിമൈൻഡറുകൾ ഒരിക്കലും സ്വയം ചാനൽ മാറ്റില്ല."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਗਾਈਡ ਵਿੱਚ ਅੱਗੇ ਦੇਖੋ, ਕੋਈ ਪ੍ਰੋਗਰਾਮ ਚੁਣੋ, ਫਿਰ ‘ਮੈਨੂੰ ਯਾਦ ਕਰਾਓ’ ਚੁਣੋ। ਰਿਮਾਈਂਡਰ ਕਦੇ ਵੀ ਆਪਣੇ-ਆਪ ਚੈਨਲ ਨਹੀਂ ਬਦਲਦੇ।"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଗାଇଡ୍‌ରେ ଆଗକୁ ଦେଖନ୍ତୁ, ଏକ କାର୍ଯ୍ୟକ୍ରମ ବାଛନ୍ତୁ, ତା'ପରେ “ମନେ ପକାନ୍ତୁ” ବାଛନ୍ତୁ। ସ୍ମାରକ କେବେ ବି ନିଜେ ଚ୍ୟାନେଲ ବଦଳାଏ ନାହିଁ।"
          }
        }
      }
    },
