          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இந்தக் கணக்கால் பார்க்கக்கூடிய திரைப்பட அல்லது டிவி நிகழ்ச்சி லைப்ரரிகள் %@-இல் இல்லை."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఈ ఖాతాకు కనిపించే సినిమా లేదా TV షో లైబ్రరీలు %@లో లేవు."
          }
