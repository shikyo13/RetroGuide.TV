    "Turn on Match Content in the Apple TV's Settings → Video and Audio to allow this." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa Ajustar contenido en Configuración → Video y audio del Apple TV para permitirlo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative Ajustar Conteúdo em Ajustes → Vídeo e Áudio da Apple TV para permitir isso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour l'autoriser, activez Ajuster le contenu dans Réglages → Vidéo et audio sur l'Apple TV."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per consentirlo, attiva Adatta contenuto in Impostazioni → Video e audio su Apple TV."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere „Inhalt anpassen“ unter Einstellungen → Video und Audio auf dem Apple TV, um dies zu erlauben."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet ‘Stem inhoud af’ aan in Instellingen → Video en audio op de Apple TV om dit toe te staan."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå på Matcha innehåll i Apple TV:ns Inställningar → Video och ljud för att tillåta detta."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby na to pozwolić, włącz Dopasuj zawartość w Ustawieniach Apple TV → Wideo i audio."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chceš-li to povolit, zapni Přizpůsobit obsah v Nastavení Apple TV → Video a audio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы разрешить это, включите «Сопоставлять контент» в Настройках Apple TV → «Видео и аудио»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これを許可するには、Apple TVの「設定」→「ビデオとオーディオ」で「コンテンツに合わせる」をオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기능을 허용하려면 Apple TV의 설정 → 비디오 및 오디오에서 콘텐츠에 맞추기를 켜십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在 Apple TV 的“设置”→“视频和音频”中打开“匹配内容”以允许此项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在 Apple TV 的「設定」→「影像和音訊」中開啟「符合內容」以允許此選項。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसकी अनुमति देने के लिए Apple TV की सेटिंग्ज़ → वीडियो और ऑडियो में “कंटेंट मैच करें” चालू करें।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এটির অনুমতি দিতে Apple TV-র সেটিংস → ভিডিও ও অডিও-তে “কনটেন্ট মেলান” চালু করুন।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "याला अनुमती देण्यासाठी Apple TV च्या सेटिंग्ज → व्हिडिओ आणि ऑडिओ मध्ये Match Content सुरू करा."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இதை அனுமதிக்க, Apple TV-யின் அமைப்புகள் → வீடியோ மற்றும் ஆடியோ என்பதில் ‘உள்ளடக்கத்தைப் பொருத்து’ என்பதை இயக்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "దీన్ని అనుమతించడానికి Apple TV సెట్టింగ్‌లు → వీడియో, ఆడియోలో Match Contentను ఆన్ చేయండి."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આ મંજૂર કરવા Apple TVનાં Settings → Video and Audioમાં Match Content ચાલુ કરો."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಇದನ್ನು ಅನುಮತಿಸಲು Apple TV ಯ Settings → Video and Audio ನಲ್ಲಿ Match Content ಆನ್ ಮಾಡಿ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഇത് അനുവദിക്കാൻ Apple TV-യുടെ ക്രമീകരണം → വീഡിയോയും ഓഡിയോയും എന്നതിൽ \"ഉള്ളടക്കം പൊരുത്തപ്പെടുത്തുക\" ഓണാക്കുക."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਇਸਦੀ ਇਜਾਜ਼ਤ ਦੇਣ ਲਈ Apple TV ਦੀਆਂ Settings → Video and Audio ਵਿੱਚ Match Content ਚਾਲੂ ਕਰੋ।"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଏହାକୁ ଅନୁମତି ଦେବାକୁ Apple TVର Settings → Video and Audioରେ Match Content ଚାଲୁ କରନ୍ତୁ।"
          }
        }
      }
    },
    "Turned it off? In Settings, open RetroGuide.TV and turn on Local Network." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Lo desactivaste? En Configuración, abre RetroGuide.TV y activa Red local."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativou? Em Ajustes, abra o RetroGuide.TV e ative Rede Local."
