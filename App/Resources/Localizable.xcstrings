    "Quick Connect isn't working right now (%@). Sign in with your password instead." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quick Connect no funciona en este momento (%@). Inicia sesión con tu contraseña."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Quick Connect não está funcionando agora (%@). Entre com sua senha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quick Connect ne fonctionne pas pour le moment (%@). Connectez-vous plutôt avec votre mot de passe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quick Connect non funziona al momento (%@). Accedi invece con la password."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quick Connect funktioniert gerade nicht (%@). Melde dich stattdessen mit deinem Passwort an."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quick Connect werkt momenteel niet (%@). Log in plaats daarvan in met je wachtwoord."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quick Connect fungerar inte just nu (%@). Logga in med ditt lösenord i stället."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quick Connect teraz nie działa (%@). Zamiast tego zaloguj się hasłem."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quick Connect teď nefunguje (%@). Přihlas se místo toho heslem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quick Connect сейчас не работает (%@). Войдите с паролем."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在Quick Connectを使用できません（%@）。代わりにパスワードでサインインしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 Quick Connect를 사용할 수 없습니다(%@). 대신 암호로 로그인하십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quick Connect 目前无法使用（%@）。请改用密码登录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quick Connect 目前無法使用（%@）。請改用密碼登入。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quick Connect अभी काम नहीं कर रहा (%@)। इसकी जगह अपने पासवर्ड से साइन इन करें।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quick Connect এখন কাজ করছে না (%@)। এর বদলে আপনার পাসওয়ার্ড দিয়ে সাইন ইন করুন।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quick Connect सध्या काम करत नाही (%@). त्याऐवजी तुमच्या पासवर्डने साइन इन करा."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quick Connect இப்போது வேலை செய்யவில்லை (%@). அதற்குப் பதிலாக உங்கள் கடவுச்சொல்லுடன் உள்நுழையவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quick Connect ప్రస్తుతం పనిచేయడం లేదు (%@). బదులుగా మీ పాస్‌వర్డ్‌తో సైన్ ఇన్ చేయండి."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quick Connect અત્યારે કામ કરતું નથી (%@). તેના બદલે તમારા પાસવર્ડથી સાઇન ઇન કરો."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quick Connect ಈಗ ಕೆಲಸ ಮಾಡುತ್ತಿಲ್ಲ (%@). ಬದಲಿಗೆ ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್‌ನೊಂದಿಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quick Connect ഇപ്പോൾ പ്രവർത്തിക്കുന്നില്ല (%@). പകരം പാസ്‌വേഡ് ഉപയോഗിച്ച് സൈൻ ഇൻ ചെയ്യുക."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quick Connect ਇਸ ਵੇਲੇ ਕੰਮ ਨਹੀਂ ਕਰ ਰਿਹਾ (%@)। ਇਸਦੀ ਬਜਾਏ ਆਪਣੇ ਪਾਸਵਰਡ ਨਾਲ ਸਾਈਨ ਇਨ ਕਰੋ।"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quick Connect ଏବେ କାମ କରୁନାହିଁ (%@)। ଏହା ବଦଳରେ ପାସୱାର୍ଡ ସହ ସାଇନ୍ ଇନ୍ କରନ୍ତୁ।"
          }
        }
      }
    },
