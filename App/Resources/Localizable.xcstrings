    "Choose upcoming airings and get a reminder when they start." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige próximas emisiones y recibe un recordatorio cuando empiecen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha próximas exibições e receba um lembrete quando começarem."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez des diffusions à venir et recevez un rappel quand elles commencent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli le prossime messe in onda e ricevi un promemoria quando iniziano."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle kommende Ausstrahlungen und erhalte eine Erinnerung, wenn sie beginnen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies komende uitzendingen en krijg een herinnering wanneer ze beginnen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj kommande sändningar och få en påminnelse när de börjar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybieraj nadchodzące emisje i otrzymuj przypomnienie, gdy się zaczną."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyber nadcházející vysílání a dostaneš připomínku, když začne."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбирайте предстоящие показы и получайте напоминание об их начале."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これから放送される番組を選ぶと、開始時に通知を受け取れます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "예정된 방송을 선택하면 시작할 때 알림을 받을 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择即将播出的节目，开播时会收到提醒。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇即將播出的節目，開播時就會收到提醒。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आने वाले प्रोग्राम चुनें और उनके शुरू होने पर रिमाइंडर पाएँ।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আসন্ন অনুষ্ঠান বেছে নিন এবং শুরু হলে রিমাইন্ডার পান।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आगामी प्रसारणे निवडा आणि ती सुरू झाल्यावर रिमाइंडर मिळवा."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "வரவிருக்கும் ஒளிபரப்புகளைத் தேர்வுசெய்து, அவை தொடங்கும்போது நினைவூட்டலைப் பெறுங்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "రాబోయే ప్రసారాలను ఎంచుకుని, అవి మొదలైనప్పుడు రిమైండర్ పొందండి."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આવનારાં પ્રસારણ પસંદ કરો અને તે શરૂ થાય ત્યારે રિમાઇન્ડર મેળવો."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಮುಂಬರುವ ಪ್ರಸಾರಗಳನ್ನು ಆಯ್ಕೆಮಾಡಿ ಮತ್ತು ಅವು ಆರಂಭವಾದಾಗ ಜ್ಞಾಪನೆ ಪಡೆಯಿರಿ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "വരാനിരിക്കുന്ന പരിപാടികൾ തിരഞ്ഞെടുക്കുക, അവ തുടങ്ങുമ്പോൾ റിമൈൻഡർ നേടുക."
          }
        },
        "pa" : {
