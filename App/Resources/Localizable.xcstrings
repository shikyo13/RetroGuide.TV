        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze server is momenteel niet bereikbaar. De programma’s ervan blijven uit de tv-gids tot hij terug is."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servern kan inte nås just nu. Dess program utelämnas från guiden tills den är tillbaka."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
