    "%@ is open-source software under the MIT License. Video playback uses the following libraries. You can rebuild the app with modified versions of them from the public source code." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ es software de código abierto con licencia MIT. La reproducción de video usa las siguientes bibliotecas. Puedes recompilar la app con versiones modificadas de ellas a partir del código fuente público."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ é um software de código aberto sob a Licença MIT. A reprodução de vídeo usa as bibliotecas a seguir. Você pode recompilar o app com versões modificadas delas a partir do código-fonte público."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est un logiciel open source sous licence MIT. La lecture vidéo utilise les bibliothèques suivantes. Vous pouvez recompiler l'app avec des versions modifiées de celles-ci à partir du code source public."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è un software open source con licenza MIT. La riproduzione video usa le seguenti librerie. Puoi ricompilare l'app con versioni modificate di queste librerie a partire dal codice sorgente pubblico."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist Open-Source-Software unter der MIT-Lizenz. Die Videowiedergabe nutzt die folgenden Bibliotheken. Du kannst die App mit geänderten Versionen davon aus dem öffentlichen Quellcode neu erstellen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is opensourcesoftware onder de MIT-licentie. Voor het afspelen van video worden de volgende bibliotheken gebruikt. Je kunt de app opnieuw bouwen met aangepaste versies ervan op basis van de openbare broncode."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ är programvara med öppen källkod under MIT-licensen. Videouppspelningen använder följande bibliotek. Du kan bygga om appen med ändrade versioner av dem utifrån den öppna källkoden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ to oprogramowanie open source na licencji MIT. Odtwarzanie wideo korzysta z poniższych bibliotek. Możesz zbudować aplikację z ich zmodyfikowanymi wersjami na podstawie publicznego kodu źródłowego."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ je open-source software pod licencí MIT. Přehrávání videa používá následující knihovny. Aplikaci můžeš z veřejného zdrojového kódu sestavit s jejich upravenými verzemi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — программа с открытым исходным кодом по лицензии MIT. Для воспроизведения видео используются следующие библиотеки. Вы можете собрать приложение с их изменёнными версиями из открытого исходного кода."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はMITライセンスのオープンソースソフトウェアです。ビデオ再生には以下のライブラリを使用しています。公開されているソースコードから、これらのライブラリを変更したバージョンでAppを再ビルドできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) MIT 라이선스의 오픈 소스 소프트웨어입니다. 비디오 재생에는 다음 라이브러리를 사용합니다. 공개된 소스 코드로 이 라이브러리의 수정 버전을 사용해 앱을 다시 빌드할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 是基于 MIT 许可证的开源软件。视频播放使用了以下库。你可以用这些库的修改版本，从公开的源代码重新构建此 App。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 是採用 MIT 授權條款的開放原始碼軟體。影片播放使用了下列程式庫。你可以用這些程式庫的修改版本，從公開的原始碼重新建置此 App。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ MIT लाइसेंस के तहत ओपन-सोर्स सॉफ़्टवेयर है। वीडियो प्लेबैक के लिए नीचे दी गई लाइब्रेरी इस्तेमाल होती हैं। आप सार्वजनिक सोर्स कोड से इनके बदले हुए वर्शन के साथ ऐप को फिर से बना सकते हैं।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ MIT লাইসেন্সের অধীনে ওপেন-সোর্স সফটওয়্যার। ভিডিও চালাতে নিচের লাইব্রেরিগুলো ব্যবহার করা হয়। পাবলিক সোর্স কোড থেকে এগুলোর পরিবর্তিত ভার্সন দিয়ে আপনি অ্যাপটি আবার বিল্ড করতে পারেন।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ हे MIT License अंतर्गत ओपन-सोर्स सॉफ्टवेअर आहे. व्हिडिओ प्लेबॅकसाठी खालील लायब्ररी वापरल्या जातात. सार्वजनिक सोर्स कोडमधून त्यांच्या सुधारित आवृत्त्यांसह तुम्ही ॲप पुन्हा बिल्ड करू शकता."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ என்பது MIT உரிமத்தின் கீழ் உள்ள ஓப்பன் சோர்ஸ் மென்பொருள். வீடியோ இயக்கத்திற்கு இது பின்வரும் லைப்ரரிகளைப் பயன்படுத்துகிறது. பொது மூலக் குறியீட்டிலிருந்து, அவற்றின் மாற்றிய பதிப்புகளுடன் இந்த ஆப்பை மீண்டும் உருவாக்கலாம்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ MIT లైసెన్స్ కింద ఓపెన్ సోర్స్ సాఫ్ట్‌వేర్. వీడియో ప్లేబ్యాక్ కింది లైబ్రరీలను ఉపయోగిస్తుంది. పబ్లిక్ సోర్స్ కోడ్ నుండి వాటి మార్చిన వెర్షన్‌లతో మీరు యాప్‌ను మళ్లీ బిల్డ్ చేయవచ్చు."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ MIT લાઇસન્સ હેઠળનું ઓપન-સોર્સ સૉફ્ટવેર છે. વીડિયો પ્લેબૅક નીચેની લાઇબ્રેરીનો ઉપયોગ કરે છે. તમે સાર્વજનિક સોર્સ કોડમાંથી તેનાં બદલેલાં વર્ઝન સાથે ઍપ ફરી બનાવી શકો છો."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ MIT ಲೈಸೆನ್ಸ್ ಅಡಿಯಲ್ಲಿ ಓಪನ್ ಸೋರ್ಸ್ ಸಾಫ್ಟ್‌ವೇರ್ ಆಗಿದೆ. ವೀಡಿಯೊ ಪ್ಲೇಬ್ಯಾಕ್ ಈ ಕೆಳಗಿನ ಲೈಬ್ರರಿಗಳನ್ನು ಬಳಸುತ್ತದೆ. ಸಾರ್ವಜನಿಕ ಸೋರ್ಸ್ ಕೋಡ್‌ನಿಂದ, ಅವುಗಳ ಮಾರ್ಪಡಿಸಿದ ಆವೃತ್ತಿಗಳೊಂದಿಗೆ ನೀವು ಆ್ಯಪ್ ಅನ್ನು ಮರುನಿರ್ಮಿಸಬಹುದು."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, MIT ലൈസൻസിന് കീഴിലുള്ള ഓപ്പൺ സോഴ്സ് സോഫ്റ്റ്‌വെയറാണ്. വീഡിയോ പ്ലേബാക്കിന് താഴെ പറയുന്ന ലൈബ്രറികൾ ഉപയോഗിക്കുന്നു. പൊതു സോഴ്സ് കോഡിൽ നിന്ന് അവയുടെ മാറ്റം വരുത്തിയ പതിപ്പുകൾ ഉപയോഗിച്ച് നിങ്ങൾക്ക് ആപ്പ് വീണ്ടും ബിൽഡ് ചെയ്യാം."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ MIT ਲਾਇਸੈਂਸ ਅਧੀਨ ਓਪਨ-ਸੋਰਸ ਸਾਫ਼ਟਵੇਅਰ ਹੈ। ਵੀਡੀਓ ਪਲੇਬੈਕ ਹੇਠ ਲਿਖੀਆਂ ਲਾਇਬ੍ਰੇਰੀਆਂ ਵਰਤਦਾ ਹੈ। ਤੁਸੀਂ ਜਨਤਕ ਸੋਰਸ ਕੋਡ ਤੋਂ ਇਹਨਾਂ ਦੇ ਸੋਧੇ ਹੋਏ ਵਰਜ਼ਨਾਂ ਨਾਲ ਐਪ ਦੁਬਾਰਾ ਬਣਾ ਸਕਦੇ ਹੋ।"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ MIT ଲାଇସେନ୍ସ ଅଧୀନରେ ଓପନ୍-ସୋର୍ସ ସଫ୍ଟୱେର୍। ଭିଡିଓ ପ୍ଲେବ୍ୟାକ୍ ନିମ୍ନଲିଖିତ ଲାଇବ୍ରେରୀ ବ୍ୟବହାର କରେ। ସାର୍ବଜନୀନ ସୋର୍ସ କୋଡ୍‌ରୁ ସେଗୁଡ଼ିକର ପରିବର୍ତ୍ତିତ ସଂସ୍କରଣ ସହ ଆପଣ ଆପ୍‌ଟି ପୁଣି ତିଆରି କରିପାରିବେ।"
          }
        }
      }
    },
    "%@ is removed from %@. Settings › Channels › Removed from channels lists everything you've removed." : {
