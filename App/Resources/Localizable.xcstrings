        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe doppelt für die Steuerung. Wische nach oben oder unten, um den Kanal zu wechseln."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik twee keer voor bediening. Veeg omhoog of omlaag om van zender te wisselen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dubbeltryck för reglage. Svep uppåt eller nedåt för att byta kanal."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij dwukrotnie, aby pokazać sterowanie. Przesuń w górę lub w dół, aby zmienić kanał."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dvojím klepnutím zobrazíš ovládání. Přejetím nahoru nebo dolů přepneš kanál."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коснитесь дважды, чтобы открыть элементы управления. Смахните вверх или вниз, чтобы переключить канал."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダブルタップで操作を表示。上下にスワイプしてチャンネルを変更します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이중 탭하여 조작 버튼을 표시합니다. 위아래로 쓸어넘겨 채널을 변경합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点两下显示控制。向上或向下轻扫以转台。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點兩下顯示控制項目。上下滑動以轉台。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कंट्रोल के लिए डबल-टैप करें। चैनल बदलने के लिए ऊपर या नीचे स्वाइप करें।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কন্ট্রোলের জন্য ডাবল-ট্যাপ করুন। চ্যানেল বদলাতে উপরে বা নিচে সোয়াইপ করুন।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नियंत्रणांसाठी डबल-टॅप करा. चॅनेल बदलण्यासाठी वर किंवा खाली स्वाइप करा."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "கட்டுப்பாடுகளுக்கு இருமுறை தட்டவும். சேனலை மாற்ற மேலே அல்லது கீழே ஸ்வைப் செய்யவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "కంట్రోల్స్ కోసం రెండుసార్లు ట్యాప్ చేయండి. ఛానెల్ మార్చడానికి పైకి లేదా కిందికి స్వైప్ చేయండి."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "કંટ્રોલ માટે ડબલ-ટૅપ કરો. ચેનલ બદલવા ઉપર કે નીચે સ્વાઇપ કરો."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಿಯಂತ್ರಣಗಳಿಗಾಗಿ ಡಬಲ್-ಟ್ಯಾಪ್ ಮಾಡಿ. ಚಾನಲ್ ಬದಲಿಸಲು ಮೇಲೆ ಅಥವಾ ಕೆಳಗೆ ಸ್ವೈಪ್ ಮಾಡಿ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിയന്ത്രണങ്ങൾക്ക് ഡബിൾ-ടാപ്പ് ചെയ്യുക. ചാനൽ മാറ്റാൻ മുകളിലേക്കോ താഴേക്കോ സ്വൈപ്പ് ചെയ്യുക."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਕੰਟਰੋਲਾਂ ਲਈ ਡਬਲ-ਟੈਪ ਕਰੋ। ਚੈਨਲ ਬਦਲਣ ਲਈ ਉੱਪਰ ਜਾਂ ਹੇਠਾਂ ਸਵਾਈਪ ਕਰੋ।"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ନିୟନ୍ତ୍ରଣ ପାଇଁ ଦୁଇଥର ଟାପ୍ କରନ୍ତୁ। ଚ୍ୟାନେଲ ବଦଳାଇବାକୁ ଉପରକୁ ବା ତଳକୁ ସ୍ୱାଇପ୍ କରନ୍ତୁ।"
          }
        }
      }
    },
