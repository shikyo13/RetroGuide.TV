    "Double-tap for controls. Swipe up or down to change channel." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca dos veces para ver los controles. Desliza hacia arriba o abajo para cambiar de canal."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
