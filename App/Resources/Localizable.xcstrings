    "Restore automatic-channel defaults. Keep custom-channel orders." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restaura los valores predeterminados de los canales automáticos. Conserva el orden de los canales personalizados."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restaura os padrões dos canais automáticos. Mantém a ordem dos canais personalizados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rétablir les valeurs par défaut des chaînes automatiques. Conserver l'ordre des chaînes personnalisées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ripristina i valori predefiniti dei canali automatici. Mantieni l'ordine dei canali personalizzati."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standards für automatische Kanäle wiederherstellen. Reihenfolge eigener Kanäle beibehalten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herstel standaardinstellingen voor automatische zenders. Behoud de volgorde van eigen zenders."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Återställ standard för automatiska kanaler. Behåll ordningen för egna kanaler."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przywróć domyślne ustawienia kanałów automatycznych. Zachowaj kolejność kanałów własnych."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obnoví výchozí hodnoty automatických kanálů. Pořadí vlastních kanálů zůstane."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Восстановить стандартный порядок автоматических каналов. Порядок своих каналов сохранится."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動チャンネルをデフォルトに戻し、カスタムチャンネルの放送順は維持します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동 채널은 기본값으로 복원하고 사용자 지정 채널 순서는 유지합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "恢复自动频道的默认设置。保留自定频道的顺序。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回復自動頻道的預設值。保留自訂頻道的順序。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऑटोमैटिक चैनलों का डिफ़ॉल्ट वापस लाएँ। कस्टम चैनलों का क्रम बना रहेगा।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "স্বয়ংক্রিয় চ্যানেলের ডিফল্ট ফিরিয়ে আনুন। কাস্টম চ্যানেলের ক্রম থেকে যাবে।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऑटोमॅटिक चॅनेलची डीफॉल्ट सेटिंग्ज परत आणा. कस्टम चॅनेलचे क्रम तसेच ठेवा."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "தானியங்குச் சேனல்களின் இயல்புநிலையை மீட்டமைக்கும். தனிப்பயன் சேனல்களின் வரிசைகள் அப்படியே இருக்கும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఆటోమేటిక్-ఛానెల్ డిఫాల్ట్‌లను పునరుద్ధరించండి. కస్టమ్-ఛానెల్ క్రమాలను అలాగే ఉంచండి."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ઑટોમેટિક ચેનલોના ડિફૉલ્ટ પાછા લાવો. કસ્ટમ ચેનલોના ક્રમ યથાવત્ રાખો."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಸ್ವಯಂಚಾಲಿತ ಚಾನಲ್‌ಗಳ ಡೀಫಾಲ್ಟ್‌ಗಳನ್ನು ಮರುಸ್ಥಾಪಿಸಿ. ಕಸ್ಟಮ್ ಚಾನಲ್‌ಗಳ ಕ್ರಮ ಹಾಗೆಯೇ ಇರುತ್ತದೆ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഓട്ടോമാറ്റിക് ചാനലുകളുടെ ഡിഫോൾട്ട് പുനഃസ്ഥാപിക്കുക. ഇഷ്ടാനുസൃത ചാനലുകളുടെ ക്രമം നിലനിർത്തുക."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਆਟੋਮੈਟਿਕ ਚੈਨਲਾਂ ਦੇ ਡਿਫ਼ਾਲਟ ਬਹਾਲ ਕਰੋ। ਕਸਟਮ ਚੈਨਲਾਂ ਦੇ ਕ੍ਰਮ ਬਣੇ ਰਹਿਣਗੇ।"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ସ୍ୱୟଂଚାଳିତ ଚ୍ୟାନେଲର ଡିଫଲ୍ଟ ଫେରାନ୍ତୁ। କଷ୍ଟମ୍ ଚ୍ୟାନେଲର କ୍ରମ ରଖନ୍ତୁ।"
          }
        }
      }
    },
