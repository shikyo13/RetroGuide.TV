    "Pick each channel's order and start programs on the hour and half hour." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige el orden de cada canal y empieza los programas en punto y a la media."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha a ordem de cada canal e comece os programas na hora cheia e na meia hora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez l'ordre de chaque chaîne et lancez les programmes à l'heure et à la demie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli l'ordine di ogni canale e fai iniziare i programmi all'ora e alla mezz'ora."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege die Reihenfolge jedes Kanals fest und starte Sendungen zur vollen und halben Stunde."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies de volgorde van elke zender en laat programma’s beginnen op het hele en halve uur."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj varje kanals ordning och starta program på hel- och halvtimme."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybieraj kolejność dla każdego kanału i zaczynaj programy o pełnej godzinie i wpół do."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvol pořadí každého kanálu a začínej pořady v celou a v půl."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задавайте порядок для каждого канала и начинайте передачи в начале часа и в половине."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チャンネルごとに放送順を選び、番組を毎時0分と30分に開始できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "채널별 편성 순서를 고르고 프로그램을 정시와 30분에 시작할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为每个频道选择播放顺序，并让节目在整点和半点开始。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為每個頻道選擇播放順序，並讓節目在整點和半點開始。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर चैनल का क्रम चुनें और प्रोग्राम हर घंटे और आधे घंटे पर शुरू करें।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্রতিটি চ্যানেলের ক্রম বেছে নিন এবং অনুষ্ঠান শুরু করুন ঘণ্টায় ও আধঘণ্টায়।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रत्येक चॅनेलचा क्रम निवडा आणि कार्यक्रम पूर्ण तासाला व अर्ध्या तासाला सुरू करा."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஒவ்வொரு சேனலின் வரிசையையும் தேர்வுசெய்து, நிகழ்ச்சிகளை மணி, அரை மணி நேரத்தில் தொடங்கச் செய்யலாம்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ప్రతి ఛానెల్ క్రమాన్ని ఎంచుకోండి, ప్రోగ్రామ్‌లను గంటకు, అరగంటకు మొదలుపెట్టండి."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "દરેક ચેનલનો ક્રમ પસંદ કરો અને પ્રોગ્રામ પૂરા કલાકે અને અડધા કલાકે શરૂ કરો."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಪ್ರತಿ ಚಾನಲ್‌ನ ಕ್ರಮವನ್ನು ಆಯ್ಕೆಮಾಡಿ ಮತ್ತು ಕಾರ್ಯಕ್ರಮಗಳನ್ನು ಗಂಟೆ ಮತ್ತು ಅರ್ಧ ಗಂಟೆಗೆ ಆರಂಭಿಸಿ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഓരോ ചാനലിന്റെയും ക്രമം തിരഞ്ഞെടുക്കുക, പരിപാടികൾ കൃത്യം മണിക്കൂറിലും അര മണിക്കൂറിലും തുടങ്ങുക."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਹਰ ਚੈਨਲ ਦਾ ਕ੍ਰਮ ਚੁਣੋ ਅਤੇ ਪ੍ਰੋਗਰਾਮ ਪੂਰੇ ਅਤੇ ਅੱਧੇ ਘੰਟੇ 'ਤੇ ਸ਼ੁਰੂ ਕਰੋ।"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ପ୍ରତ୍ୟେକ ଚ୍ୟାନେଲର କ୍ରମ ବାଛନ୍ତୁ ଏବଂ କାର୍ଯ୍ୟକ୍ରମକୁ ଘଣ୍ଟା ଓ ଅଧ ଘଣ୍ଟାରେ ଆରମ୍ଭ କରନ୍ତୁ।"
          }
        }
      }
    },
