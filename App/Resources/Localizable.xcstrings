    "Stops video, audio and Picture in Picture. Changing channels keeps the chosen stop time." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detiene el video, el audio e Imagen dentro de imagen. Al cambiar de canal se mantiene la hora de detención elegida."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para o vídeo, o áudio e o Picture in Picture. Trocar de canal mantém o horário de parada escolhido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrête la vidéo, l'audio et Image dans l'image. Changer de chaîne conserve l'heure d'arrêt choisie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ferma video, audio e Picture in Picture. Se cambi canale, l'orario di stop scelto resta valido."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stoppt Video, Audio und Bild-in-Bild. Beim Kanalwechsel bleibt die gewählte Stoppzeit erhalten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stopt video, audio en beeld-in-beeld. Bij het zappen blijft de gekozen stoptijd behouden."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stoppar video, ljud och Bild-i-bild. Den valda stopptiden behålls när du byter kanal."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatrzymuje wideo, dźwięk i Obraz w obrazie. Zmiana kanału nie zmienia wybranej godziny zatrzymania."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zastaví video, zvuk i Obraz v obraze. Přepnutím kanálu se zvolený čas zastavení nezmění."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Останавливает видео, аудио и режим «Картинка в картинке». При переключении каналов время остановки сохраняется."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビデオ、オーディオ、ピクチャ・イン・ピクチャを停止します。チャンネルを変えても、選んだ停止時刻は維持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비디오, 오디오 및 PIP를 중지합니다. 채널을 바꿔도 선택한 중지 시간은 유지됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止视频、音频和画中画。转台时会保留所选的停止时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止影片、音訊和子母畫面。轉台時會保留所選的停止時間。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वीडियो, ऑडियो और पिक्चर इन पिक्चर रोकता है। चैनल बदलने पर भी चुना गया रुकने का समय बना रहता है।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ভিডিও, অডিও ও পিকচার ইন পিকচার থামায়। চ্যানেল বদলালেও বেছে নেওয়া থামার সময় বজায় থাকে।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "व्हिडिओ, ऑडिओ आणि पिक्चर इन पिक्चर थांबवते. चॅनेल बदलले तरी निवडलेली थांबण्याची वेळ कायम राहते."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "வீடியோ, ஆடியோ, பிக்சர் இன் பிக்சர் ஆகியவற்றை நிறுத்தும். சேனலை மாற்றினாலும் தேர்ந்தெடுத்த நிறுத்த நேரம் அப்படியே இருக்கும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "వీడియో, ఆడియో, పిక్చర్ ఇన్ పిక్చర్‌ను ఆపుతుంది. ఛానెల్‌లు మార్చినా ఎంచుకున్న ఆపే సమయం అలాగే ఉంటుంది."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "વીડિયો, ઑડિયો અને પિક્ચર ઇન પિક્ચર બંધ કરે છે. ચેનલ બદલવાથી પસંદ કરેલો બંધ થવાનો સમય બદલાતો નથી."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ವೀಡಿಯೊ, ಆಡಿಯೋ ಮತ್ತು ಪಿಕ್ಚರ್ ಇನ್ ಪಿಕ್ಚರ್ ನಿಲ್ಲಿಸುತ್ತದೆ. ಚಾನಲ್ ಬದಲಿಸಿದರೂ ಆಯ್ದ ನಿಲುಗಡೆ ಸಮಯ ಉಳಿಯುತ್ತದೆ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "വീഡിയോ, ഓഡിയോ, പിക്ചർ ഇൻ പിക്ചർ എന്നിവ നിർത്തുന്നു. ചാനൽ മാറ്റിയാലും തിരഞ്ഞെടുത്ത നിർത്തൽ സമയം മാറില്ല."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਵੀਡੀਓ, ਆਡੀਓ ਅਤੇ ਪਿਕਚਰ ਇਨ ਪਿਕਚਰ ਰੋਕਦਾ ਹੈ। ਚੈਨਲ ਬਦਲਣ 'ਤੇ ਚੁਣਿਆ ਹੋਇਆ ਰੁਕਣ ਦਾ ਸਮਾਂ ਬਣਿਆ ਰਹਿੰਦਾ ਹੈ।"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଭିଡିଓ, ଅଡିଓ ଓ ପିକଚର୍ ଇନ୍ ପିକଚର୍ ବନ୍ଦ କରେ। ଚ୍ୟାନେଲ ବଦଳାଇଲେ ବି ବଛା ବନ୍ଦ ସମୟ ରହେ।"
          }
        }
      }
    },
