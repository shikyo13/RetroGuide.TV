    "This server can't be reached right now. Its programs are left out of the guide until it's back." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede acceder a este servidor en este momento. Sus programas no aparecen en la guía hasta que vuelva."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível acessar este servidor agora. Os programas dele ficam fora do guia até ele voltar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce serveur est injoignable pour le moment. Ses programmes sont retirés du guide jusqu'à son retour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo server non è raggiungibile al momento. I suoi programmi restano fuori dalla guida finché non torna disponibile."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Server ist gerade nicht erreichbar. Seine Sendungen fehlen im TV-Programm, bis er wieder da ist."
