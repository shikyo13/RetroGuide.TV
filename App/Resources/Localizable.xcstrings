          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez deux fois pour les commandes. Balayez vers le haut ou le bas pour changer de chaîne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
