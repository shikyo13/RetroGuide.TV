    "Use a separate library containing only commercials. Selected libraries are used only for commercials and are excluded from regular channels." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa una biblioteca aparte que solo contenga anuncios. Las bibliotecas seleccionadas se usan solo para anuncios y se excluyen de los canales normales."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use uma biblioteca separada só com comerciais. As bibliotecas selecionadas são usadas apenas para comerciais e ficam fora dos canais normais."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez une bibliothèque distincte ne contenant que des pubs. Les bibliothèques sélectionnées servent uniquement aux pubs et sont exclues des chaînes habituelles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa una libreria separata che contenga solo pubblicità. Le librerie selezionate vengono usate solo per gli spot e sono escluse dai canali normali."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende eine separate Bibliothek, die nur Werbespots enthält. Ausgewählte Bibliotheken werden nur für Werbung verwendet und von regulären Kanälen ausgeschlossen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik een aparte bibliotheek met alleen reclames. Geselecteerde bibliotheken worden alleen voor reclames gebruikt en uitgesloten van gewone zenders."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Använd ett separat bibliotek som bara innehåller reklamfilmer. Valda bibliotek används bara för reklam och utesluts från vanliga kanaler."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Użyj osobnej biblioteki zawierającej tylko reklamy. Wybrane biblioteki służą tylko do reklam i są wykluczone ze zwykłych kanałów."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Použij samostatnou knihovnu, která obsahuje jen reklamy. Vybrané knihovny se použijí jen pro reklamy a z běžných kanálů se vynechají."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте отдельную медиатеку, содержащую только рекламу. Выбранные медиатеки используются только для рекламы и исключаются из обычных каналов."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CMだけを含む別のライブラリを使用してください。選択したライブラリはCM専用になり、通常のチャンネルからは除外されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "광고만 들어 있는 별도의 라이브러리를 사용하십시오. 선택한 라이브러리는 광고에만 사용되며 일반 채널에서는 제외됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用一个只包含广告片的独立媒体库。所选媒体库仅用于广告片，不会出现在常规频道中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用一個只包含廣告片的獨立媒體庫。已選媒體庫只會用於廣告片，不會出現在一般頻道中。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक अलग लाइब्रेरी इस्तेमाल करें जिसमें सिर्फ़ विज्ञापन हों। चुनी गई लाइब्रेरी सिर्फ़ विज्ञापनों के लिए इस्तेमाल होती हैं और सामान्य चैनलों में शामिल नहीं होतीं।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শুধু বিজ্ঞাপন আছে এমন একটি আলাদা লাইব্রেরি ব্যবহার করুন। বাছাই করা লাইব্রেরি শুধু বিজ্ঞাপনের জন্য ব্যবহার হয় এবং সাধারণ চ্যানেলে থাকে না।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फक्त जाहिराती असलेली वेगळी लायब्ररी वापरा. निवडलेल्या लायब्ररी फक्त जाहिरातींसाठी वापरल्या जातात आणि नेहमीच्या चॅनेलमधून वगळल्या जातात."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "விளம்பரங்கள் மட்டும் உள்ள தனி லைப்ரரியைப் பயன்படுத்தவும். தேர்ந்தெடுத்த லைப்ரரிகள் விளம்பரங்களுக்கு மட்டுமே பயன்படும், வழக்கமான சேனல்களில் சேராது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "కేవలం కమర్షియల్స్ ఉన్న ప్రత్యేక లైబ్రరీని ఉపయోగించండి. ఎంచుకున్న లైబ్రరీలు కమర్షియల్స్ కోసం మాత్రమే ఉపయోగించబడతాయి, సాధారణ ఛానెల్‌ల నుండి మినహాయించబడతాయి."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "માત્ર જાહેરાતોવાળી અલગ લાઇબ્રેરી વાપરો. પસંદ કરેલી લાઇબ્રેરી માત્ર જાહેરાતો માટે વપરાય છે અને સામાન્ય ચેનલોમાંથી બાકાત રહે છે."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಜಾಹೀರಾತುಗಳನ್ನು ಮಾತ್ರ ಹೊಂದಿರುವ ಪ್ರತ್ಯೇಕ ಲೈಬ್ರರಿ ಬಳಸಿ. ಆಯ್ದ ಲೈಬ್ರರಿಗಳನ್ನು ಜಾಹೀರಾತುಗಳಿಗೆ ಮಾತ್ರ ಬಳಸಲಾಗುತ್ತದೆ ಮತ್ತು ಸಾಮಾನ್ಯ ಚಾನಲ್‌ಗಳಿಂದ ಹೊರಗಿಡಲಾಗುತ್ತದೆ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "പരസ്യങ്ങൾ മാത്രമുള്ള ഒരു പ്രത്യേക ലൈബ്രറി ഉപയോഗിക്കുക. തിരഞ്ഞെടുത്ത ലൈബ്രറികൾ പരസ്യങ്ങൾക്ക് മാത്രം ഉപയോഗിക്കും, സാധാരണ ചാനലുകളിൽ നിന്ന് ഒഴിവാക്കും."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਸਿਰਫ਼ ਕਮਰਸ਼ੀਅਲਾਂ ਵਾਲੀ ਵੱਖਰੀ ਲਾਇਬ੍ਰੇਰੀ ਵਰਤੋ। ਚੁਣੀਆਂ ਲਾਇਬ੍ਰੇਰੀਆਂ ਸਿਰਫ਼ ਕਮਰਸ਼ੀਅਲਾਂ ਲਈ ਵਰਤੀਆਂ ਜਾਂਦੀਆਂ ਹਨ ਅਤੇ ਆਮ ਚੈਨਲਾਂ ਤੋਂ ਬਾਹਰ ਰੱਖੀਆਂ ਜਾਂਦੀਆਂ ਹਨ।"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "କେବଳ ବିଜ୍ଞାପନ ଥିବା ଏକ ଅଲଗା ଲାଇବ୍ରେରୀ ବ୍ୟବହାର କରନ୍ତୁ। ବଛା ଲାଇବ୍ରେରୀ କେବଳ ବିଜ୍ଞାପନ ପାଇଁ ବ୍ୟବହୃତ ହୁଏ ଏବଂ ସାଧାରଣ ଚ୍ୟାନେଲରୁ ବାଦ୍ ପଡ଼େ।"
          }
        }
      }
    },
