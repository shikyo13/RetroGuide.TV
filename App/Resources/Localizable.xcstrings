          "stringUnit" : {
            "state" : "translated",
            "value" : "Remover %1$@ (%2$@)? Os programas dele sairão de todos os canais."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retirer %1$@ (%2$@) ? Ses programmes quitteront toutes les chaînes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuovere %1$@ (%2$@)? I suoi programmi spariranno da tutti i canali."
