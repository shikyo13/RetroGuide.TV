    "Uses the home address at home or over a VPN, and the internet address elsewhere." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa la dirección local en casa o por VPN, y la dirección de internet en otros lugares."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa o endereço local em casa ou por VPN, e o endereço de internet em outros lugares."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise l'adresse locale à la maison ou via un VPN, et l'adresse Internet ailleurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa l'indirizzo di casa quando sei a casa o in VPN, e l'indirizzo Internet altrove."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutzt zu Hause oder über VPN die Heimadresse und unterwegs die Internetadresse."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruikt thuis of via VPN het thuisadres, en elders het internetadres."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Använder hemadressen hemma eller via VPN och internetadressen på andra platser."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W domu lub przez VPN używa adresu domowego, a gdzie indziej adresu internetowego."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doma nebo přes VPN použije domácí adresu, jinde internetovou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Домашний адрес — дома или через VPN, интернет-адрес — в остальных случаях."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自宅やVPN経由では自宅用アドレスを、それ以外ではインターネットアドレスを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "집이나 VPN에서는 홈 주소를, 그 외에는 인터넷 주소를 사용합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在家或使用 VPN 时使用家庭地址，在其他地方使用互联网地址。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在家或使用 VPN 時使用家用位址，在其他地方使用網際網路位址。"
          }
        }
      }
    },
