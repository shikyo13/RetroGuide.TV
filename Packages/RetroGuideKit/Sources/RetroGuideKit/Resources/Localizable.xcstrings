          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa sempre a saída normal da Apple TV. Programas em HDR são convertidos para faixa padrão."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise toujours la sortie habituelle de l'Apple TV. Les programmes HDR sont convertis en plage standard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa sempre l'uscita abituale di Apple TV. I programmi HDR vengono convertiti in gamma standard."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Immer die übliche Ausgabe des Apple TV verwenden. HDR-Sendungen werden in den Standardbereich umgewandelt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik altijd de gewone uitvoer van de Apple TV. HDR-programma’s worden omgezet naar standaardbereik."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Använd alltid Apple TV:ns vanliga utsignal. HDR-program konverteras till standardomfång."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zawsze używa zwykłego wyjścia Apple TV. Programy HDR są konwertowane do standardowego zakresu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vždy použije běžný výstup Apple TV. Pořady v HDR se převedou na standardní rozsah."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всегда использовать обычный вывод Apple TV. Передачи в HDR преобразуются в стандартный диапазон."
          }
        },
        "ja" : {
          "stringUnit" : {
