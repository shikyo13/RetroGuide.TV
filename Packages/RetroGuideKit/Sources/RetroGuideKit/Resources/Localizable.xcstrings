    "Skips 4K copies when a 1080p or smaller copy exists. Good for most remote servers." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omite las copias 4K si hay una copia de 1080p o menor. Útil para la mayoría de los servidores remotos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ignora cópias 4K quando existe uma cópia de 1080p ou menor. Bom para a maioria dos servidores remotos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ignore les copies 4K si une copie en 1080p ou moins existe. Adapté à la plupart des serveurs distants."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salta le copie 4K se esiste una copia a 1080p o inferiore. Adatto alla maggior parte dei server remoti."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überspringt 4K-Kopien, wenn eine Kopie mit 1080p oder kleiner vorhanden ist. Gut für die meisten entfernten Server."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slaat 4K-kopieën over als er een kopie van 1080p of kleiner is. Goed voor de meeste externe servers."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoppar över 4K-kopior när det finns en kopia i 1080p eller mindre. Bra för de flesta fjärrservrar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomija kopie 4K, gdy istnieje kopia 1080p lub mniejsza. Dobre dla większości serwerów zdalnych."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přeskočí kopie ve 4K, pokud existuje kopie v 1080p nebo menší. Vhodné pro většinu vzdálených serverů."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пропускает копии 4K, если есть копия 1080p или меньше. Подходит для большинства удалённых серверов."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1080p以下のバージョンがある場合は4Kを使いません。ほとんどのリモートサーバに適しています。"
          }
        },
