    "Every episode of a show in order, then the next show." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los episodios de una serie en orden y luego la siguiente serie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os episódios de uma série em ordem e depois a próxima série."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les épisodes d'une série dans l'ordre, puis la série suivante."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutti gli episodi di una serie in ordine, poi la serie successiva."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Folgen einer Serie der Reihe nach, dann die nächste Serie."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke aflevering van een serie op volgorde, daarna de volgende serie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla avsnitt av en serie i ordning, sedan nästa serie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystkie odcinki serialu po kolei, potem następny serial."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všechny díly pořadu popořadě, pak další pořad."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все эпизоды сериала по порядку, затем следующий сериал."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1つの番組の全エピソードを順番に放送してから、次の番組に移ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 프로그램의 모든 에피소드를 순서대로 방송한 뒤 다음 프로그램으로 넘어갑니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按顺序播完一部剧的所有集，再播下一部。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依序播完一部影集的所有集數，再播下一部。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक शो के सारे एपिसोड क्रम से, फिर अगला शो।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একটি শো-এর সব পর্ব ক্রমানুসারে, তারপর পরের শো।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एका शोचे सर्व भाग क्रमाने, मग पुढचा शो."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஒரு நிகழ்ச்சியின் எல்லா எபிசோடுகளும் வரிசையாக, பிறகு அடுத்த நிகழ்ச்சி."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఒక షోలోని ప్రతి ఎపిసోడ్ వరుసగా, ఆ తర్వాత తదుపరి షో."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "એક શોના બધા એપિસોડ ક્રમમાં, પછી આગલો શો."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಒಂದು ಶೋನ ಎಲ್ಲಾ ಎಪಿಸೋಡ್‌ಗಳು ಕ್ರಮವಾಗಿ, ನಂತರ ಮುಂದಿನ ಶೋ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഒരു ഷോയുടെ എല്ലാ എപ്പിസോഡുകളും ക്രമത്തിൽ, പിന്നെ അടുത്ത ഷോ."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਇੱਕ ਸ਼ੋਅ ਦੇ ਸਾਰੇ ਐਪੀਸੋਡ ਕ੍ਰਮ ਵਿੱਚ, ਫਿਰ ਅਗਲਾ ਸ਼ੋਅ।"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଗୋଟିଏ ଶୋ'ର ସବୁ ଏପିସୋଡ୍ କ୍ରମରେ, ତା'ପରେ ପରବର୍ତ୍ତୀ ଶୋ।"
          }
        }
      }
    },
