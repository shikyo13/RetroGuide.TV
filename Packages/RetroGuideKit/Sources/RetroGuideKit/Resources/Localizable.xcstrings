    "Skips 4K copies when a 1080p or smaller copy exists. Good for most remote servers." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omite las copias 4K si hay una copia de 1080p o menor. Útil para la mayoría de los servidores remotos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ignora cópias 4K quando existe uma cópia de 1080p ou menor. Bom para a maioria dos servidores remotos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ignore les copies 4K si une copie en 1080p ou moins existe. Adapté à la plupart des serveurs distants."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salta le copie 4K se esiste una copia a 1080p o inferiore. Adatto alla maggior parte dei server remoti."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überspringt 4K-Kopien, wenn eine Kopie mit 1080p oder kleiner vorhanden ist. Gut für die meisten entfernten Server."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slaat 4K-kopieën over als er een kopie van 1080p of kleiner is. Goed voor de meeste externe servers."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoppar över 4K-kopior när det finns en kopia i 1080p eller mindre. Bra för de flesta fjärrservrar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomija kopie 4K, gdy istnieje kopia 1080p lub mniejsza. Dobre dla większości serwerów zdalnych."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přeskočí kopie ve 4K, pokud existuje kopie v 1080p nebo menší. Vhodné pro většinu vzdálených serverů."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пропускает копии 4K, если есть копия 1080p или меньше. Подходит для большинства удалённых серверов."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1080p以下のバージョンがある場合は4Kを使いません。ほとんどのリモートサーバに適しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1080p 이하 버전이 있으면 4K 버전을 건너뜁니다. 대부분의 원격 서버에 적합합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "存在 1080p 或更小的版本时跳过 4K 版本。适用于大多数远程服务器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有 1080p 或更小的版本時略過 4K 版本。適用於大多數遠端伺服器。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1080p या उससे छोटी कॉपी होने पर 4K कॉपी छोड़ देता है। ज़्यादातर दूर के सर्वर के लिए अच्छा।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1080p বা তার ছোট কপি থাকলে 4K কপি বাদ দেয়। বেশিরভাগ দূরের সার্ভারের জন্য ভালো।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1080p किंवा लहान प्रत असल्यास 4K प्रती वगळते. बहुतेक दूरच्या सर्व्हरसाठी चांगले."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1080p அல்லது சிறிய பிரதி இருந்தால் 4K பிரதிகளைத் தவிர்க்கும். பெரும்பாலான தொலை சர்வர்களுக்கு ஏற்றது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1080p లేదా చిన్న కాపీ ఉన్నప్పుడు 4K కాపీలను వదిలేస్తుంది. చాలా రిమోట్ సర్వర్‌లకు అనుకూలం."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1080p કે તેથી નાની કૉપી હોય ત્યારે 4K કૉપી છોડી દે છે. મોટા ભાગના દૂરના સર્વર માટે સારું."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1080p ಅಥವಾ ಚಿಕ್ಕ ಪ್ರತಿ ಇದ್ದಾಗ 4K ಪ್ರತಿಗಳನ್ನು ಬಿಟ್ಟುಬಿಡುತ್ತದೆ. ಹೆಚ್ಚಿನ ದೂರದ ಸರ್ವರ್‌ಗಳಿಗೆ ಸೂಕ್ತ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1080p-യോ അതിൽ ചെറുതോ ആയ പകർപ്പുണ്ടെങ്കിൽ 4K പകർപ്പുകൾ ഒഴിവാക്കുന്നു. ദൂരെയുള്ള മിക്ക സെർവറുകൾക്കും അനുയോജ്യം."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1080p ਜਾਂ ਛੋਟੀ ਕਾਪੀ ਮੌਜੂਦ ਹੋਣ 'ਤੇ 4K ਕਾਪੀਆਂ ਛੱਡ ਦਿੰਦਾ ਹੈ। ਜ਼ਿਆਦਾਤਰ ਦੂਰ ਦੇ ਸਰਵਰਾਂ ਲਈ ਵਧੀਆ।"
          }
        },
        "or" : {
          "stringUnit" : {
