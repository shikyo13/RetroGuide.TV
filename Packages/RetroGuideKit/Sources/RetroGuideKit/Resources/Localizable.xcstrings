        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सर्वर का पता सही नहीं है।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সার্ভারের ঠিকানাটি সঠিক নয়।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सर्व्हरचा पत्ता वैध नाही."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "சர்வர் முகவரி சரியானது அல்ல."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "సర్వర్ అడ్రస్ చెల్లుబాటు కాదు."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "સર્વરનું સરનામું માન્ય નથી."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಸರ್ವರ್ ವಿಳಾಸ ಮಾನ್ಯವಾಗಿಲ್ಲ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "സെർവർ വിലാസം സാധുവല്ല."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਸਰਵਰ ਦਾ ਪਤਾ ਵੈਧ ਨਹੀਂ ਹੈ।"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ସର୍ଭର ଠିକଣା ବୈଧ ନୁହେଁ।"
          }
        }
      }
    },
    "The server can't play this title. Its files may have been moved or deleted." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor no puede reproducir este título. Puede que sus archivos se hayan movido o eliminado."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O servidor não consegue reproduzir este título. Os arquivos podem ter sido movidos ou apagados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur ne peut pas lire ce titre. Ses fichiers ont peut-être été déplacés ou supprimés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server non può riprodurre questo titolo. I suoi file potrebbero essere stati spostati o eliminati."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server kann diesen Titel nicht abspielen. Die Dateien wurden eventuell verschoben oder gelöscht."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De server kan deze titel niet afspelen. De bestanden zijn mogelijk verplaatst of verwijderd."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servern kan inte spela upp den här titeln. Filerna kan ha flyttats eller raderats."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serwer nie może odtworzyć tego tytułu. Jego pliki mogły zostać przeniesione lub usunięte."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server tento titul nemůže přehrát. Jeho soubory mohly být přesunuty nebo smazány."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервер не может воспроизвести это. Возможно, файлы были перемещены или удалены."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバでこのタイトルを再生できません。ファイルが移動または削除された可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버에서 이 항목을 재생할 수 없습니다. 파일이 이동되었거나 삭제되었을 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器无法播放此内容。其文件可能已被移动或删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "伺服器無法播放此內容。其檔案可能已被移動或刪除。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सर्वर यह टाइटल नहीं चला सकता। इसकी फ़ाइलें शायद हटा दी गई हैं या कहीं और ले जाई गई हैं।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সার্ভার এই টাইটেলটি চালাতে পারছে না। এর ফাইল হয়তো সরানো বা মুছে ফেলা হয়েছে।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सर्व्हर हे शीर्षक प्ले करू शकत नाही. त्याच्या फाइल्स हलवल्या किंवा हटवल्या गेल्या असू शकतात."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இந்தத் தலைப்பைச் சர்வரால் இயக்க முடியவில்லை. அதன் கோப்புகள் நகர்த்தப்பட்டிருக்கலாம் அல்லது நீக்கப்பட்டிருக்கலாம்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "సర్వర్ ఈ టైటిల్‌ను ప్లే చేయలేదు. దాని ఫైల్‌లు తరలించబడి లేదా తొలగించబడి ఉండవచ్చు."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "સર્વર આ ટાઇટલ ચલાવી શકતું નથી. તેની ફાઇલો ખસેડાઈ કે ડિલીટ થઈ ગઈ હોઈ શકે."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಸರ್ವರ್‌ಗೆ ಈ ಶೀರ್ಷಿಕೆಯನ್ನು ಪ್ಲೇ ಮಾಡಲು ಸಾಧ್ಯವಿಲ್ಲ. ಇದರ ಫೈಲ್‌ಗಳನ್ನು ಸರಿಸಿರಬಹುದು ಅಥವಾ ಅಳಿಸಿರಬಹುದು."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "സെർവറിന് ഈ ടൈറ്റിൽ പ്ലേ ചെയ്യാനാകില്ല. ഇതിന്റെ ഫയലുകൾ നീക്കുകയോ ഡിലീറ്റ് ചെയ്യുകയോ ചെയ്തിരിക്കാം."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਸਰਵਰ ਇਸ ਟਾਈਟਲ ਨੂੰ ਨਹੀਂ ਚਲਾ ਸਕਦਾ। ਹੋ ਸਕਦਾ ਹੈ ਇਸ ਦੀਆਂ ਫ਼ਾਈਲਾਂ ਹਿਲਾਈਆਂ ਜਾਂ ਮਿਟਾਈਆਂ ਗਈਆਂ ਹੋਣ।"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ସର୍ଭର ଏହି ଟାଇଟଲ୍ ଚଲାଇପାରିବ ନାହିଁ। ଏହାର ଫାଇଲ୍ ସ୍ଥାନାନ୍ତରିତ ବା ଡିଲିଟ୍ ହୋଇଥାଇପାରେ।"
          }
        }
      }
    },
