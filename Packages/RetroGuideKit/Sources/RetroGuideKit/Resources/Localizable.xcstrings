    "Prefers 720p or smaller copies. For slow connections." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prefiere copias de 720p o menores. Para conexiones lentas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prefere cópias de 720p ou menores. Para conexões lentas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privilégie les copies en 720p ou moins. Pour les connexions lentes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preferisce copie a 720p o inferiori. Per connessioni lente."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevorzugt Kopien mit 720p oder kleiner. Für langsame Verbindungen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiest bij voorkeur kopieën van 720p of kleiner. Voor trage verbindingen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Föredrar kopior i 720p eller mindre. För långsamma anslutningar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preferuje kopie 720p lub mniejsze. Dla wolnych połączeń."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upřednostňuje kopie v 720p nebo menší. Pro pomalá připojení."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предпочитает копии 720p и меньше. Для медленного подключения."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "720p以下のバージョンを優先します。低速な接続向けです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "720p 이하 버전을 우선합니다. 느린 연결에 적합합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "优先使用 720p 或更小的版本。适合慢速网络。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "優先使用 720p 或更小的版本。適合慢速連線。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "720p या उससे छोटी कॉपी को प्राथमिकता। धीमे कनेक्शन के लिए।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "720p বা তার ছোট কপিকে অগ্রাধিকার দেয়। ধীর কানেকশনের জন্য।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "720p किंवा लहान प्रतींना प्राधान्य. धीम्या कनेक्शनसाठी."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "720p அல்லது சிறிய பிரதிகளை விரும்பும். மெதுவான இணைப்புகளுக்கு."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "720p లేదా చిన్న కాపీలకు ప్రాధాన్యం. నెమ్మదైన కనెక్షన్‌ల కోసం."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "720p કે તેથી નાની કૉપીને પ્રાધાન્ય આપે છે. ધીમા કનેક્શન માટે."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "720p ಅಥವಾ ಚಿಕ್ಕ ಪ್ರತಿಗಳಿಗೆ ಆದ್ಯತೆ. ನಿಧಾನ ಸಂಪರ್ಕಗಳಿಗಾಗಿ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "720p-യോ അതിൽ ചെറുതോ ആയ പകർപ്പുകൾക്ക് മുൻഗണന. വേഗം കുറഞ്ഞ കണക്ഷനുകൾക്ക്."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "720p ਜਾਂ ਛੋਟੀਆਂ ਕਾਪੀਆਂ ਨੂੰ ਤਰਜੀਹ। ਹੌਲੀ ਕਨੈਕਸ਼ਨਾਂ ਲਈ।"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "720p କିମ୍ବା ଛୋଟ କପି ପସନ୍ଦ କରେ। ଧୀର ସଂଯୋଗ ପାଇଁ।"
          }
        }
      }
    },
