        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各部影集以短區段輪流播出，集數依序播出。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शो छोटे-छोटे ब्लॉक में बारी-बारी आते हैं, एपिसोड क्रम में रहते हैं।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শোগুলো ছোট ছোট ব্লকে পালা করে আসে, পর্ব ক্রমানুসারে থাকে।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शो छोट्या ब्लॉकमध्ये आळीपाळीने येतात, भाग क्रमानेच राहतात."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நிகழ்ச்சிகள் சிறு தொகுதிகளாக மாறி மாறி வரும்; எபிசோடுகள் வரிசையாகவே இருக்கும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "షోలు చిన్న బ్లాక్‌లలో వంతుల వారీగా వస్తాయి, ఎపిసోడ్‌లు వరుసగానే ఉంటాయి."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "શો ટૂંકા બ્લૉકમાં વારાફરતી આવે છે, એપિસોડ ક્રમમાં રહે છે."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಶೋಗಳು ಸಣ್ಣ ಬ್ಲಾಕ್‌ಗಳಲ್ಲಿ ಸರದಿಯಂತೆ ಬರುತ್ತವೆ, ಎಪಿಸೋಡ್‌ಗಳು ಕ್ರಮದಲ್ಲೇ ಇರುತ್ತವೆ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഷോകൾ ചെറിയ ബ്ലോക്കുകളായി മാറിമാറി വരും, എപ്പിസോഡുകൾ ക്രമത്തിൽ തന്നെ."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਸ਼ੋਅ ਛੋਟੇ ਬਲਾਕਾਂ ਵਿੱਚ ਵਾਰੀ ਲੈਂਦੇ ਹਨ, ਐਪੀਸੋਡ ਕ੍ਰਮ ਵਿੱਚ ਰਹਿੰਦੇ ਹਨ।"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଶୋ'ଗୁଡ଼ିକ ଛୋଟ ବ୍ଲକରେ ପାଳି କରି ଚାଲେ, ଏପିସୋଡ୍ କ୍ରମରେ ରହେ।"
          }
        }
      }
    },
