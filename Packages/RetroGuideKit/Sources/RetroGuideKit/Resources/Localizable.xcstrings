    "Aim to show each series on no more than three automatic channels at a time, using different episodes." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intenta mostrar cada serie en no más de tres canales automáticos a la vez, con episodios distintos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenta exibir cada série em no máximo três canais automáticos ao mesmo tempo, com episódios diferentes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essaie de diffuser chaque série sur trois chaînes automatiques au plus en même temps, avec des épisodes différents."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerca di mostrare ogni serie su non più di tre canali automatici alla volta, con episodi diversi."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Serie läuft möglichst auf höchstens drei automatischen Kanälen gleichzeitig, mit unterschiedlichen Folgen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probeer elke serie op maximaal drie automatische zenders tegelijk te tonen, met verschillende afleveringen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visa helst varje serie på högst tre automatiska kanaler samtidigt, med olika avsnitt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W miarę możliwości każdy serial leci naraz na najwyżej trzech kanałach automatycznych, z różnymi odcinkami."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každý seriál se má vysílat nejvýš na třech automatických kanálech současně, s různými díly."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывать каждый сериал не более чем на трёх автоматических каналах одновременно, с разными эпизодами."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各シリーズを同時に放送する自動チャンネルを3つまでに抑え、それぞれ別のエピソードを流します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 시리즈를 동시에 최대 3개의 자동 채널에서 서로 다른 에피소드로 방송하도록 합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尽量让每部剧同时最多在三个自动频道播出，且播放不同的集。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "盡量讓每部影集同時最多在三個自動頻道播出，且播放不同集數。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोशिश रहती है कि हर सीरीज़ एक समय में ज़्यादा से ज़्यादा तीन ऑटोमैटिक चैनलों पर, अलग-अलग एपिसोड के साथ दिखे।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "চেষ্টা করা হয় যাতে প্রতিটি সিরিজ একসাথে সর্বোচ্চ তিনটি স্বয়ংক্রিয় চ্যানেলে, আলাদা আলাদা পর্ব নিয়ে দেখানো হয়।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रत्येक मालिका एकाच वेळी तीनपेक्षा जास्त ऑटोमॅटिक चॅनेलवर न दाखवण्याचा प्रयत्न करते, वेगवेगळे भाग वापरून."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஒவ்வொரு தொடரையும் ஒரே நேரத்தில் அதிகபட்சம் மூன்று தானியங்கு சேனல்களில், வெவ்வேறு எபிசோடுகளுடன் காட்ட முயலும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఒక్కో సిరీస్‌ను ఒకేసారి మూడు కంటే ఎక్కువ ఆటోమేటిక్ ఛానెల్‌లలో చూపకుండా, వేర్వేరు ఎపిసోడ్‌లతో చూపడానికి ప్రయత్నిస్తుంది."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "દરેક સિરીઝને એક સમયે વધુમાં વધુ ત્રણ ઑટોમેટિક ચેનલ પર, અલગ અલગ એપિસોડ સાથે બતાવવાનો પ્રયાસ કરે છે."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಪ್ರತಿ ಸರಣಿಯನ್ನು ಒಂದೇ ಸಮಯದಲ್ಲಿ ಮೂರಕ್ಕಿಂತ ಹೆಚ್ಚು ಸ್ವಯಂಚಾಲಿತ ಚಾನಲ್‌ಗಳಲ್ಲಿ ತೋರಿಸದಿರಲು ಪ್ರಯತ್ನಿಸುತ್ತದೆ, ಬೇರೆ ಬೇರೆ ಎಪಿಸೋಡ್‌ಗಳನ್ನು ಬಳಸಿ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഓരോ സീരീസും ഒരേ സമയം പരമാവധി മൂന്ന് ഓട്ടോമാറ്റിക് ചാനലുകളിൽ, വ്യത്യസ്ത എപ്പിസോഡുകളോടെ കാണിക്കാൻ ശ്രമിക്കുന്നു."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਹਰ ਸੀਰੀਜ਼ ਨੂੰ ਇੱਕੋ ਸਮੇਂ ਵੱਧ ਤੋਂ ਵੱਧ ਤਿੰਨ ਆਟੋਮੈਟਿਕ ਚੈਨਲਾਂ 'ਤੇ, ਵੱਖ-ਵੱਖ ਐਪੀਸੋਡਾਂ ਨਾਲ ਦਿਖਾਉਣ ਦੀ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ପ୍ରତ୍ୟେକ ସିରିଜ୍‌କୁ ଏକାବେଳେ ଅଧିକତମ ତିନୋଟି ସ୍ୱୟଂଚାଳିତ ଚ୍ୟାନେଲରେ, ଭିନ୍ନ ଭିନ୍ନ ଏପିସୋଡ୍ ସହ ଦେଖାଇବାକୁ ଚେଷ୍ଟା କରେ।"
          }
        }
      }
    },
