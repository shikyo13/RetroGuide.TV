    "Oldest first, by the release dates on your server, then it starts over." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primero lo más antiguo, según las fechas de estreno de tu servidor, y luego vuelve a empezar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do mais antigo ao mais novo, pelas datas de lançamento no seu servidor, e depois recomeça."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du plus ancien au plus récent, selon les dates de sortie sur votre serveur, puis on recommence."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dal più vecchio, secondo le date di uscita sul server, poi si ricomincia."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Älteste zuerst, nach den Erscheinungsdaten auf deinem Server, dann beginnt es von vorn."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oudste eerst, op releasedatum op je server, daarna begint het opnieuw."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Äldst först, enligt premiärdatumen på din server, sedan börjar det om."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Od najstarszych, według dat premiery na serwerze, a potem od nowa."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Od nejstaršího podle data vydání na serveru, pak znovu od začátku."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сначала самые старые — по датам выхода на вашем сервере, затем всё сначала."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバの公開日をもとに古い順に放送し、最後まで行くと最初に戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버의 공개일 기준으로 오래된 것부터 방송하고, 끝나면 처음부터 다시 시작합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按服务器上的发行日期从旧到新播放，播完后从头开始。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依伺服器上的發行日期由舊到新播放，播完後從頭開始。"
          }
        }
      }
    },
    "One episode from each show in turn, in order." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un episodio de cada serie por turnos, en orden."
