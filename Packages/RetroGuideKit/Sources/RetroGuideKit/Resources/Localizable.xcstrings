    "Oldest first, by the release dates on your server, then it starts over." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primero lo más antiguo, según las fechas de estreno de tu servidor, y luego vuelve a empezar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do mais antigo ao mais novo, pelas datas de lançamento no seu servidor, e depois recomeça."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du plus ancien au plus récent, selon les dates de sortie sur votre serveur, puis on recommence."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dal più vecchio, secondo le date di uscita sul server, poi si ricomincia."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Älteste zuerst, nach den Erscheinungsdaten auf deinem Server, dann beginnt es von vorn."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oudste eerst, op releasedatum op je server, daarna begint het opnieuw."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Äldst först, enligt premiärdatumen på din server, sedan börjar det om."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Od najstarszych, według dat premiery na serwerze, a potem od nowa."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Od nejstaršího podle data vydání na serveru, pak znovu od začátku."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сначала самые старые — по датам выхода на вашем сервере, затем всё сначала."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバの公開日をもとに古い順に放送し、最後まで行くと最初に戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버의 공개일 기준으로 오래된 것부터 방송하고, 끝나면 처음부터 다시 시작합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按服务器上的发行日期从旧到新播放，播完后从头开始。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依伺服器上的發行日期由舊到新播放，播完後從頭開始。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके सर्वर की रिलीज़ तारीख़ों के हिसाब से सबसे पुराना पहले, फिर दोबारा शुरू से।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার সার্ভারের মুক্তির তারিখ অনুযায়ী সবচেয়ে পুরোনোটি আগে, তারপর আবার শুরু থেকে।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुमच्या सर्व्हरवरील रिलीज तारखांनुसार सर्वात जुने आधी, मग पुन्हा सुरुवातीपासून."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் சர்வரில் உள்ள வெளியீட்டுத் தேதிகளின்படி பழையது முதலில், பிறகு மீண்டும் தொடங்கும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీ సర్వర్‌లోని విడుదల తేదీల ప్రకారం పాతవి ముందు, ఆ తర్వాత మళ్లీ మొదటి నుండి."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમારા સર્વર પરની રિલીઝ તારીખો મુજબ સૌથી જૂનું પહેલાં, પછી ફરી શરૂઆતથી."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಿಮ್ಮ ಸರ್ವರ್‌ನಲ್ಲಿನ ಬಿಡುಗಡೆ ದಿನಾಂಕಗಳ ಪ್ರಕಾರ ಹಳೆಯದು ಮೊದಲು, ನಂತರ ಮತ್ತೆ ಆರಂಭದಿಂದ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "സെർവറിലെ റിലീസ് തീയതി പ്രകാരം ഏറ്റവും പഴയത് ആദ്യം, പിന്നെ വീണ്ടും തുടക്കം മുതൽ."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤੁਹਾਡੇ ਸਰਵਰ 'ਤੇ ਦਿੱਤੀਆਂ ਰਿਲੀਜ਼ ਤਾਰੀਖਾਂ ਮੁਤਾਬਕ ਸਭ ਤੋਂ ਪੁਰਾਣਾ ਪਹਿਲਾਂ, ਫਿਰ ਦੁਬਾਰਾ ਸ਼ੁਰੂ।"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆପଣଙ୍କ ସର୍ଭରର ରିଲିଜ୍ ତାରିଖ ଅନୁସାରେ ପୁରୁଣାଟି ପ୍ରଥମେ, ତା'ପରେ ପୁଣି ଆରମ୍ଭରୁ।"
          }
        }
      }
    },
    "One episode from each show in turn, in order." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un episodio de cada serie por turnos, en orden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um episódio de cada série, revezando, em ordem."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un épisode de chaque série à tour de rôle, dans l'ordre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un episodio di ogni serie a turno, in ordine."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abwechselnd eine Folge jeder Serie, der Reihe nach."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om de beurt één aflevering van elke serie, op volgorde."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett avsnitt från varje serie i tur och ordning."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po jednym odcinku z każdego serialu na zmianę, po kolei."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postupně jeden díl z každého pořadu, popořadě."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По одному эпизоду каждого сериала по очереди, по порядку."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各番組から1エピソードずつ、順番に放送します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 프로그램에서 에피소드를 하나씩 차례로 방송합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各部剧轮流按顺序播出一集。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各部影集輪流依序播出一集。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर शो से बारी-बारी एक एपिसोड, क्रम से।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্রতিটি শো থেকে পালা করে একটি করে পর্ব, ক্রমানুসারে।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रत्येक शोचा एक भाग आळीपाळीने, क्रमाने."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஒவ்வொரு நிகழ்ச்சியிலிருந்தும் ஒரு எபிசோடு, முறைப்படி வரிசையாக."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ప్రతి షో నుండి ఒక్కో ఎపిసోడ్ వంతుల వారీగా, వరుసగా."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "વારાફરતી દરેક શોમાંથી એક એપિસોડ, ક્રમમાં."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಪ್ರತಿ ಶೋನಿಂದ ಸರದಿಯಂತೆ ಒಂದೊಂದು ಎಪಿಸೋಡ್, ಕ್ರಮವಾಗಿ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഓരോ ഷോയിൽ നിന്നും ഓരോ എപ്പിസോഡ് വീതം, ഊഴമനുസരിച്ച് ക്രമത്തിൽ."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਵਾਰੀ-ਵਾਰੀ ਹਰ ਸ਼ੋਅ ਦਾ ਇੱਕ ਐਪੀਸੋਡ, ਕ੍ਰਮ ਵਿੱਚ।"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ପ୍ରତ୍ୟେକ ଶୋ'ରୁ ପାଳି କରି ଗୋଟିଏ ଏପିସୋଡ୍, କ୍ରମରେ।"
          }
        }
      }
    },
