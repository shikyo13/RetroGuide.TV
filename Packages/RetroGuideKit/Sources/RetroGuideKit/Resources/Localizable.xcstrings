    "Tries the address you enter first, such as the server's Tailscale IP." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prueba primero la dirección que ingreses, como la IP de Tailscale del servidor."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenta primeiro o endereço que você digitar, como o IP do Tailscale do servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essaie d'abord l'adresse que vous saisissez, comme l'IP Tailscale du serveur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prova prima l'indirizzo che inserisci, come l'IP Tailscale del server."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versucht zuerst die Adresse, die du eingibst, etwa die Tailscale-IP des Servers."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probeert eerst het adres dat je invoert, zoals het Tailscale-IP-adres van de server."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provar adressen du anger först, till exempel serverns Tailscale-IP."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najpierw próbuje wpisanego adresu, np. adresu IP serwera w Tailscale."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nejdřív zkusí zadanou adresu, třeba IP serveru v Tailscale."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сначала пробует введённый вами адрес, например IP-адрес сервера в Tailscale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバのTailscale IPなど、入力したアドレスを先に試します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버의 Tailscale IP 등 입력한 주소를 먼저 시도합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先尝试你输入的地址，例如服务器的 Tailscale IP。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先嘗試你輸入的位址，例如伺服器的 Tailscale IP。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पहले आपका डाला हुआ पता आज़माता है, जैसे सर्वर का Tailscale IP।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আগে আপনার দেওয়া ঠিকানা চেষ্টা করে, যেমন সার্ভারের Tailscale IP।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुम्ही दिलेला पत्ता आधी वापरून पाहते, जसे सर्व्हरचा Tailscale IP."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "சர்வரின் Tailscale IP போன்ற, நீங்கள் உள்ளிடும் முகவரியை முதலில் முயலும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీరు నమోదు చేసే అడ్రస్‌ను ముందుగా ప్రయత్నిస్తుంది, ఉదాహరణకు సర్వర్ Tailscale IP."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમે દાખલ કરેલા સરનામે પહેલાં પ્રયાસ કરે છે, જેમ કે સર્વરનો Tailscale IP."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನೀವು ನಮೂದಿಸುವ ವಿಳಾಸವನ್ನು ಮೊದಲು ಪ್ರಯತ್ನಿಸುತ್ತದೆ, ಉದಾ. ಸರ್ವರ್‌ನ Tailscale IP."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിങ്ങൾ നൽകുന്ന വിലാസം, ഉദാഹരണത്തിന് സെർവറിന്റെ Tailscale IP, ആദ്യം ശ്രമിക്കുന്നു."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਪਹਿਲਾਂ ਤੁਹਾਡੇ ਵੱਲੋਂ ਦਰਜ ਕੀਤਾ ਪਤਾ ਅਜ਼ਮਾਉਂਦਾ ਹੈ, ਜਿਵੇਂ ਸਰਵਰ ਦਾ Tailscale IP।"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆପଣ ଦେଇଥିବା ଠିକଣାକୁ ପ୍ରଥମେ ଚେଷ୍ଟା କରେ, ଯେପରି ସର୍ଭରର Tailscale IP।"
          }
        }
      }
    },
