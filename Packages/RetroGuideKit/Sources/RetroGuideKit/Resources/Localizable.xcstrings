    "Uses the home address at home or over a VPN, and the internet address elsewhere." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa la dirección local en casa o por VPN, y la dirección de internet en otros lugares."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa o endereço local em casa ou por VPN, e o endereço de internet em outros lugares."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise l'adresse locale à la maison ou via un VPN, et l'adresse Internet ailleurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa l'indirizzo di casa quando sei a casa o in VPN, e l'indirizzo Internet altrove."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutzt zu Hause oder über VPN die Heimadresse und unterwegs die Internetadresse."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruikt thuis of via VPN het thuisadres, en elders het internetadres."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Använder hemadressen hemma eller via VPN och internetadressen på andra platser."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W domu lub przez VPN używa adresu domowego, a gdzie indziej adresu internetowego."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doma nebo přes VPN použije domácí adresu, jinde internetovou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Домашний адрес — дома или через VPN, интернет-адрес — в остальных случаях."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自宅やVPN経由では自宅用アドレスを、それ以外ではインターネットアドレスを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "집이나 VPN에서는 홈 주소를, 그 외에는 인터넷 주소를 사용합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在家或使用 VPN 时使用家庭地址，在其他地方使用互联网地址。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在家或使用 VPN 時使用家用位址，在其他地方使用網際網路位址。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "घर पर या VPN पर घर का पता, और बाकी जगह इंटरनेट का पता इस्तेमाल करता है।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বাড়িতে বা VPN-এ বাড়ির ঠিকানা, আর অন্য সব জায়গায় ইন্টারনেট ঠিকানা ব্যবহার করে।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "घरी किंवा VPN वरून घरचा पत्ता वापरते, आणि इतरत्र इंटरनेट पत्ता."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "வீட்டில் அல்லது VPN வழியாக வீட்டு முகவரியையும், மற்ற இடங்களில் இணைய முகவரியையும் பயன்படுத்தும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఇంట్లో లేదా VPN ద్వారా హోమ్ అడ్రస్‌ను, ఇతర చోట్ల ఇంటర్నెట్ అడ్రస్‌ను ఉపయోగిస్తుంది."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ઘરે કે VPN પર ઘરનું સરનામું, અને બીજે ઇન્ટરનેટ સરનામું વાપરે છે."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಮನೆಯಲ್ಲಿ ಅಥವಾ VPN ಮೂಲಕ ಮನೆಯ ವಿಳಾಸವನ್ನು, ಬೇರೆಡೆ ಇಂಟರ್ನೆಟ್ ವಿಳಾಸವನ್ನು ಬಳಸುತ್ತದೆ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "വീട്ടിലോ VPN വഴിയോ വീട്ടിലെ വിലാസവും മറ്റിടങ്ങളിൽ ഇന്റർനെറ്റ് വിലാസവും ഉപയോഗിക്കുന്നു."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਘਰ ਵਿੱਚ ਜਾਂ VPN ਰਾਹੀਂ ਘਰ ਵਾਲਾ ਪਤਾ, ਅਤੇ ਹੋਰ ਥਾਵਾਂ 'ਤੇ ਇੰਟਰਨੈੱਟ ਵਾਲਾ ਪਤਾ ਵਰਤਦਾ ਹੈ।"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଘରେ ବା VPN ମାଧ୍ୟମରେ ଘର ଠିକଣା, ଅନ୍ୟତ୍ର ଇଣ୍ଟରନେଟ୍ ଠିକଣା ବ୍ୟବହାର କରେ।"
          }
        }
      }
    },
