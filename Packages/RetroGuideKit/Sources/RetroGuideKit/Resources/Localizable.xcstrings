    "Too many requests. Please wait a moment before trying again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demasiadas solicitudes. Espera un momento antes de volver a intentarlo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muitas solicitações. Aguarde um momento antes de tentar de novo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trop de requêtes. Veuillez patienter un instant avant de réessayer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Troppe richieste. Attendi un momento prima di riprovare."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu viele Anfragen. Bitte warte einen Moment, bevor du es erneut versuchst."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te veel verzoeken. Wacht even voordat je het opnieuw probeert."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För många förfrågningar. Vänta en stund innan du försöker igen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zbyt wiele żądań. Odczekaj chwilę i spróbuj ponownie."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Příliš mnoho požadavků. Chvíli počkej a zkus to znovu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слишком много запросов. Подождите немного и повторите попытку."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リクエストが多すぎます。しばらく待ってからもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "요청이 너무 많습니다. 잠시 후 다시 시도하십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请求过多。请稍候再试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要求次數過多。請稍候再試。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बहुत ज़्यादा अनुरोध। फिर से कोशिश करने से पहले थोड़ा रुकें।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অনেক বেশি অনুরোধ। আবার চেষ্টা করার আগে একটু অপেক্ষা করুন।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खूप विनंत्या. पुन्हा प्रयत्न करण्यापूर्वी कृपया थोडा वेळ थांबा."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "அதிகமான கோரிக்கைகள். மீண்டும் முயலும் முன் சிறிது நேரம் காத்திருக்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "చాలా ఎక్కువ రిక్వెస్ట్‌లు. మళ్లీ ప్రయత్నించే ముందు కాసేపు వేచి ఉండండి."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ઘણી બધી વિનંતીઓ. ફરી પ્રયાસ કરતાં પહેલાં થોડી રાહ જુઓ."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ತುಂಬಾ ವಿನಂತಿಗಳು. ಮತ್ತೆ ಪ್ರಯತ್ನಿಸುವ ಮೊದಲು ದಯವಿಟ್ಟು ಸ್ವಲ್ಪ ಕಾಯಿರಿ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "വളരെയധികം അഭ്യർഥനകൾ. വീണ്ടും ശ്രമിക്കുന്നതിന് മുമ്പ് അൽപ്പനേരം കാത്തിരിക്കുക."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਬਹੁਤ ਜ਼ਿਆਦਾ ਬੇਨਤੀਆਂ। ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰਨ ਤੋਂ ਪਹਿਲਾਂ ਕਿਰਪਾ ਕਰਕੇ ਥੋੜ੍ਹਾ ਇੰਤਜ਼ਾਰ ਕਰੋ।"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଅତ୍ୟଧିକ ଅନୁରୋଧ। ପୁଣି ଚେଷ୍ଟା କରିବା ପୂର୍ବରୁ ଦୟାକରି ଟିକେ ଅପେକ୍ଷା କରନ୍ତୁ।"
          }
        }
      }
    },
