    "Switch the TV to HDR for HDR programs. Recommended: switches only happen when the dynamic range changes." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia la TV a HDR con los programas HDR. Recomendado: solo cambia cuando cambia el rango dinámico."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muda a TV para HDR em programas HDR. Recomendado: a troca só acontece quando a faixa dinâmica muda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passe le téléviseur en HDR pour les programmes HDR. Recommandé : le changement n'a lieu que si la plage dynamique change."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passa la TV in HDR per i programmi HDR. Consigliato: il cambio avviene solo quando cambia la gamma dinamica."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schaltet den Fernseher bei HDR-Sendungen auf HDR. Empfohlen: Umgeschaltet wird nur, wenn sich der Dynamikbereich ändert."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet de tv op HDR voor HDR-programma’s. Aanbevolen: er wordt alleen geschakeld als het dynamisch bereik verandert."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Växla tv:n till HDR för HDR-program. Rekommenderas: växling sker bara när det dynamiska omfånget ändras."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przełącza telewizor w tryb HDR dla programów HDR. Zalecane: przełączenie następuje tylko przy zmianie zakresu dynamiki."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U pořadů v HDR přepne televizi do HDR. Doporučeno: přepíná jen při změně dynamického rozsahu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переключать телевизор в HDR для передач в HDR. Рекомендуется: переключение происходит только при смене динамического диапазона."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HDR番組ではテレビをHDRに切り替えます。おすすめ: 切り替えはダイナミックレンジが変わるときだけ行われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HDR 프로그램에서는 TV를 HDR로 전환합니다. 권장: 다이내믹 레인지가 바뀔 때만 전환됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "播放 HDR 节目时将电视切换到 HDR。推荐：仅在动态范围变化时切换。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "播放 HDR 節目時將電視切換為 HDR。建議使用：只有在動態範圍改變時才會切換。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HDR प्रोग्राम के लिए टीवी को HDR में बदलें। सुझाया गया: स्विच सिर्फ़ तब होता है जब डायनैमिक रेंज बदलती है।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HDR অনুষ্ঠানের জন্য টিভিকে HDR-এ বদলান। প্রস্তাবিত: শুধু ডাইনামিক রেঞ্জ বদলালেই সুইচ হয়।"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HDR कार्यक्रमांसाठी टीव्ही HDR वर स्विच करा. शिफारस केलेले: डायनॅमिक रेंज बदलल्यावरच स्विच होते."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HDR நிகழ்ச்சிகளுக்கு டிவியை HDR-க்கு மாற்றும். பரிந்துரைக்கப்படுகிறது: டைனமிக் ரேஞ்ச் மாறும்போது மட்டுமே மாற்றம் நிகழும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HDR ప్రోగ్రామ్‌ల కోసం TVని HDRకు మారుస్తుంది. సిఫార్సు చేయబడింది: డైనమిక్ రేంజ్ మారినప్పుడు మాత్రమే మారుతుంది."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HDR પ્રોગ્રામ માટે ટીવીને HDRમાં સ્વિચ કરે છે. ભલામણ કરેલું: ડાયનેમિક રેન્જ બદલાય ત્યારે જ સ્વિચ થાય છે."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HDR ಕಾರ್ಯಕ್ರಮಗಳಿಗೆ ಟಿವಿಯನ್ನು HDRಗೆ ಬದಲಿಸುತ್ತದೆ. ಶಿಫಾರಸು ಮಾಡಲಾಗಿದೆ: ಡೈನಾಮಿಕ್ ರೇಂಜ್ ಬದಲಾದಾಗ ಮಾತ್ರ ಬದಲಾವಣೆ ಆಗುತ್ತದೆ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HDR പരിപാടികൾക്ക് ടിവി HDR-ലേക്ക് മാറ്റുന്നു. ശുപാർശ ചെയ്യുന്നു: ഡൈനാമിക് റേഞ്ച് മാറുമ്പോൾ മാത്രമേ മാറ്റമുണ്ടാകൂ."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HDR ਪ੍ਰੋਗਰਾਮਾਂ ਲਈ TV ਨੂੰ HDR 'ਤੇ ਬਦਲੋ। ਸਿਫ਼ਾਰਸ਼ੀ: ਬਦਲਾਅ ਸਿਰਫ਼ ਉਦੋਂ ਹੁੰਦਾ ਹੈ ਜਦੋਂ ਡਾਇਨੈਮਿਕ ਰੇਂਜ ਬਦਲਦੀ ਹੈ।"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HDR କାର୍ଯ୍ୟକ୍ରମ ପାଇଁ TVକୁ HDRକୁ ବଦଳାନ୍ତୁ। ସୁପାରିଶ କରାଯାଏ: କେବଳ ଡାଇନାମିକ୍ ରେଞ୍ଜ ବଦଳିଲେ ହିଁ ବଦଳେ।"
          }
        }
      }
    },
