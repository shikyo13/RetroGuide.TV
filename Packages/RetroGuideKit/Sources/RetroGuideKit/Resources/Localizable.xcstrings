    "The server can't play this title. Its files may have been moved or deleted." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor no puede reproducir este título. Puede que sus archivos se hayan movido o eliminado."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O servidor não consegue reproduzir este título. Os arquivos podem ter sido movidos ou apagados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur ne peut pas lire ce titre. Ses fichiers ont peut-être été déplacés ou supprimés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server non può riprodurre questo titolo. I suoi file potrebbero essere stati spostati o eliminati."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server kann diesen Titel nicht abspielen. Die Dateien wurden eventuell verschoben oder gelöscht."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De server kan deze titel niet afspelen. De bestanden zijn mogelijk verplaatst of verwijderd."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servern kan inte spela upp den här titeln. Filerna kan ha flyttats eller raderats."
