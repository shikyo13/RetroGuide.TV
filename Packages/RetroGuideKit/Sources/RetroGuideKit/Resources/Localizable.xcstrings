    "Shows in random order; each show's episodes stay in order." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Series en orden aleatorio; los episodios de cada serie mantienen su orden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Séries em ordem aleatória; os episódios de cada série seguem em ordem."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Séries dans un ordre aléatoire ; les épisodes de chaque série restent dans l'ordre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serie in ordine casuale; gli episodi di ogni serie restano in ordine."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serien in zufälliger Reihenfolge; die Folgen jeder Serie bleiben in Reihenfolge."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Series in willekeurige volgorde; de afleveringen van elke serie blijven op volgorde."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serier i slumpvis ordning; varje series avsnitt behåller sin ordning."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seriale w losowej kolejności; odcinki każdego serialu po kolei."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pořady v náhodném pořadí; díly každého pořadu jdou popořadě."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сериалы в случайном порядке, эпизоды каждого — по порядку."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "番組はランダムな順番で、各番組のエピソードは順番どおりに放送します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로그램은 무작위 순서로, 각 프로그램의 에피소드는 순서대로 방송합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各部剧随机排序，每部剧的集按顺序播出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各部影集隨機排序，每部影集的集數依序播出。"
          }
        }
      }
    },
    "Shows take turns in short blocks, episodes stay in order." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las series se turnan en bloques cortos; los episodios mantienen su orden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As séries se revezam em blocos curtos; os episódios seguem em ordem."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les séries alternent par courts blocs ; les épisodes restent dans l'ordre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serie si alternano in brevi blocchi; gli episodi restano in ordine."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serien wechseln sich in kurzen Blöcken ab, die Folgen bleiben in Reihenfolge."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Series wisselen elkaar af in korte blokken, afleveringen blijven op volgorde."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serierna turas om i korta block, avsnitten behåller sin ordning."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seriale na zmianę w krótkich blokach, odcinki po kolei."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pořady se střídají v krátkých blocích, díly jdou popořadě."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сериалы чередуются короткими блоками, эпизоды идут по порядку."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "番組が短いブロックごとに交代し、エピソードは順番どおりに放送します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로그램이 짧은 블록 단위로 번갈아 방송되며, 에피소드는 순서대로 방송합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
